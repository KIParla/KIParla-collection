		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2851" ANNOTATION_REF="a1119">
				<ANNOTATION_VALUE>e se mi unisco dovevo</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2852" ANNOTATION_REF="a1120">
				<ANNOTATION_VALUE>ehm presentazione</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2853" ANNOTATION_REF="a1121">
