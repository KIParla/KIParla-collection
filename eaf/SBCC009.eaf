		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2848" ANNOTATION_REF="a1115">
				<ANNOTATION_VALUE>non riesco a parlare</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2849" ANNOTATION_REF="a1116">
				<ANNOTATION_VALUE>se voglio unirmi a loro dovevo parlare francese</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2850" ANNOTATION_REF="a1118">
