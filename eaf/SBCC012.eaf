        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>sì no in realtà io devo dire che lui è bellissimo con quei capelli perché se lo guardi capelli corti fa</ANNOTATION_VALUE>
