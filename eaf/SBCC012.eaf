        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>non è molto bello ins[omma]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>m:h però sì quella serie sta piacendo tanto anche a me perché la sto guardando anche io</ANNOTATION_VALUE>
