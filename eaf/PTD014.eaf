        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>persone che vivono nel paese::: sono molto più::: sulle sue rispetto a una volta cioè basta fare un esempio</ANNOTATION_VALUE>
