        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>cioè aumentando le musiche facevano delle musiche non più ballabili queste cose (.) e quindi:: penso che i giovani che si incontrano in discoteca adesso siano praticamente pochi o praticamente nessuno</ANNOTATION_VALUE>
