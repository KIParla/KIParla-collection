        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>e:::hm insomma per me va bene (.) anche adesso non è che:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>&gt;certo che mi ricordo come l'ho conosciuta mia moglie&lt; mia moglie l'ho conosciuta in discoteca come si faceva negli anni settanta ottanta (.) che il maggiore di: il posto:: più probabile per incontrare una ragazza era comunque la discoteca in quegli anni là poi le discoteche sono cambiate sono diventate un ritrovo per matti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
