        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>poi: per rigua~ in riguardo all'edilizia sicuramente tante tante belle soddisfazioni la soddisfazione di vedere un lavoro ben riuscito, di vedere che: il cliente è col~ è contento del lavoro fatto, che:: m:h parlano bene di te è comunque una grande soddisfazione</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>oh io ho un sacco di cose da fare nel mio tempo libero ((ride)) e:::h sono e quelle che faccio sono: non sono niente rispetto a quello che potrei fare</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>((ride)) perché ho un sacco di passioni no?</ANNOTATION_VALUE>
