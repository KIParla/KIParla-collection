            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>se lo fai co~ u::n piacere co u:n passione ti lascia comunque dei bei ricordi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>bei ricordi: i miei bei ricordi sono (.) sono legati a::: ai miei campi di mais quando il mais è bello e rigoglioso e fa delle belle produzioni quando i raccolti sono belli anche legati all'orto cioè perché l'orto lo faccio io personalmente quindi avere l'orto bello e:hm mi rende felice</ANNOTATION_VALUE>
