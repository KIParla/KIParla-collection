    <TIER LINGUISTIC_TYPE_REF="ft-sa" TIER_ID="ft@PST092" PARENT_REF="ref@PST092">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>la signora ecaterina è portavoce</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>sempre per il signore del consolato vado a chiamare la signora ecaterina</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>signora ecaterina</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>e quando ci sono balli nuovi il signor cosmin è molto rigido su certe cose e dopo un po' la gente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>tu stai dicendo seri al centro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>quando spiega no magari prendiamo delle persone degli avanzati tre quattro maschi quanto serve</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>li prendiamo perché o facciamo fare l'ora di principianti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>e prendiamo un paio di maschi di avanzati</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a380">
                <ANNOTATION_VALUE>prin~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>principianti quindi non sa~ non fanno danza con noi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>principianti principianti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a449">
                <ANNOTATION_VALUE>gli avanzati non fanno così</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a452">
                <ANNOTATION_VALUE>gli avanzati fanno prima spiegano la parte ai maschi e le ragazze nel mentre fanno cinque dieci minuti di pausa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a484">
                <ANNOTATION_VALUE>ma il signor cosmin sarà più che felice</ANNOTATION_VALUE>
            </REF_ANNOTATION>
