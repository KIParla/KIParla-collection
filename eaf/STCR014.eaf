		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a998" ANNOTATION_REF="a217">
				<ANNOTATION_VALUE>gli avanzati non fanno così</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a999" ANNOTATION_REF="a218">
				<ANNOTATION_VALUE>gli avanzati fanno prima spiegano la parte ai maschi e le ragazze nel mentre fanno cinque dieci minuti di pausa</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1001" ANNOTATION_REF="a233">
				<ANNOTATION_VALUE>ma il signor cosmin sarà più che felice</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1003" ANNOTATION_REF="a251">
				<ANNOTATION_VALUE>se no scusami prendiamo le ragazze dei principianti e facciamo insieme alle ragazze dei principanti</ANNOTATION_VALUE>
				</REF_ANNOTATION>
