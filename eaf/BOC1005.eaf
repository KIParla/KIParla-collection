        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>che tipo di: (.) e:h beneficio, che tipo di vantaggio ha, (.) anche in termini di procedura, e che tipo invece di (.) svantaggio di criticità, porta con sè.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
