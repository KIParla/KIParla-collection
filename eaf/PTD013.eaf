    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@TOI111" PARENT_REF="ref@TOI111">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>&gt;allora io vivo a villafranca piemonte&lt;. paesino della provincia di torino.</ANNOTATION_VALUE>
