        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>&gt;probabilmente è cambiato un po' per il tipo di perso:ne:&lt;, è cambiato:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
