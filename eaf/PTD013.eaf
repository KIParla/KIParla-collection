            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>dunque (.) d'estate, la gente si ritrova un po' di più (.) anche nelle vie (.) del paese, nelle piazze del paese perché il comune organizza alcune iniziative</ANNOTATION_VALUE>
            </REF_ANNOTATION>
