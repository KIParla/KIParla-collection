        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>quindi lui alla fine c'aveva chiesto se poteva venire a pasquetta portandosi pure altri cinque amici noi abbiamo detto guarda siamo a casa di ludovica e: quindi:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>al massimo parla con lei. ludovica ha detto che effettivamente troppa gente in casa: che tra l'altro non conosce qui[ndi:]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a83">
