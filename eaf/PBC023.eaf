            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a708" ANNOTATION_REF="a707">
                <ANNOTATION_VALUE>e::hm::</ANNOTATION_VALUE>
