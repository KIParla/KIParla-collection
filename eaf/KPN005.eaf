            <REF_ANNOTATION ANNOTATION_ID="a2962" ANNOTATION_REF="a2961">
                <ANNOTATION_VALUE>ma oggi gliel'ho detto &gt;ho detto&lt; gua:rda ho preso sta chiama:ta.</ANNOTATION_VALUE>
