        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3020" ANNOTATION_REF="a3019">
                <ANNOTATION_VALUE>però il problema è che oggi al al medico del centodiciotto che di solito lo intervistano quando viene a: &gt;°somma°&lt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3022" ANNOTATION_REF="a3021">
                <ANNOTATION_VALUE>&gt;ho detto&lt; asco:lta pino che (.) c'è i medici dico manda una mail fa qualcosa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
