        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2964" ANNOTATION_REF="a2963">
                <ANNOTATION_VALUE>[dico c'è (.) dico ascoltami] (.) bisogna &gt;fare&lt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2968" ANNOTATION_REF="a2967">
                <ANNOTATION_VALUE>no ma infatti &gt;dice&lt; non possono venire</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2970" ANNOTATION_REF="a2969">
                <ANNOTATION_VALUE>a a &lt;impestarci&gt; con i servizi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2972" ANNOTATION_REF="a2971">
                <ANNOTATION_VALUE>noi le ambulanze le abbiamo per la per la gente che rischia di morire [non puoi].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2976" ANNOTATION_REF="a2975">
                <ANNOTATION_VALUE>e qu[indi]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2980" ANNOTATION_REF="a2979">
                <ANNOTATION_VALUE>[e:: ma scher]zi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2982" ANNOTATION_REF="a2981">
                <ANNOTATION_VALUE>allora gli ho detto ascolta la gente è preoccupata molte chiamate di oggi erano proprio per</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2984" ANNOTATION_REF="a2983">
                <ANNOTATION_VALUE>ha vi~ te l'ho detto [cosa fa]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2996" ANNOTATION_REF="a2995">
                <ANNOTATION_VALUE>sì: ma lui è proprio dodic'[anni] di as~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3000" ANNOTATION_REF="a2999">
                <ANNOTATION_VALUE>e:h proprio di:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3002" ANNOTATION_REF="a3001">
                <ANNOTATION_VALUE>GUA:RDA</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
