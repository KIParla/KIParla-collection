            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3016" ANNOTATION_REF="a3015">
                <ANNOTATION_VALUE>ma è quello ma noi rispondiamo gentilmente non è ((sbuffa))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3018" ANNOTATION_REF="a3017">
                <ANNOTATION_VALUE>'somma anche lei l~</ANNOTATION_VALUE>
