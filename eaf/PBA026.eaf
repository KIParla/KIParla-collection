                <ANNOTATION_VALUE>ehm: insieme ad un mio amico e abbiam fatto bologna firenze</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2696" ANNOTATION_REF="a2695">
                <ANNOTATION_VALUE>facendo due passi di montagna in un giorno solo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2698" ANNOTATION_REF="a2697">
                <ANNOTATION_VALUE>quindi non abbiam fatto la via degli dei</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2700" ANNOTATION_REF="a2699">
                <ANNOTATION_VALUE>e non l'abbiamo fatto neanche: la strada normale</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2702" ANNOTATION_REF="a2701">
                <ANNOTATION_VALUE>abbiam fatto quella più difficile ovviamente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2704" ANNOTATION_REF="a2703">
                <ANNOTATION_VALUE>e: però è stato bellissimo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2706" ANNOTATION_REF="a2705">
                <ANNOTATION_VALUE>perché: viaggiare su una bici: così vecchia: è stata:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2708" ANNOTATION_REF="a2707">
                <ANNOTATION_VALUE>una bella esperienza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2712" ANNOTATION_REF="a2711">
                <ANNOTATION_VALUE>sì sì sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2714" ANNOTATION_REF="a2713">
                <ANNOTATION_VALUE>ha tenuto (.) benissimo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2716" ANNOTATION_REF="a2715">
                <ANNOTATION_VALUE>meglio di quella che uso adesso</ANNOTATION_VALUE>
