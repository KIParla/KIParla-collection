        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a559">
                <ANNOTATION_VALUE>ma:::hm</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a561">
                <ANNOTATION_VALUE>la sai la storia delle cart~ (.) delle dei tarocchi?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
