        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a525">
                <ANNOTATION_VALUE>vabbè, tanto avrai già tutti i materiali e le informazioni immagino.</ANNOTATION_VALUE>
