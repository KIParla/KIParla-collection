        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>no perché in realtà è fatimat al-zahra, figlia del profeta che la pace e le benedizioni siano su di lui, fatimat al-zahra non fatima</ANNOTATION_VALUE>
