        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>e anzi prima del militare: perché quando ero a militare e:::h</ANNOTATION_VALUE>
