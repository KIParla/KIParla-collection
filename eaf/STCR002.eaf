            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>reperibilità degli anziani piuttosto che dei giovani che devono testimonia:re,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>se non è (.) a ve~ a a verbania a nord del piemonte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>a vicino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>oppure se non si può (.) mancare l'appuntamento tipo fanno le uova qua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>e le fanno per due giorni,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>dev'esserci l'[opportu]nità di avere alcune di noi (xx) (.) cosa tac capito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a761" ANNOTATION_REF="a760">
                <ANNOTATION_VALUE>oh sto tipo però</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a765" ANNOTATION_REF="a764">
                <ANNOTATION_VALUE>questa non era @alba però</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a769" ANNOTATION_REF="a768">
                <ANNOTATION_VALUE>[bra::va] ((batte_le_mani))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a771" ANNOTATION_REF="a770">
                <ANNOTATION_VALUE>allora è proprio un'interiezione dell'associazione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a797" ANNOTATION_REF="a796">
                <ANNOTATION_VALUE>succede che::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a801" ANNOTATION_REF="a800">
                <ANNOTATION_VALUE>e:: inquadriamo come se</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a803" ANNOTATION_REF="a802">
                <ANNOTATION_VALUE>e: in [montaggio si] vedrà</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
