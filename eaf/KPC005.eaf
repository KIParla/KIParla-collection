        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1612" ANNOTATION_REF="a1611">
                <ANNOTATION_VALUE>[ah ci sono] le scarpe della vans ah hai visto che cari:ni questi tutti: ah adesso a a novembre di solito non c'è il black friday?</ANNOTATION_VALUE>
