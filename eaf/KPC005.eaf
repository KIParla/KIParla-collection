        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1606" ANNOTATION_REF="a1605">
                <ANNOTATION_VALUE>[io veramente tra te e tuo fra]tello (.) due geni della lampada</ANNOTATION_VALUE>
