            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>eh eh chi ti deve parlare mh: moustafa dalla finestra?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>oh: cavoli moustafa si tratta bene</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
