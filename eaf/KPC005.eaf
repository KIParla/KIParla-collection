        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>che c'è che per domenica gli va bene venir giù: tutto quanto tuo fratello c'era oggi a lavorare?</ANNOTATION_VALUE>
