            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1594" ANNOTATION_REF="a1593">
                <ANNOTATION_VALUE>[ma che sarebbe anche: giusto cioè] ti di[co]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1612" ANNOTATION_REF="a1611">
