        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1632" ANNOTATION_REF="a1631">
                <ANNOTATION_VALUE>[ma che ci può] stare questo [a livello di dire]</ANNOTATION_VALUE>
