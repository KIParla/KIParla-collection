        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1500" ANNOTATION_REF="a1499">
                <ANNOTATION_VALUE>[cioè]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1506" ANNOTATION_REF="a1505">
                <ANNOTATION_VALUE>[sì ma magari per] te il fermarti cioè come lo intendi tu è appunto:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1510" ANNOTATION_REF="a1509">
                <ANNOTATION_VALUE>m:h fermarti anche con una persona</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1512" ANNOTATION_REF="a1511">
                <ANNOTATION_VALUE>io non sto dicendo che (.) nella vita non arrivi un punto in cui dici</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1514" ANNOTATION_REF="a1513">
                <ANNOTATION_VALUE>tra virgolette voglio stare più tranquillo poi (.) vedere cosa significhi questa co[sa]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1518" ANNOTATION_REF="a1517">
                <ANNOTATION_VALUE>[è relativo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1520" ANNOTATION_REF="a1519">
                <ANNOTATION_VALUE>[sì: però dico non (.) cioè per ognuno] può prendere una determinata piega quindi nel senso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1522" ANNOTATION_REF="a1521">
                <ANNOTATION_VALUE>m::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1524" ANNOTATION_REF="a1523">
                <ANNOTATION_VALUE>sicuramente cambia la percezione che hai delle relazioni, del lavoro, della tua vita in generale &gt;non sto dicendo&lt; è ovvio che cambia anche in base all'età sicuramente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1526" ANNOTATION_REF="a1525">
                <ANNOTATION_VALUE>però non è detto che per tutti p:renda la cosa di dire oka:y (.) ehm devo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1528" ANNOTATION_REF="a1527">
                <ANNOTATION_VALUE>m:h con~ cioè sento l'esigenza di condividere queste cose con una persona, in una maniera stabile o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1530" ANNOTATION_REF="a1529">
                <ANNOTATION_VALUE>e:hm::.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1532" ANNOTATION_REF="a1531">
                <ANNOTATION_VALUE>cioè (.) mh secondo me il: fermarsi un attimo può avere diverse sfumature nella vita in °generale (.) di una persona°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1534" ANNOTATION_REF="a1533">
                <ANNOTATION_VALUE>cioè può anche dire (.) fermarsi ma stando da soli (.) cioè</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1536" ANNOTATION_REF="a1535">
                <ANNOTATION_VALUE>e (.) frequentare delle persone in una maniera più tranquilla nel senso sì mettendo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1538" ANNOTATION_REF="a1537">
                <ANNOTATION_VALUE>non so cioè:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1540" ANNOTATION_REF="a1539">
                <ANNOTATION_VALUE>sicuramente non hai voglia di perdere tempo: in::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1542" ANNOTATION_REF="a1541">
                <ANNOTATION_VALUE>in cose sterili quindi in conoscenze su un altro piano però</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1544" ANNOTATION_REF="a1543">
                <ANNOTATION_VALUE>questo non vuol dire che: ci devi stare poi per tutta la vita</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1546" ANNOTATION_REF="a1545">
