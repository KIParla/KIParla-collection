        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1640" ANNOTATION_REF="a1639">
                <ANNOTATION_VALUE>[eh ma quello invece ti dico] invece [dovresti cercare di ri:~]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1644" ANNOTATION_REF="a1643">
                <ANNOTATION_VALUE>[di ritagliarti]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1646" ANNOTATION_REF="a1645">
                <ANNOTATION_VALUE>beh ma:: ehm:</ANNOTATION_VALUE>
