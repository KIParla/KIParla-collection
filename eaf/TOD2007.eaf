        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1280" ANNOTATION_REF="a1279">
                <ANNOTATION_VALUE>se hai la macchina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1282" ANNOTATION_REF="a1281">
