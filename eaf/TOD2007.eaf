        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1410" ANNOTATION_REF="a1409">
                <ANNOTATION_VALUE>[e::h=o anche adesso c]he ci sono 'sti so:cial=e::h (è) impres[sionante se un]a mette una foto un po' così già sta antipatica a tutte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1414" ANNOTATION_REF="a1413">
