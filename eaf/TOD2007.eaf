            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1322" ANNOTATION_REF="a1321">
                <ANNOTATION_VALUE>che non so di preciso quanti abitanti ci siano ma non tantissimi quindi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1324" ANNOTATION_REF="a1323">
