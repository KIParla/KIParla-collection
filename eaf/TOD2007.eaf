        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1416" ANNOTATION_REF="a1415">
                <ANNOTATION_VALUE>da quel lato lì no~=non mi fa impazzire [e poi s]ì.</ANNOTATION_VALUE>
