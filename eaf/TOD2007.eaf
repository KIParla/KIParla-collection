            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1392" ANNOTATION_REF="a1391">
                <ANNOTATION_VALUE>io noto 'sta cosa non so se s[uccede anche a te],</ANNOTATION_VALUE>
