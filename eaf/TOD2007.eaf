            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1342" ANNOTATION_REF="a1341">
                <ANNOTATION_VALUE>c'è più competizione secondo me: che in città c'è questa mentalità:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1346" ANNOTATION_REF="a1345">
                <ANNOTATION_VALUE>[un po' più aperti (.) fregart]ene di queste cose secondo me,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1348" ANNOTATION_REF="a1347">
                <ANNOTATION_VALUE>e uscire.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1350" ANNOTATION_REF="a1349">
                <ANNOTATION_VALUE>senza uh io &lt;tanti&gt; sabati comunque: me ne sto a &lt;casa&gt; perché magari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1352" ANNOTATION_REF="a1351">
                <ANNOTATION_VALUE>non essendoci così tanto da fare non ti viene manco voglia di: vestirti cambiarti andare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1356" ANNOTATION_REF="a1355">
                <ANNOTATION_VALUE>e invece vedo che a torino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1358" ANNOTATION_REF="a1357">
                <ANNOTATION_VALUE>ho molta più voglia di uscire.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1362" ANNOTATION_REF="a1361">
                <ANNOTATION_VALUE>di fare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1364" ANNOTATION_REF="a1363">
                <ANNOTATION_VALUE>perché non me ne frega nietne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1366" ANNOTATION_REF="a1365">
                <ANNOTATION_VALUE>comunque sai che non incontri le persone che conosci o comunque: non tutti ma solo qualcuno e: ti senti più a tuo agio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1368" ANNOTATION_REF="a1367">
                <ANNOTATION_VALUE>perché la gente si fa i cavoli suoi tutti se ne fregano nessuno sta a vedere te &gt;come sei vestita come sei fatta se sei a[ntip]atica&lt; o: simpatica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1372" ANNOTATION_REF="a1371">
                <ANNOTATION_VALUE>secondo me è più b[ello].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1376" ANNOTATION_REF="a1375">
