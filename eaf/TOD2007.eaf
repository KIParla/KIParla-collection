            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1188" ANNOTATION_REF="a1187">
                <ANNOTATION_VALUE>sì però comunque come zona è (.) bella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1192" ANNOTATION_REF="a1191">
                <ANNOTATION_VALUE>[(se]nza) avere la piscina anche lì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1194" ANNOTATION_REF="a1193">
                <ANNOTATION_VALUE>oppure anche: un posto dove mi piacerebbe tantissimo vivere (.) a torino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1196" ANNOTATION_REF="a1195">
                <ANNOTATION_VALUE>è: vicino alla zona di superga,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1200" ANNOTATION_REF="a1199">
                <ANNOTATION_VALUE>perché sono andata la scorsa settimana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1204" ANNOTATION_REF="a1203">
                <ANNOTATION_VALUE>in macchina tra l'altro quindi comodissimo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1206" ANNOTATION_REF="a1205">
                <ANNOTATION_VALUE>e: abbiam fatto tutta una serie di stradine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1208" ANNOTATION_REF="a1207">
                <ANNOTATION_VALUE>per arrivarci che erano in mezzo ai boschi e c'erano tantissime ville: io non so secondo me lì ci vive tutta la gente ricca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1210" ANNOTATION_REF="a1209">
                <ANNOTATION_VALUE>e::lì è fantastico perché in cinque minuti sei in centro a torino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1212" ANNOTATION_REF="a1211">
