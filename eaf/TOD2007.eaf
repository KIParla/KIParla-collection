            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1242" ANNOTATION_REF="a1241">
                <ANNOTATION_VALUE>eh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1246" ANNOTATION_REF="a1245">
                <ANNOTATION_VALUE>[sì ha~]=hai ma anche io sento sento il bisogno di dover tornare a casa mia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1248" ANNOTATION_REF="a1247">
