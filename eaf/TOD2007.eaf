        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1250" ANNOTATION_REF="a1249">
                <ANNOTATION_VALUE>però,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1252" ANNOTATION_REF="a1251">
                <ANNOTATION_VALUE>anche per il fatto che viviamo in un luogo tranquillissimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1256" ANNOTATION_REF="a1255">
                <ANNOTATION_VALUE>[in cui],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1258" ANNOTATION_REF="a1257">
                <ANNOTATION_VALUE>forse fin trop~ no fin trop[po per]ché non c'è mai niente da fare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1262" ANNOTATION_REF="a1261">
                <ANNOTATION_VALUE>però: sai che puoi tornare ti puoi riposare perché non c'è nulla che ti disturba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1264" ANNOTATION_REF="a1263">
