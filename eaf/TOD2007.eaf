        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1150" ANNOTATION_REF="a1149">
                <ANNOTATION_VALUE>allora quella dove vivo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1152" ANNOTATION_REF="a1151">
                <ANNOTATION_VALUE>che è pratiacamente pre-crocet[ta]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1156" ANNOTATION_REF="a1155">
