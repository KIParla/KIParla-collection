            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1216" ANNOTATION_REF="a1215">
                <ANNOTATION_VALUE>esclus~ cioè sei un po' in campagna un po' nel verde quindi magari respiri un'aria più pul[ita].</ANNOTATION_VALUE>
