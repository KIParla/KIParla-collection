        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a628" ANNOTATION_REF="a627">
                <ANNOTATION_VALUE>[(secondo me) ne hai più] da mettere d'accordo poi so:no opinioni differenti su tutto finisci per litigare no no non si può fare</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a630" ANNOTATION_REF="a629">
                <ANNOTATION_VALUE>però,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a632" ANNOTATION_REF="a631">
                <ANNOTATION_VALUE>due o tre persone massimo dai sì.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a634" ANNOTATION_REF="a633">
                <ANNOTATION_VALUE>comunque o con le mie amiche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a636" ANNOTATION_REF="a635">
                <ANNOTATION_VALUE>di sempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a637">
                <ANNOTATION_VALUE>oppure anche: conn=m:h persone che ho conosciuto da poco tipo le: le mie ultime coinquiline: con cui ho vissuto che comunque mi sono trovata benissimo [e secon]do me un viaggio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a642" ANNOTATION_REF="a641">
                <ANNOTATION_VALUE>si potrebbe [anche fare con loro].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a645">
                <ANNOTATION_VALUE>ssì io già: sono già due anni: (.) che vivo a torino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a650" ANNOTATION_REF="a649">
                <ANNOTATION_VALUE>e due anni che vivo con persone che non conoscevo prima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a651">
                <ANNOTATION_VALUE>e,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a654" ANNOTATION_REF="a653">
                <ANNOTATION_VALUE>secondo cioè è stata una bella esperienza e secondo me ho fatto bene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a655">
                <ANNOTATION_VALUE>andare a vivere con loro rispetto che: andare mh l'andare a vivere con persone che conoscevo da una vita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a660" ANNOTATION_REF="a659">
                <ANNOTATION_VALUE>anche perché allora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a661">
                <ANNOTATION_VALUE>detta~ alcune di queste mie coinquiline mi hanno raccontato di esperienze loro [passate],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a666" ANNOTATION_REF="a665">
                <ANNOTATION_VALUE>e::h=a che si erano appunto trovate male con delle loro amiche che litigavano se:mpre quindi si erano::=viste:: diciamo tipo:: &gt;avevano dovuto&lt; cercare casa l'anno dopo anche loro perché:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a668" ANNOTATION_REF="a667">
                <ANNOTATION_VALUE>litigavano con le loro vecchie coinquiline che erano appunto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a670" ANNOTATION_REF="a669">
                <ANNOTATION_VALUE>amiche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a672" ANNOTATION_REF="a671">
                <ANNOTATION_VALUE>e io:: bo:h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a674" ANNOTATION_REF="a673">
                <ANNOTATION_VALUE>sentendo queste cose ho sempre preferito cercare persone nuove mai c[onosciu]te prima (.) ovviamente (.) vedendole prima,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a678" ANNOTATION_REF="a677">
                <ANNOTATION_VALUE>cioè cercando [anche un po' di] capire che persone fossero,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a682" ANNOTATION_REF="a681">
                <ANNOTATION_VALUE>e::h alla fine ho fatto bene dai mi son trovata bene sia al primo anno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a684" ANNOTATION_REF="a683">
                <ANNOTATION_VALUE>che il secondo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a686" ANNOTATION_REF="a685">
                <ANNOTATION_VALUE>tranne &lt;alcuni ca:si&gt; ovviamente tipo l'anno scorso avevo una coinquilina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a690" ANNOTATION_REF="a689">
                <ANNOTATION_VALUE>un po' particolare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a693">
                <ANNOTATION_VALUE>tipo che: non era mai in casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a698" ANNOTATION_REF="a697">
                <ANNOTATION_VALUE>perché dormiva sempre dal fidanzato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a699">
                <ANNOTATION_VALUE>però (.) a viverci con lui non ci voleva andare ma intanto era sempre a casa sua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a702" ANNOTATION_REF="a701">
                <ANNOTATION_VALUE>e poi: studiava moda quindi già era una testa un po':: [un po' particolare un po'] fuori di testa e:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a706" ANNOTATION_REF="a705">
                <ANNOTATION_VALUE>e tipo stava sveglia fino alle quattro del mattino a disegnare abiti e poi non ci potevi parlare mai di un discorso serio perché non capiva niente era stranissima non puliva ma:i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a708" ANNOTATION_REF="a707">
                <ANNOTATION_VALUE>e::h le venivan sempre fuori idee strane,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a710" ANNOTATION_REF="a709">
                <ANNOTATION_VALUE>ti[po una vol]ta mi ricordo che ci aveva chiesto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a714" ANNOTATION_REF="a713">
                <ANNOTATION_VALUE>se potevan venire a dormire,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a716" ANNOTATION_REF="a715">
                <ANNOTATION_VALUE>e::h=mh sua sorella con il marito e i figli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a718" ANNOTATION_REF="a717">
                <ANNOTATION_VALUE>i[n ca]sa nostra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a722" ANNOTATION_REF="a721">
                <ANNOTATION_VALUE>e::h=che è una casa piccolissima con figurati due stanze un bagno e una cucinetta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a724" ANNOTATION_REF="a723">
                <ANNOTATION_VALUE>e:h noi eravamo già in quattro in più dovevamo avere altre quattro persone in casa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a726" ANNOTATION_REF="a725">
                <ANNOTATION_VALUE>okay che era solo per una notte ma il bello era che lei non sarebbe manco venuta a dormire cioè questi q[ui sarebber]o arrivati,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a730" ANNOTATION_REF="a729">
                <ANNOTATION_VALUE>e::h avrebbero suonato il campanello,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a732" ANNOTATION_REF="a731">
                <ANNOTATION_VALUE>noi gli avremmo aperto e ciao finita lì.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a736" ANNOTATION_REF="a735">
                <ANNOTATION_VALUE>[persone] che non avevi mai visto conosciuto prima venivano a dormire a casa tua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a738" ANNOTATION_REF="a737">
                <ANNOTATION_VALUE>poi lei si vede che ha capito che:: non ci andava bene la cosa alla fine non gli ha fatti venire non so neanche se: alla fine:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a740" ANNOTATION_REF="a739">
                <ANNOTATION_VALUE>se sian venuti o no a torino vabbè.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a744" ANNOTATION_REF="a743">
                <ANNOTATION_VALUE>[anche perché],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a746" ANNOTATION_REF="a745">
                <ANNOTATION_VALUE>[mh]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a748" ANNOTATION_REF="a747">
                <ANNOTATION_VALUE>poi da quel momento lì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a750" ANNOTATION_REF="a749">
                <ANNOTATION_VALUE>io con lei non ho mai più parlato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a752" ANNOTATION_REF="a751">
                <ANNOTATION_VALUE>perché ero già tipo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a754" ANNOTATION_REF="a753">
                <ANNOTATION_VALUE>maggio giugno n[on mi ricor]do più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a758" ANNOTATION_REF="a757">
                <ANNOTATION_VALUE>lei l'ho solo più vista qualche giorno così e poi si è laureata e tra e non ci ha neanche invitate a noi coinquiline tra l'altro era: era abbastanza particolare e quest'anno non l'ho mai mai mai più vista non so che fine abbia fatto se lavori se non lavori se:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a760" ANNOTATION_REF="a759">
                <ANNOTATION_VALUE>niente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a762" ANNOTATION_REF="a761">
                <ANNOTATION_VALUE>e invece quest'anno mi sono trovata bene con tutte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a764" ANNOTATION_REF="a763">
                <ANNOTATION_VALUE>quindi ho avuto forse più fortuna dell'anno scorso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a766" ANNOTATION_REF="a765">
                <ANNOTATION_VALUE>e comunque tutti e due gli anni io ho conosciuto nuove persone e quindi ho nuove amicizie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a770" ANNOTATION_REF="a769">
                <ANNOTATION_VALUE>[e:]:d è una cosa positiva secondo me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a772" ANNOTATION_REF="a771">
                <ANNOTATION_VALUE>è anche il bello dello studiare in una città che non sia [la tua].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a776" ANNOTATION_REF="a775">
                <ANNOTATION_VALUE>conoscere gente: e farti nuove esperienze è bello.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a780" ANNOTATION_REF="a779">
                <ANNOTATION_VALUE>[comunque sono amici che ti re]stano per[ché] (.) siamo comunque,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a784" ANNOTATION_REF="a783">
                <ANNOTATION_VALUE>tutti più o meno della stessa zona e:: ti incontri magari non spessissimo come con le tue amiche: quelle di sempre però:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a786" ANNOTATION_REF="a785">
                <ANNOTATION_VALUE>sono un appoggio sono delle persone in più cioè secondo me è [bell]o.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a790" ANNOTATION_REF="a789">
                <ANNOTATION_VALUE>ci sta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a794" ANNOTATION_REF="a793">
                <ANNOTATION_VALUE>[la] convivenza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a796" ANNOTATION_REF="a795">
                <ANNOTATION_VALUE>innanzitutto ti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a798" ANNOTATION_REF="a797">
                <ANNOTATION_VALUE>ti forma un pochino [per]ché: ti devi adattare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a802" ANNOTATION_REF="a801">
                <ANNOTATION_VALUE>devi tenerti molto spesso: &gt;a determinate cose che magari vorresti&lt; vorresti saltare in aria e:: gridare [qualcosa] ma ti tieni,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a806" ANNOTATION_REF="a805">
                <ANNOTATION_VALUE>e::h e serve serve per capire che cosa voglia dire vivere con qualcun'altro e non avere i tuoi spazi e::=mh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a808" ANNOTATION_REF="a807">
                <ANNOTATION_VALUE>anche già solo: cose stupide (e) sciocche come,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a810" ANNOTATION_REF="a809">
                <ANNOTATION_VALUE>rispettare i turni delle puli[zie o] (al) mangiare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a814" ANNOTATION_REF="a813">
                <ANNOTATION_VALUE>e::h=mh cioè capisci,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a816" ANNOTATION_REF="a815">
                <ANNOTATION_VALUE>capisci cosa vuol dire convivere con qualcuno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a818" ANNOTATION_REF="a817">
                <ANNOTATION_VALUE>ti serve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a820" ANNOTATION_REF="a819">
                <ANNOTATION_VALUE>secondo me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a824" ANNOTATION_REF="a823">
                <ANNOTATION_VALUE>[tanto] venirsi incontro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a826" ANNOTATION_REF="a825">
                <ANNOTATION_VALUE>e adattar[ti].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a830" ANNOTATION_REF="a829">
                <ANNOTATION_VALUE>[l'ad]attamento è,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a832" ANNOTATION_REF="a831">
                <ANNOTATION_VALUE>essenziale perché se sei una persona,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a834" ANNOTATION_REF="a833">
                <ANNOTATION_VALUE>che non si adatta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a836" ANNOTATION_REF="a835">
                <ANNOTATION_VALUE>che vuole:: sempre avere quello che vuole:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a838" ANNOTATION_REF="a837">
                <ANNOTATION_VALUE>che vuole lei nonn,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a840" ANNOTATION_REF="a839">
                <ANNOTATION_VALUE>non ce la fai secondo me a convivere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a844" ANNOTATION_REF="a843">
                <ANNOTATION_VALUE>[sì].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a846" ANNOTATION_REF="a845">
                <ANNOTATION_VALUE>[io] mi adeguo facilmente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a848" ANNOTATION_REF="a847">
                <ANNOTATION_VALUE>e::h=certo alcune volte:: ci sono determinati comportamenti che mi danno fastidio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a850" ANNOTATION_REF="a849">
                <ANNOTATION_VALUE>però:: magari cerco di star zitta e di non dir nulla perché:: poi penso che,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a852" ANNOTATION_REF="a851">
                <ANNOTATION_VALUE>forse anch'io a volte faccio qualcosa che da fastidio agli altri allora i ti tieni un po',</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a854" ANNOTATION_REF="a853">
                <ANNOTATION_VALUE>e poi certo:: non mi è mai successo nulla di grave o partic[olare da d]over litigare e quindi non saprei dirti come mi comporterei davanti:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a858" ANNOTATION_REF="a857">
                <ANNOTATION_VALUE>a un qualcosa di: perché alla fine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a860" ANNOTATION_REF="a859">
                <ANNOTATION_VALUE>in tutti e due gli anni che ho convissuto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a862" ANNOTATION_REF="a861">
                <ANNOTATION_VALUE>non abbiamo mai litigat[o::] né con le coinquiline del primo anno né con quelle del secondo quindi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a866" ANNOTATION_REF="a865">
                <ANNOTATION_VALUE>forse ho avuto anche fortuna perché sentendo quello che succede in giro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a870" ANNOTATION_REF="a869">
                <ANNOTATION_VALUE>non so.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a874" ANNOTATION_REF="a873">
                <ANNOTATION_VALUE>[però],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
