            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1228" ANNOTATION_REF="a1227">
                <ANNOTATION_VALUE>non sei abituato alla::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1230" ANNOTATION_REF="a1229">
                <ANNOTATION_VALUE>alla città alla vita frenetica::=a tutta quell(a) movimento e quindi ti piace comunque avere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1232" ANNOTATION_REF="a1231">
