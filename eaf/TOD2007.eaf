                <ANNOTATION_VALUE>e poi quest'anno vedremo come va.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1126" ANNOTATION_REF="a1125">
                <ANNOTATION_VALUE>è l'ultimo anno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1130" ANNOTATION_REF="a1129">
                <ANNOTATION_VALUE>[poi non so],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1132" ANNOTATION_REF="a1131">
                <ANNOTATION_VALUE>ssì mamma mia che ansia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1134" ANNOTATION_REF="a1133">
                <ANNOTATION_VALUE>e poi non so come sarà in futuro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1136" ANNOTATION_REF="a1135">
                <ANNOTATION_VALUE>se lavorerò: a torino:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1138" ANNOTATION_REF="a1137">
                <ANNOTATION_VALUE>di sicuro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1140" ANNOTATION_REF="a1139">
                <ANNOTATION_VALUE>ma magari i primi tempi viaggerò perché non avrò ancora uno stipendio che mi permetterà di,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1142" ANNOTATION_REF="a1141">
                <ANNOTATION_VALUE>pagare l'affitto a torino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1144" ANNOTATION_REF="a1143">
                <ANNOTATION_VALUE>però poi penso che mi trasferirò a torino comunque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1148" ANNOTATION_REF="a1147">
                <ANNOTATION_VALUE>allora la zona di torino,</ANNOTATION_VALUE>
