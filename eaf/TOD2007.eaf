            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1178" ANNOTATION_REF="a1177">
                <ANNOTATION_VALUE>sai avere una villetta lì: [(come di]re) non [sare]bbe ma[le].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1186" ANNOTATION_REF="a1185">
