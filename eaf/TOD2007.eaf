        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1286" ANNOTATION_REF="a1285">
                <ANNOTATION_VALUE>la lasci lì:: giusto::=a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1288" ANNOTATION_REF="a1287">
                <ANNOTATION_VALUE>non so.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1290" ANNOTATION_REF="a1289">
                <ANNOTATION_VALUE>quando arrivi: prima dei ponti che attraversano il po.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1294" ANNOTATION_REF="a1293">
                <ANNOTATION_VALUE>[sì] però dai non è così difficile guidare come potrebbe essere milano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1296" ANNOTATION_REF="a1295">
                <ANNOTATION_VALUE>secondo me è fatti~ forse il p[arch]eggio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1300" ANNOTATION_REF="a1299">
                <ANNOTATION_VALUE>che ha la scomodità.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1306" ANNOTATION_REF="a1305">
                <ANNOTATION_VALUE>[ma a:]:h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1308" ANNOTATION_REF="a1307">
                <ANNOTATION_VALUE>a cuneo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1310" ANNOTATION_REF="a1309">
                <ANNOTATION_VALUE>di preciso non lo so perché comunque non è che ci vengo sempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1314" ANNOTATION_REF="a1313">
                <ANNOTATION_VALUE>poi bo:h non conosco tanta gente di cuneo più che altro non mi trovo tanto bene nel paese in cui vivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1316" ANNOTATION_REF="a1315">
                <ANNOTATION_VALUE>perché: è un luogo,</ANNOTATION_VALUE>
