        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1404" ANNOTATION_REF="a1403">
                <ANNOTATION_VALUE>io lo noto tan[tis]simo.</ANNOTATION_VALUE>
