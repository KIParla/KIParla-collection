    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@TOI012" PARENT_REF="ref@TOI012">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>sa sa &gt;prova [prova&lt; sa]</ANNOTATION_VALUE>
