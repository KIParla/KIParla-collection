        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>&lt;e come: clientela preferirei::&gt;</ANNOTATION_VALUE>
