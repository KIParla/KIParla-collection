        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2106" ANNOTATION_REF="a2105">
                <ANNOTATION_VALUE>e parl~ e::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2108" ANNOTATION_REF="a2107">
                <ANNOTATION_VALUE>parlano piuttosto più il foggiano [che l'italiano] e::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2112" ANNOTATION_REF="a2111">
                <ANNOTATION_VALUE>comunque:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2114" ANNOTATION_REF="a2113">
                <ANNOTATION_VALUE>non abbiamo avuto problemi perché</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2116" ANNOTATION_REF="a2115">
                <ANNOTATION_VALUE>loro parlavano italiano e</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2118" ANNOTATION_REF="a2117">
                <ANNOTATION_VALUE>non abbiamo ne~ avuto nessun problema</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2124" ANNOTATION_REF="a2123">
                <ANNOTATION_VALUE>eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2138" ANNOTATION_REF="a2137">
                <ANNOTATION_VALUE>eh più che le amiche che:: ma quando andia[mo le incontriamo ancora]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2142" ANNOTATION_REF="a2141">
                <ANNOTATION_VALUE>sì: n=eh anche quest'anno siamo stati due mesi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2146" ANNOTATION_REF="a2145">
                <ANNOTATION_VALUE>eh niente che fa ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2150" ANNOTATION_REF="a2149">
                <ANNOTATION_VALUE>più che andare in chiesa e::: stare un pochino con queste amiche che [adesso]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2154" ANNOTATION_REF="a2153">
                <ANNOTATION_VALUE>c'è</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2156" ANNOTATION_REF="a2155">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2158" ANNOTATION_REF="a2157">
                <ANNOTATION_VALUE>e ma adesso ci sono rimaste anche ben poche, chi è morta, chi è (u)na storia, chi se n'è andata da [volturino] eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2162" ANNOTATION_REF="a2161">
                <ANNOTATION_VALUE>non è che ce ne so [più tante, però:] e:h sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2168" ANNOTATION_REF="a2167">
                <ANNOTATION_VALUE>[m:::h] giovani se ne vanno alle ferie, [dopo] le ferie non c'è più nessuno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2174" ANNOTATION_REF="a2173">
                <ANNOTATION_VALUE>[sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2176" ANNOTATION_REF="a2175">
                <ANNOTATION_VALUE>[montagna so] ottocento metri</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2180" ANNOTATION_REF="a2179">
                <ANNOTATION_VALUE>di [altezza] (.) sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2186" ANNOTATION_REF="a2185">
                <ANNOTATION_VALUE>si sta bene, no::, si dorme sempre con la coper[ta eh no:]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2190" ANNOTATION_REF="a2189">
                <ANNOTATION_VALUE>no si sta proprio bene</ANNOTATION_VALUE>
