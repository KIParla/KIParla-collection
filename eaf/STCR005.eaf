        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>ora:: non saprei in realtà (dov'è) xx</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>ah fantastico (.) eh::m</ANNOTATION_VALUE>
