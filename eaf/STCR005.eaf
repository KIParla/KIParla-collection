        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1028" ANNOTATION_REF="a1027">
                <ANNOTATION_VALUE>questa sett~ cioè questa setti[mana che arriva] inizierei a fare</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1032" ANNOTATION_REF="a1031">
