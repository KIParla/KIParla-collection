        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>ad un ad un spettacolo che facciamo (.) e:h filmare:: noi mentre b~ balliamo o:: qualcuno che canta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>e:::h poi:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>cosa c'è qua AH un'intervista &gt;vabbè&lt; a:: #doamna @ecaterina che:: è e:h la coordinatrice di tutto il centro quindi quando è nato mh:: da da (.) non so</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>tutta la storia un po' diciamo:: del centro e di come si è formato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>poi eh::m per esempio c'è mia mamma che:: #în #sala #bunicii che c'è di là:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
