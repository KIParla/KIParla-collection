        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>faremo un po' una specie di documentario [in cui]::</ANNOTATION_VALUE>
