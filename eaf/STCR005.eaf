        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1060" ANNOTATION_REF="a1059">
                <ANNOTATION_VALUE>sempre per la cosa che dicevo prima della nuova idea di quando la persona entra</ANNOTATION_VALUE>
