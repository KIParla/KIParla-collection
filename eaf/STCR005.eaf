        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>eh eh sì infatti mh magari mia mamma appunto mentre (.) tesse eh poi magari farle anche xx xx (intervista) dipende se se è d'accordo oppure no ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
