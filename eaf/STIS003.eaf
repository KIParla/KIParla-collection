			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a2270" ANNOTATION_REF="a1462">
				<ANNOTATION_VALUE>mio figlio andava a scuola e mi sono detta e io cosa faccio in casa quindi xx a studiare pasticceria</ANNOTATION_VALUE>
