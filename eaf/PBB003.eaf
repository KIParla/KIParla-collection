            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1724" ANNOTATION_REF="a1723">
                <ANNOTATION_VALUE>cioè quindi devi (.) diventare perforza imprenditore di te stesso, cioè secondo me (.) un po' tutto ti sta portando a:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1726" ANNOTATION_REF="a1725">
                <ANNOTATION_VALUE>a inventarti delle cose nuove</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1728" ANNOTATION_REF="a1727">
                <ANNOTATION_VALUE>che non tutti sono disposti a: mh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1730" ANNOTATION_REF="a1729">
                <ANNOTATION_VALUE>ad accettare ecco:: o perlomeno: anche: cioè tu proponi questa cosa però a un certo punto ti dicono guarda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1732" ANNOTATION_REF="a1731">
                <ANNOTATION_VALUE>adesso facciam che cominci a fare: non so il segretario prendi su le telefonate, poi se vai bene (.) mi piaci mi proponi anche la cosa che vorresti fare tu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1734" ANNOTATION_REF="a1733">
                <ANNOTATION_VALUE>e non so se molti giovani sono disposti a (.) fare: (.) prendere le telefonate per poi dire c'ho il grande progetto della ferrari con la lamborghini: eccetera (.) °quindi°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1736" ANNOTATION_REF="a1735">
                <ANNOTATION_VALUE>è è un po' cambiata secondo me sia la domanda che l'offerta °ecco°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1744" ANNOTATION_REF="a1743">
                <ANNOTATION_VALUE>[risposte]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1748" ANNOTATION_REF="a1747">
                <ANNOTATION_VALUE>°quanto [c'abbiam messo?°]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
