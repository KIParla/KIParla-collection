            <REF_ANNOTATION ANNOTATION_ID="a3320" ANNOTATION_REF="a3319">
                <ANNOTATION_VALUE>quando:: lui si vede che magari mentre: stava camminando mentre andava in bagno [perché a volte è cos]ì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3324" ANNOTATION_REF="a3323">
                <ANNOTATION_VALUE>ha [de]tto una cosa (.) e io in quel momento magari mi son: chinata a prender~ 'na roba,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3328" ANNOTATION_REF="a3327">
                <ANNOTATION_VALUE>e non ho ascoltato (.) una minima roba ha detto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3330" ANNOTATION_REF="a3329">
                <ANNOTATION_VALUE>il participio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3334" ANNOTATION_REF="a3333">
                <ANNOTATION_VALUE>(che) (.) vi ricordate come li ha spiegati [nel gir]o [di due se]condi?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3360" ANNOTATION_REF="a3359">
                <ANNOTATION_VALUE>ma perché molte volt[e lui (dà) dà per scon]tato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3366" ANNOTATION_REF="a3365">
                <ANNOTATION_VALUE>lui molte volte da per scontato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3382" ANNOTATION_REF="a3381">
                <ANNOTATION_VALUE>[e e quando ha de]tto questa cosa qui ci guardava guar[dava n]oi tre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3388" ANNOTATION_REF="a3387">
                <ANNOTATION_VALUE>ehm (.) avevo dimenticato 'sto pezzo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
