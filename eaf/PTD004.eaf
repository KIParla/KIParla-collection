        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5830" ANNOTATION_REF="a5829">
                <ANNOTATION_VALUE>((ride)) c(io)è [sempre peggio]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5834" ANNOTATION_REF="a5833">
                <ANNOTATION_VALUE>[poi vabbè ovviamente ci aggiu]ngi:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5836" ANNOTATION_REF="a5835">
                <ANNOTATION_VALUE>i [social e] compagnia [e] quindi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5842" ANNOTATION_REF="a5841">
                <ANNOTATION_VALUE>[il problema fonda]mentale è quello</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5850" ANNOTATION_REF="a5849">
                <ANNOTATION_VALUE>[è sempre peggio è sempre peggio]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5852" ANNOTATION_REF="a5851">
                <ANNOTATION_VALUE>esatto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5856" ANNOTATION_REF="a5855">
                <ANNOTATION_VALUE>[però] ripeto lì non c'entra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5858" ANNOTATION_REF="a5857">
                <ANNOTATION_VALUE>né con il territorio è [proprio un problema]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5864" ANNOTATION_REF="a5863">
                <ANNOTATION_VALUE>gen[erale]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5870" ANNOTATION_REF="a5869">
                <ANNOTATION_VALUE>[eh] sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5886" ANNOTATION_REF="a5885">
                <ANNOTATION_VALUE>[sì sì sì sì] lo devi [devi devi es~ esp]licitare [tutto]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5892" ANNOTATION_REF="a5891">
                <ANNOTATION_VALUE>[non dare nulla per scontato]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5898" ANNOTATION_REF="a5897">
                <ANNOTATION_VALUE>[de]vi dire devi dire è una metafora:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5900" ANNOTATION_REF="a5899">
                <ANNOTATION_VALUE>[guardate che non ha detto questo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5904" ANNOTATION_REF="a5903">
                <ANNOTATION_VALUE>((ride)) [esatto]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5908" ANNOTATION_REF="a5907">
                <ANNOTATION_VALUE>[così per]ché</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5910" ANNOTATION_REF="a5909">
                <ANNOTATION_VALUE>però ripeto non c'entra [con il territorio]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
