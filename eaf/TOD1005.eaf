            <REF_ANNOTATION ANNOTATION_ID="a2558" ANNOTATION_REF="a2557">
                <ANNOTATION_VALUE>che è la più parlata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2568" ANNOTATION_REF="a2567">
                <ANNOTATION_VALUE>mh dipende da che ti~ cioè se noi parliamo dell'arabo standard, l'arabo standard non è parlato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2570" ANNOTATION_REF="a2569">
                <ANNOTATION_VALUE>ma viene utilizzato come [lingua scritta] si si si parla di lingua parlata bisogna parlare dei dialetti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2580" ANNOTATION_REF="a2579">
                <ANNOTATION_VALUE>cioè non è parlato dal~ dalla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2582" ANNOTATION_REF="a2581">
                <ANNOTATION_VALUE>(cioè) lo parla magari lo st~ la persona che deve comunicare o con un uo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2584" ANNOTATION_REF="a2583">
                <ANNOTATION_VALUE>(non so se) bisogna farsi capire (magari) non so tra dialetti diversi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2590" ANNOTATION_REF="a2589">
                <ANNOTATION_VALUE>[si parla solo in alcuni contesti].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2596" ANNOTATION_REF="a2595">
                <ANNOTATION_VALUE>sì.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2772" ANNOTATION_REF="a2771">
                <ANNOTATION_VALUE>l'algeria.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2778" ANNOTATION_REF="a2777">
                <ANNOTATION_VALUE>la mauritania</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2784" ANNOTATION_REF="a2783">
                <ANNOTATION_VALUE>yemen</ANNOTATION_VALUE>
