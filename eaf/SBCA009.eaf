            <REF_ANNOTATION ANNOTATION_ID="a686" ANNOTATION_REF="a685">
                <ANNOTATION_VALUE>normalmente a casa figurati là</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a690" ANNOTATION_REF="a689">
                <ANNOTATION_VALUE>sì no però [ci voglio troppo andare]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a693">
                <ANNOTATION_VALUE>[ma pensa che c'è stata] @sara una mia amica tutta la sua famiglia e loro hanno un fratellino disabile</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a698" ANNOTATION_REF="a697">
                <ANNOTATION_VALUE>che lui odia i: luoghi affollati cioè non li riesce a gestire proprio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a699">
                <ANNOTATION_VALUE>però ha detto che lì è stata la prima volta che lui ha vissuto per bene una vacanza che poi [non era una vaca]nza alla fine</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a704" ANNOTATION_REF="a703">
                <ANNOTATION_VALUE>ma lui è stato molto molto bene toro~ sereno lì si vede infatti vogliono tornare</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a706" ANNOTATION_REF="a705">
                <ANNOTATION_VALUE>perché è la prima volta che lui si è sentito tranquillo in in vi[aggio]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a710" ANNOTATION_REF="a709">
                <ANNOTATION_VALUE>che non è stato male</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a714" ANNOTATION_REF="a713">
                <ANNOTATION_VALUE>quindi è magari è</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a716" ANNOTATION_REF="a715">
                <ANNOTATION_VALUE>cioè si sente proprio di dover andare ma giusto perché giu~ cioè adesso si può fare non è che: costa tantissimo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a720" ANNOTATION_REF="a719">
                <ANNOTATION_VALUE>allora ho visto cinquecento euro per esempio ad ottobre co[n questa] compa~ cioè agenzia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a724" ANNOTATION_REF="a723">
                <ANNOTATION_VALUE>che però oltre ottobre adesso non ti fa prenotare ca[pito]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a728" ANNOTATION_REF="a727">
                <ANNOTATION_VALUE>cinquecento euro tutto incluso con alloggio e:hm e i voli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a730" ANNOTATION_REF="a729">
                <ANNOTATION_VALUE>tutto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a734" ANNOTATION_REF="a733">
                <ANNOTATION_VALUE>sono otto not[ti]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a738" ANNOTATION_REF="a737">
                <ANNOTATION_VALUE>sette notti otto giorni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a742" ANNOTATION_REF="a741">
                <ANNOTATION_VALUE>eh i mie genitori vorrebbero fa~ vorrebbero farne dieci</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a746" ANNOTATION_REF="a745">
                <ANNOTATION_VALUE>però: per me va bene anche otto [giorni]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a752" ANNOTATION_REF="a751">
                <ANNOTATION_VALUE>[ma la #ʕumra la fai anche] in tre o~ [la fa in tre o[re let[teralme]nte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a758" ANNOTATION_REF="a757">
                <ANNOTATION_VALUE>però di loro vorrebbero tornare lì e tornare lì cioè</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a760" ANNOTATION_REF="a759">
                <ANNOTATION_VALUE>quando sono stati loro sono stati tre settimane</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a764" ANNOTATION_REF="a763">
                <ANNOTATION_VALUE>[quindi] loro vorrebbero poter: stare il più a lungo possibile</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a770" ANNOTATION_REF="a769">
                <ANNOTATION_VALUE>[eh infa]tti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a774" ANNOTATION_REF="a773">
                <ANNOTATION_VALUE>sì ma adesso adesso c~ [cioè adesso che vado a casa] perché devo andar[e: te lo] mando subito va bene?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a783" ANNOTATION_REF="a782">
                <ANNOTATION_VALUE>[gra~ ma gra]zie a te per questa merenda @dina ci vediamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a787" ANNOTATION_REF="a786">
                <ANNOTATION_VALUE>[cia~]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a789" ANNOTATION_REF="a788">
                <ANNOTATION_VALUE>ciao</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
