        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>[di]ciamo. (.) e:h okay eh volevo parlare di bologna un attimo in[vece] e:hm: cioè tu non hai mai vissuto qua però ecco::: facciamo così, se:=m::h,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>se dovessi::: per un qualche motivo, non so:: un lavoro:: più che altre cose:, (.) e::h trasferirti qui, hai un'idea di una zona che ti piacerebbe:? come vorresti la tua casa:?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>secondo te quali potrebbero essere i vantaggi di stare a bologna rispetto a a dove stai:: adesso?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>mhmh mhmh certo certo (.) e se dovessi descrivere diciamo la tua casa ideale come sarebbe? sia come zona che come è fatta dentro diciamo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>mhmh, mhmh, capito (.) comunque i bolognesi son gente simpatica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>((ride)) [quindi tu dici (.) bolognesi] comunque se ne vedono pochi ((ride)) (.) bene bene, (.) tu a che anno sei del tuo corso di studi?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>di ah quindi [proprio stai::] (.) stai finendo (.) e::=[un episodio] divertente che ti è capitato legato:: all'università, durante:: il tuo corso di studi?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>non so uno che ti ricordi in particolare?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a245">
