        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>sì beh rispetto agli inglesi forse sono un [po' me]no:: (.) meno asettici ((ride)) (.) [di],</ANNOTATION_VALUE>
