                <ANNOTATION_VALUE>[sì ce~],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>mhmh (.) sì sì perché come al solito cioè se io abito in un posto non è che ho poi tanto interesse a conoscere chi:: (.) chi viene da fuori, per[ché] cioè immagino che l'austriaco di turno avrà: il suo giro, avr[à:] ((ride))</ANNOTATION_VALUE>
