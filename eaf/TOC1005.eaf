        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a602" ANNOTATION_REF="a601">
                <ANNOTATION_VALUE>[eh no ma infatti era l~ era l'ultimo] esame, e proprio [per=eh, sì no xx sì sono riusci]ta a dare tutto, oltretutto la scorsa settimana ho dato penale, e::: av~ ho dov~ &gt;cioè&lt; essendo martedì ho tutti questi controlli, ho dovuto di nuovo chiedere [se: potevo passare, (.) sì. sì].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a608" ANNOTATION_REF="a607">
                <ANNOTATION_VALUE>gra[zie. arriveder]ci.</ANNOTATION_VALUE>
