                <ANNOTATION_VALUE>oppure:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3368" ANNOTATION_REF="a3367">
                <ANNOTATION_VALUE>e::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3370" ANNOTATION_REF="a3369">
                <ANNOTATION_VALUE>è da un po' che non vedo: ah eh a beh a me piacciono tanto quelli là del e:h degli anni settanta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3374" ANNOTATION_REF="a3373">
                <ANNOTATION_VALUE>cioè quelli:: su roma spara milano [risponde]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3378" ANNOTATION_REF="a3377">
                <ANNOTATION_VALUE>a me quellii ne ho: guarda là sopra c'ho:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3382" ANNOTATION_REF="a3381">
                <ANNOTATION_VALUE>c'ho lo specia(le) c'ho dei cofanetti di::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3386" ANNOTATION_REF="a3385">
                <ANNOTATION_VALUE>speciale delle colonne sonore</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3390" ANNOTATION_REF="a3389">
                <ANNOTATION_VALUE>c'è sia tipo er monnezza sono io,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3396" ANNOTATION_REF="a3395">
                <ANNOTATION_VALUE>ci sono:: le colonne sonore di franco micalizzi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3402" ANNOTATION_REF="a3401">
                <ANNOTATION_VALUE>e armando trovajoli cioè no a me queste cose mi piacciono un sacco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3406" ANNOTATION_REF="a3405">
                <ANNOTATION_VALUE>pesante</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3410" ANNOTATION_REF="a3409">
                <ANNOTATION_VALUE>ah ma quello io mi guardo anche degli sketch al mattino quando mi sveglio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3416" ANNOTATION_REF="a3415">
                <ANNOTATION_VALUE>no no io: a me:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3422" ANNOTATION_REF="a3421">
                <ANNOTATION_VALUE>no vabbè sai</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3424" ANNOTATION_REF="a3423">
                <ANNOTATION_VALUE>[però gli faccio vedere]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3430" ANNOTATION_REF="a3429">
                <ANNOTATION_VALUE>ah sì me l'avevi [detto]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3436" ANNOTATION_REF="a3435">
                <ANNOTATION_VALUE>[l'ho registrata]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3438" ANNOTATION_REF="a3437">
                <ANNOTATION_VALUE>e se riesco ad andare volentieri</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3442" ANNOTATION_REF="a3441">
                <ANNOTATION_VALUE>quando lei mi vuole::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3444" ANNOTATION_REF="a3443">
                <ANNOTATION_VALUE>raggiungere a milano, ci andremo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3446" ANNOTATION_REF="a3445">
                <ANNOTATION_VALUE>no dobbiamo andare all'outlet a novara più che [altro]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3450" ANNOTATION_REF="a3449">
                <ANNOTATION_VALUE>se: combiniamo andiamo tutti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3452" ANNOTATION_REF="a3451">
                <ANNOTATION_VALUE>l'ho portata a vedere l'alfa romeo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3454" ANNOTATION_REF="a3453">
                <ANNOTATION_VALUE>cioè l'ho portata al centro veramente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3456" ANNOTATION_REF="a3455">
                <ANNOTATION_VALUE>[se no non la]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3462" ANNOTATION_REF="a3461">
                <ANNOTATION_VALUE>è enorme</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3478" ANNOTATION_REF="a3477">
                <ANNOTATION_VALUE>fammi mettere [a posto]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3484" ANNOTATION_REF="a3483">
                <ANNOTATION_VALUE>quindi abbiam finito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
