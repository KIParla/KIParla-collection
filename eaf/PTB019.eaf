                <ANNOTATION_VALUE>m:::h l'ultimo paio di domande, poi::: vi lascio:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2738" ANNOTATION_REF="a2737">
                <ANNOTATION_VALUE>siete:: già stati,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2740" ANNOTATION_REF="a2739">
                <ANNOTATION_VALUE>abbastanza gentili così</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2748" ANNOTATION_REF="a2747">
                <ANNOTATION_VALUE>[mi avete raccontato, tutto] ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2758" ANNOTATION_REF="a2757">
                <ANNOTATION_VALUE>((ride)) [so già tu]tto i[nfa~]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2764" ANNOTATION_REF="a2763">
                <ANNOTATION_VALUE>e con=e:::h il dialetto piemontese, che rapport[o::: avete no]n lo conoscete,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2786" ANNOTATION_REF="a2785">
                <ANNOTATION_VALUE>riesce, a dire qualche espressione</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2822" ANNOTATION_REF="a2821">
                <ANNOTATION_VALUE>e i vostri figli lo parlano, il dialetto?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2824" ANNOTATION_REF="a2823">
                <ANNOTATION_VALUE>mh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2842" ANNOTATION_REF="a2841">
                <ANNOTATION_VALUE>e il dialetto pugliese, lo conoscono, lo sanno [parlare],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2882" ANNOTATION_REF="a2881">
                <ANNOTATION_VALUE>°ho [capito°]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2902" ANNOTATION_REF="a2901">
                <ANNOTATION_VALUE>e invece:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2904" ANNOTATION_REF="a2903">
                <ANNOTATION_VALUE>spostandoci all'attualità no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2906" ANNOTATION_REF="a2905">
                <ANNOTATION_VALUE>xx,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2908" ANNOTATION_REF="a2907">
                <ANNOTATION_VALUE>stiamo vivendo un momento di:: di crisi:: economica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2910" ANNOTATION_REF="a2909">
                <ANNOTATION_VALUE>un po' tutti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2912" ANNOTATION_REF="a2911">
                <ANNOTATION_VALUE>a parte questo vi ricordate:: un altro momento di crisi economica della vostra vita:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2914" ANNOTATION_REF="a2913">
                <ANNOTATION_VALUE>[che possa essere sta]to, il=[eh]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3022" ANNOTATION_REF="a3021">
                <ANNOTATION_VALUE>va bene</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3024" ANNOTATION_REF="a3023">
                <ANNOTATION_VALUE>va bene al[lora io],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3028" ANNOTATION_REF="a3027">
                <ANNOTATION_VALUE>siete stati utilissimi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3030" ANNOTATION_REF="a3029">
                <ANNOTATION_VALUE>[e genti]l[issimi sopra]ttutto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3036" ANNOTATION_REF="a3035">
                <ANNOTATION_VALUE>io [vi ringrazio] a [nome mio],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3042" ANNOTATION_REF="a3041">
                <ANNOTATION_VALUE>[e della mia professoressa],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3046" ANNOTATION_REF="a3045">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3050" ANNOTATION_REF="a3049">
                <ANNOTATION_VALUE>[tanto io sono a casa]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3066" ANNOTATION_REF="a3065">
                <ANNOTATION_VALUE>[no] no certo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3070" ANNOTATION_REF="a3069">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
