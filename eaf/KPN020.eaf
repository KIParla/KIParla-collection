        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1556" ANNOTATION_REF="a1555">
                <ANNOTATION_VALUE>no &gt;secondo me&lt; qua si tratta sul fatto finché tu frequenti sempre le stesse persone va anche bene</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1558" ANNOTATION_REF="a1557">
                <ANNOTATION_VALUE>perché sai: che se ci dovesse venir fuori un un caso (.) è della tua cerchia</ANNOTATION_VALUE>
