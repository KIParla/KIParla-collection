            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1566" ANNOTATION_REF="a1565">
                <ANNOTATION_VALUE>°no° (.) [in questo momento no]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1572" ANNOTATION_REF="a1571">
                <ANNOTATION_VALUE>°no: [neanche lei°]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1578" ANNOTATION_REF="a1577">
