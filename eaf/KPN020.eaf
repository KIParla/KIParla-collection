        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1548" ANNOTATION_REF="a1547">
                <ANNOTATION_VALUE>&gt;cioè come fai&lt; a controllare le ca[se]?</ANNOTATION_VALUE>
