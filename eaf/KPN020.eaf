        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1540" ANNOTATION_REF="a1539">
                <ANNOTATION_VALUE>(per) evitare la movida [ma °mhmh°]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1546" ANNOTATION_REF="a1545">
