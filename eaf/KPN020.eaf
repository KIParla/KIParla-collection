        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1522" ANNOTATION_REF="a1521">
                <ANNOTATION_VALUE>[eh ma]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1524" ANNOTATION_REF="a1523">
                <ANNOTATION_VALUE>[ovvio ma]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1526" ANNOTATION_REF="a1525">
                <ANNOTATION_VALUE>meno male che sono andato a tagliarmi i capelli la settimana scorsa ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
