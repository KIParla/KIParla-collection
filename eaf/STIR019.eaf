            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1250" ANNOTATION_REF="a1249">
                <ANNOTATION_VALUE>però: ho detto no se vado ho pau[ra che xx (.) più pe:]ggio un casino e:: ho detto ma aspetta che se succede un'altra volt~ sì: che vado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1256" ANNOTATION_REF="a1255">
                <ANNOTATION_VALUE>me la prendo::: scusa non faccio io che son mamma fai tu: mh [che sei capisci]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1260" ANNOTATION_REF="a1259">
                <ANNOTATION_VALUE>ho capito che è un'insegnante però?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1264" ANNOTATION_REF="a1263">
                <ANNOTATION_VALUE>bah.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1266" ANNOTATION_REF="a1265">
                <ANNOTATION_VALUE>e::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1268" ANNOTATION_REF="a1267">
                <ANNOTATION_VALUE>niente bho:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1270" ANNOTATION_REF="a1269">
                <ANNOTATION_VALUE>e ho detto da quella volta ho:: mh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1272" ANNOTATION_REF="a1271">
                <ANNOTATION_VALUE>ho detto magari per questo me l'hanno preso:: anche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1276" ANNOTATION_REF="a1275">
                <ANNOTATION_VALUE>e adesso:: ha detto che a settembre vediamo come va il bambino se non:: ha bisogno di un sostegno di qualcosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1278" ANNOTATION_REF="a1277">
                <ANNOTATION_VALUE>e difatti parlando con lei che mi ha consigliato psicologa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1280" ANNOTATION_REF="a1279">
                <ANNOTATION_VALUE>ha fa:tto un po' di compiti per vedere e:hm (.) ha: visto che lei [mi ha detto che no: che non ha bisogno adesso],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1284" ANNOTATION_REF="a1283">
                <ANNOTATION_VALUE>[che ha pau~ ha:: paura]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1286" ANNOTATION_REF="a1285">
                <ANNOTATION_VALUE>adesso che: inizia settembre ho ansia, ((ridendo))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1288" ANNOTATION_REF="a1287">
                <ANNOTATION_VALUE>perché non so come:::.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1296" ANNOTATION_REF="a1295">
                <ANNOTATION_VALUE>[questa cosa mi ha detto anche] mio marito parli con la dirigente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1300" ANNOTATION_REF="a1299">
                <ANNOTATION_VALUE>di cambiare classe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1302" ANNOTATION_REF="a1301">
                <ANNOTATION_VALUE>perché loro non sono in grado di occuparsi del bambino che hanno::.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1304" ANNOTATION_REF="a1303">
                <ANNOTATION_VALUE>però se c'è: io: e::h adesso che se mi dicono che dev~ io: (.) non sono obbligata il mio bambino non ha problemi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1306" ANNOTATION_REF="a1305">
                <ANNOTATION_VALUE>come vi occupate dei altri bambini anche voi vi $det~ vi:: dovet~ a:nche se un po' più lenti prendete i bambini che sono un po' più lenti: (.) e quelli che sono un po' più.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1308" ANNOTATION_REF="a1307">
                <ANNOTATION_VALUE>no: uno per uno non tutti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1312" ANNOTATION_REF="a1311">
                <ANNOTATION_VALUE>[e:: no::],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1314" ANNOTATION_REF="a1313">
                <ANNOTATION_VALUE>sì: non lo so: no:: boh:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1316" ANNOTATION_REF="a1315">
                <ANNOTATION_VALUE>e niente boh:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1322" ANNOTATION_REF="a1321">
                <ANNOTATION_VALUE>[volevo dirvi],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1326" ANNOTATION_REF="a1325">
                <ANNOTATION_VALUE>[qualche domanda, ((ridendo))]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1328" ANNOTATION_REF="a1327">
                <ANNOTATION_VALUE>[due minuti per (.) sicura:]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1332" ANNOTATION_REF="a1331">
