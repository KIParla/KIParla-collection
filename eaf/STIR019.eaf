            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1334" ANNOTATION_REF="a1333">
                <ANNOTATION_VALUE>perché devo:: c(io)è: ho lasciato il no:nno e[:h],</ANNOTATION_VALUE>
