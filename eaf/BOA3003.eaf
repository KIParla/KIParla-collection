        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3480" ANNOTATION_REF="a3479">
                <ANNOTATION_VALUE>cioè. però, scendeva le scale. prima x[x].</ANNOTATION_VALUE>
