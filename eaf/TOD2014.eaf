                <ANNOTATION_VALUE>poi vivono lì tutto il tem[po].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1146" ANNOTATION_REF="a1145">
                <ANNOTATION_VALUE>stanno lì tutto il tempo perché loro mangiano l[ì si] riposano lì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1150" ANNOTATION_REF="a1149">
                <ANNOTATION_VALUE>cenano lì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1152" ANNOTATION_REF="a1151">
                <ANNOTATION_VALUE>guardano la tv lì e poi vanno a dormire a casa dove: hanno mille stanze che non utilizzano mai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1154" ANNOTATION_REF="a1153">
                <ANNOTATION_VALUE>perché è così.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1156" ANNOTATION_REF="a1155">
                <ANNOTATION_VALUE>e infatti sì casa di mia nonna è: tutta su: praticamente due pia[ni] e:h dove ci stanno due camere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1160" ANNOTATION_REF="a1159">
                <ANNOTATION_VALUE>il: due bagni e un salotto cucina ma,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1162" ANNOTATION_REF="a1161">
                <ANNOTATION_VALUE>non: non ci sta mai nessuno perché stanno sempre in questa:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1164" ANNOTATION_REF="a1163">
                <ANNOTATION_VALUE>taverne[tta].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1168" ANNOTATION_REF="a1167">
                <ANNOTATION_VALUE>e:: però sì il bello della casa è: appunto tutto: (.) tutto intorno perché::: sì (ci s~),</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1170" ANNOTATION_REF="a1169">
                <ANNOTATION_VALUE>c'è di tutto cioè animali:::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1172" ANNOTATION_REF="a1171">
                <ANNOTATION_VALUE>e::hm anche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1174" ANNOTATION_REF="a1173">
                <ANNOTATION_VALUE>(poi) un sacco di alberi da frutta hanno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1176" ANNOTATION_REF="a1175">
                <ANNOTATION_VALUE>e:::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1178" ANNOTATION_REF="a1177">
                <ANNOTATION_VALUE>è bello io l'ho sempre vista come una fattoria da piccola adesso è un po' dismessa per[ò:],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1182" ANNOTATION_REF="a1181">
                <ANNOTATION_VALUE>comu[nque:::],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1186" ANNOTATION_REF="a1185">
                <ANNOTATION_VALUE>[se:: ((ride)) (.) no per]ò è: bella molto bella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1198" ANNOTATION_REF="a1197">
                <ANNOTATION_VALUE>più che di paranormale vabbè io mh mh in realtà è una cosa che m~ mi hanno raccontato perché credo che neanche ero stata concepita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1202" ANNOTATION_REF="a1201">
                <ANNOTATION_VALUE>però: mio padre si è sempre divertito con la recitazi[o:ne] eccetera eccetera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1206" ANNOTATION_REF="a1205">
                <ANNOTATION_VALUE>e (.) e::h mia sorella è rimasta traumatizzata perché lui fa ha sempre fatto degli scherzi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1208" ANNOTATION_REF="a1207">
                <ANNOTATION_VALUE>un po' anche (e) forse troppo ((ride)) scioccan[ti].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1212" ANNOTATION_REF="a1211">
                <ANNOTATION_VALUE>e quindi lei è rimasta traumatizzata da: m:::h un giorno:: (e il lo) il giorno della befana l'epifania,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1214" ANNOTATION_REF="a1213">
                <ANNOTATION_VALUE>no sai la befana scende dal cami:no tutte 'ste cose e mio padre si era (.) inventato una roba assurda aveva registrato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1216" ANNOTATION_REF="a1215">
                <ANNOTATION_VALUE>e::h con un registratore e:hm delle domande,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1218" ANNOTATION_REF="a1217">
                <ANNOTATION_VALUE>a cui poi seguivano delle pause,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1220" ANNOTATION_REF="a1219">
                <ANNOTATION_VALUE>per dar modo a mia sorella di rispondere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1222" ANNOTATION_REF="a1221">
                <ANNOTATION_VALUE>con una voce tipo da strega,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1224" ANNOTATION_REF="a1223">
                <ANNOTATION_VALUE>e ha infilato questo re:~ registratore sul nel camino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1226" ANNOTATION_REF="a1225">
                <ANNOTATION_VALUE>con i rumo:ri anche cioè delle cose,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1228" ANNOTATION_REF="a1227">
                <ANNOTATION_VALUE>e quindi niente poi l'ha azionato e,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1230" ANNOTATION_REF="a1229">
                <ANNOTATION_VALUE>e:: mia madre mio padre e mia sorella si sono messi davanti al camino a ascoltare questa cosa ovviamente tu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1232" ANNOTATION_REF="a1231">
                <ANNOTATION_VALUE>non pensi (.) cioè non penserai mai che o tua madre o tuo padre perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1234" ANNOTATION_REF="a1233">
                <ANNOTATION_VALUE>sono lì con [te] ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1238" ANNOTATION_REF="a1237">
                <ANNOTATION_VALUE>lei è rimasta s~ eh schockata da 'sta cosa da sto (camino xx) da cui usciva la voce tipo ciao martina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1240" ANNOTATION_REF="a1239">
                <ANNOTATION_VALUE>come stai?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1242" ANNOTATION_REF="a1241">
                <ANNOTATION_VALUE>hai fatto la brava?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1244" ANNOTATION_REF="a1243">
                <ANNOTATION_VALUE>[e ovviamente lei è rimasta schockata e ha pia]nto tutto il tempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1248" ANNOTATION_REF="a1247">
                <ANNOTATION_VALUE>quindi: sì i~ in quella casa: m~ mio padre si è::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1250" ANNOTATION_REF="a1249">
