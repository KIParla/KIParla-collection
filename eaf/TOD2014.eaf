        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1260" ANNOTATION_REF="a1259">
                <ANNOTATION_VALUE>tua sorella in particolare. ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1278" ANNOTATION_REF="a1277">
                <ANNOTATION_VALUE>no io n ho avuta:: beh no ne ho cambiati tanti in realtà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1282" ANNOTATION_REF="a1281">
                <ANNOTATION_VALUE>[(perché) po]i sto in casa da quattro anni ma nel frattempo ho avuto quattro o cinque coinquiline [quindi] ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1288" ANNOTATION_REF="a1287">
                <ANNOTATION_VALUE>allora come diceva lei prima,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1290" ANNOTATION_REF="a1289">
                <ANNOTATION_VALUE>e:h io ho tanta pazienz[a ma vera]mente: un'infinità di pazienza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1294" ANNOTATION_REF="a1293">
                <ANNOTATION_VALUE>e il primo anno quando ero: in corso monte cucco ho avuto questa coinquili[na che::],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1298" ANNOTATION_REF="a1297">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1300" ANNOTATION_REF="a1299">
                <ANNOTATION_VALUE>che: era un po' particolare [de]l tipo: boh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1304" ANNOTATION_REF="a1303">
                <ANNOTATION_VALUE>le cose vanno in quel preciso punto spostate anche solo un po' più a destra o a sinistra era:: una tragedia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1306" ANNOTATION_REF="a1305">
                <ANNOTATION_VALUE>e:: beh abbiamo avuto da litigare a un certo punto proprio perché: io frequentavo un ragazzo in quel periodo e:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1308" ANNOTATION_REF="a1307">
                <ANNOTATION_VALUE>per qualche motivo lei non voleva che venisse a casa dovevo sempre andare io a casa sua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1310" ANNOTATION_REF="a1309">
                <ANNOTATION_VALUE>e a un certo punto mi son stufata le ho detto senti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1312" ANNOTATION_REF="a1311">
                <ANNOTATION_VALUE>eh se una sera viene che ti costa tanto sta in camera mia [non lo vedi non lo] senti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1316" ANNOTATION_REF="a1315">
                <ANNOTATION_VALUE>e ci siam fatti la litigata sul fatto che secondo lei:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1318" ANNOTATION_REF="a1317">
                <ANNOTATION_VALUE>se lui era a casa non poteva andare in bagno di notte se: si doveva alzare perché aveva il pigiama trasparente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1320" ANNOTATION_REF="a1319">
                <ANNOTATION_VALUE>e la mattina non poteva fare la doccia perché c'era lui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1324" ANNOTATION_REF="a1323">
                <ANNOTATION_VALUE>[certo che si chiudeva no] non aveva senso questa:: ((ride)) discussione cioè è stata proprio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1326" ANNOTATION_REF="a1325">
                <ANNOTATION_VALUE>il culmine di una marea di cose poi perché era un po',</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1330" ANNOTATION_REF="a1329">
                <ANNOTATION_VALUE>[sì si ch]iudeva in camera al bu:io:: tutto il giorno a~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1332" ANNOTATION_REF="a1331">
                <ANNOTATION_VALUE>nel periodo che io ero lì tra l'altro è cambiata anche una coinquilina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1334" ANNOTATION_REF="a1333">
                <ANNOTATION_VALUE>e: praticamente questa nuova ragazza non ha saputo il suo nome per: settiman[e perché la vede]va così poco che ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1340" ANNOTATION_REF="a1339">
                <ANNOTATION_VALUE>lei diceva di avere mal di te:sta sempre mal di te:sta::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1342" ANNOTATION_REF="a1341">
                <ANNOTATION_VALUE>però secondo me era,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1344" ANNOTATION_REF="a1343">
                <ANNOTATION_VALUE>s~ senza cattiveria un po' depressa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1348" ANNOTATION_REF="a1347">
                <ANNOTATION_VALUE>[boh secondo me] gli era venuta un po' di depressione perché: ha avuto un cambio tra prima di natale e dopo natale che era inspiegabile</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1350" ANNOTATION_REF="a1349">
                <ANNOTATION_VALUE>cioè proprio impazzita. ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1354" ANNOTATION_REF="a1353">
                <ANNOTATION_VALUE>[sì studiav]a igegneria a:l polit[ecnico],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1358" ANNOTATION_REF="a1357">
                <ANNOTATION_VALUE>[m:h (.) sarà per quello] ((ride)) cioè può darsi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1360" ANNOTATION_REF="a1359">
                <ANNOTATION_VALUE>però era proprio::: no questi fiori puzzano sembra di stare in un cimite:ro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1362" ANNOTATION_REF="a1361">
                <ANNOTATION_VALUE>quando mia mamma mi aveva mandato i fiori per il compleanno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1366" ANNOTATION_REF="a1365">
                <ANNOTATION_VALUE>[e::] o entrava in cucina c'è puzza di bruciato e nessuno aveva bruciato niente ((ride)) (cioè).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
