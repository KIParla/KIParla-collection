                <ANNOTATION_VALUE>e poi c'è una persona che magari sta nell'angolo che a dietro::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1431" ANNOTATION_REF="a1430">
                <ANNOTATION_VALUE>le persone che ballano magari anche solo [semplicemente a prove]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1437" ANNOTATION_REF="a1436">
                <ANNOTATION_VALUE>e spiega i balli appunto e poi magari se è in costume: [anche] i costumi e tutta:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1443" ANNOTATION_REF="a1442">
                <ANNOTATION_VALUE>perché i costumi sarebbe bello farlo anche: a e:h quando:: decorano:: (.) le uova di pasqua perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1445" ANNOTATION_REF="a1444">
                <ANNOTATION_VALUE>sulle decorazioni del[le uova di pas]qua ci sa~ c'è anche lì tutto un significato</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1453" ANNOTATION_REF="a1452">
                <ANNOTATION_VALUE>[e sui] costumi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1459" ANNOTATION_REF="a1458">
                <ANNOTATION_VALUE>[eh quindi]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1463" ANNOTATION_REF="a1462">
                <ANNOTATION_VALUE>eh però qui pensavamo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1467" ANNOTATION_REF="a1466">
                <ANNOTATION_VALUE>con l'orch[estra]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1471" ANNOTATION_REF="a1470">
                <ANNOTATION_VALUE>con l'orch[estra e:: canzoni di gruppo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1481" ANNOTATION_REF="a1480">
                <ANNOTATION_VALUE>[sì ((ride))]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1485" ANNOTATION_REF="a1484">
                <ANNOTATION_VALUE>m::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1491" ANNOTATION_REF="a1490">
                <ANNOTATION_VALUE>s:ì::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1499" ANNOTATION_REF="a1498">
                <ANNOTATION_VALUE>orchestra e canto: di gruppo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1523" ANNOTATION_REF="a1522">
                <ANNOTATION_VALUE>[dove do]ve</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1531" ANNOTATION_REF="a1530">
                <ANNOTATION_VALUE>mhmh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1533" ANNOTATION_REF="a1532">
                <ANNOTATION_VALUE>potete mettere anche solo tipo il simbolo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1539" ANNOTATION_REF="a1538">
                <ANNOTATION_VALUE>allora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1551" ANNOTATION_REF="a1550">
                <ANNOTATION_VALUE>[e::h]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1555" ANNOTATION_REF="a1554">
                <ANNOTATION_VALUE>[io la immaginavo tipo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1559" ANNOTATION_REF="a1558">
                <ANNOTATION_VALUE>del tipo:: che ne so</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1561" ANNOTATION_REF="a1560">
                <ANNOTATION_VALUE>mettiamo [che da]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1565" ANNOTATION_REF="a1564">
                <ANNOTATION_VALUE>nel senso che</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1569" ANNOTATION_REF="a1568">
                <ANNOTATION_VALUE>[proprio loro] ballano però</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1571" ANNOTATION_REF="a1570">
                <ANNOTATION_VALUE>proprio davanti che ne so</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1573" ANNOTATION_REF="a1572">
                <ANNOTATION_VALUE>mettiamo che tipo dall'estintore lì c'è la gente che balla::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1577" ANNOTATION_REF="a1576">
                <ANNOTATION_VALUE>[e poi: (.)] a fianco c'è una persona e prende tutta: la scena,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1579" ANNOTATION_REF="a1578">
                <ANNOTATION_VALUE>e magari usiamo anche qualche cellulare [che ne so] (.) [per fare l'in]tervista: il cellulare poi magari è la telecamera che poi magari gira in mezzo comun[que::]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1591" ANNOTATION_REF="a1590">
                <ANNOTATION_VALUE>[anche se poi]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1619" ANNOTATION_REF="a1618">
                <ANNOTATION_VALUE>no io di solito &gt;faccio&lt; sempre in orizzontale perché prendi più::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1637" ANNOTATION_REF="a1636">
                <ANNOTATION_VALUE>[s:ì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1643" ANNOTATION_REF="a1642">
                <ANNOTATION_VALUE>però bisogna poi °xx xx°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1675" ANNOTATION_REF="a1674">
                <ANNOTATION_VALUE>[ma possiamo fare così]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1689" ANNOTATION_REF="a1688">
                <ANNOTATION_VALUE>eh?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1695" ANNOTATION_REF="a1694">
                <ANNOTATION_VALUE>mhmh,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
