    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@TO046" PARENT_REF="ref@TO046">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>allora io:: studio:: economia e statistica a torino, presso:: cognetti de martis,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>principalmente:: (.) è un corso::: di economia che si specializza un po' di più: sul lato statistico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>del=eh rapporto con=e:h le imprese e le aziende:: (.) ci occupiamo di:: regressio::ni: e::: (.) valutazioni econometriche:=e [degli aspet]ti (.) finanzia:ri (.) e economici delle imprese appunto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>e:::: (.) è una bella università un po' particolare un po' ricercata un po' diversa dal solito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>mi piace perché: si differenzia rispetto all'economia classica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>e::: in quanto ha degli aspetti più specifici:, (.) nel campo matema[tico] che è quello che a me piace di più, rispetto a quello economico puro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>e::: è una scuola non troppo difficile, ma: devi essere porta:to:, devi essere un po'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>inquadra[to] (.) ((ride)) perlomeno per l'aspet~ (.) per gli aspetti matema]tici devi, (.) [devi essere] portato devi es[se]re predispos[to].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>cosa vorrei fare da gran[de]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>e:::: attualmente non hoh. delle idee pre[cise] su cosa voglio fare da grande</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>e:::h mi piacerebbe rimanere nel campo statistico</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>però mi rendo conto: che forse la vita d'ufficio non fa per me=e quindi sono un po':: combattuto, per questo (.) spero di riuscire a: chiarirmi le idee in questo ultimo anno di triennale che mi rimane se no:: incrociamo le dita e speriamo (mah.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>sì. ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>(m::h)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>non dispiacerebbe affatto avere la possibilità di viaggiare perché mi piace, molto questo aspetto, lo trovo decisamente determinante, e:::h sia::: da un punto di vista lavorativo sia da un punto di vista personale, penso che dia molto il viaggiare, e::::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>ti permette veramente di:: ampliare le tue vedu:te:: e di permetterti di conoscere meglio te stesso in primis attraverso, ehm:: il mondo che ti circonda e anche quello che non ti circonda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>esperienze da solo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>di viaggi. e:::h sì::, sono andato:: due anni fa:: a londra:, per lavora:re son stato due mesi lì (.) a lavorare come::: (.) aiutante cameriere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>xx &gt;non so come si traduca&lt;,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>e:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>è stata una bella esperienza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>poi:: ho fatto altre esperienze di viaggi da solo::: più o meno sono andato a trovare amici in erasmus una volta in belgio, una volta in spagna, e una volta in francia nello specifico a parigi, e è una città decisamente deliziosa, molto piacevole,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>e::=m:h assolutamente da:: vedere, almeno una volta nella vita,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>perché:: ((ride)) penso che:: (.) sia la città più bella del mondo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>e:::h delle esperienze che ho avuto:: (.) e:::h in autonomia decisamente sì, (.) è stato:: di gran lunga il viaggio [che mi è piaciu]to più di tutti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>perché::=m::h (.) non lo so forse è stato=il momento giusto per vederla,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>forse è stato: il momento giusto dell'anno per vederla anche, e quindi::: mi ha fatto veramente stare bene essere lì, (.) l'ho apprezzata molto, (.) e:::=m::h e basta: e:h,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>a parigi una settimana, (.) ospitato da::=una: mia amica, (.) che abita lì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>quindi magari anche questo aspet~ aspetto qua mi ha aiutato ad apprezzarla di più il fatto di (.) evitare::: per quanto sia possibile: la vita da turista,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>e:: compiere vita da:: parigino, (.) [in sé] quindi magari questo aspetto mi ha aiutato ad apprezzarla di più perché (.) ti permette di conoscere meglio gli aspetti (.) meno noti di pari:gi:: anche:: se il tempo ovviamente era limita:to quindi, si è fatto quello che si poteva</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>l'esperiehnza. più bella che ho vissuto a parigi. (.) e:::h a~ beh al di là del=eh della città in sé da visi[tare] che l'ho trovata:: magnifica:: (.) e:::h da::: e::h dal notre dame al île de cité::=e i quartieri latini:, o:: il musée d'orsay (.) che sono:: cose fantastiche da vedere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>l'esperienza, più be:lla penso che sia stata::: (.) che siano state le serate passate in casa insieme alla mia ami[ca e alle su]e coinquiline,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>e: in cui: nonostante non capissi niente di quello che dicevano perché non parlo francese,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>e::h si respirava comunque una bella atmos~ una bell'aria, (.) e::h era una piacevole atmosfera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>ehm::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>e poi la casa era magnifica era una bella mansarda: e::h vicino=al cimitero: principale di pari[gi non mi ricordo come si] chiami,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>ehm::: e &gt;sono stati veramente&lt; dei bei momenti: eh=ripeto anche se non capivo niente di [quello che succedeva: attorno capivo giusto uno o due concetti vaghi]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>però,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>sì. attualmente vivo a torino:: perché la mia università è al campus einaudi quindi: torino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>abito:: nella zona:: di @nomeluogo precisamente in fondo @nomeluogo cioè [siamo ancora sal]vi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>[e::h siamo ancora salvi],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>[mi] piace molto:: il mio alloggio, lo lo adoro perché:: è piccolo, economico, ed è comodo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>per l'università, per il centro: e:: ed è anche ben=e:h ben fornito di:: mezzi pubblici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>quindi son veramente soddisfatto di questo aspetto qua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>e::: in generale la vita a torino mi piace molto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>e::h ho iniziato ad apprezzarla:: solo ultimamente solo da un anno a questa parte, perché penso che:: torino sia una di quelle città:, che per=eh per apprezzarle veramente ha bisogno di tempo che devi:: (.) in qualche maniera corteggiarle,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>e quindi::: e::h non si tratta mai o almeno in genera:le:: non si tratta mai di un amore, (.) e::h a prima vista ma è un. un lavoro che richiede un sac[co di tempo],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>[però alla fi]ne: si impara ad apprezzarla e:: ed è un amore grande perché è una città splendida,</ANNOTATION_VALUE>
