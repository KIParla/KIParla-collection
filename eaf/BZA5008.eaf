        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a477">
                <ANNOTATION_VALUE>mh:: io l'ho risolta con lo sport.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a481">
                <ANNOTATION_VALUE>perché (.) eh: avendo giocato a calcio in &lt;parecchie realtà e paesi mi sono potuto creare una rete di amicizie, mistilingue&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a483">
