            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a321">
                <ANNOTATION_VALUE>poche parole [ma tendo] a non,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>a preferire, nonostante (.) conosca anche il dialetto delle mie origini,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a327">
                <ANNOTATION_VALUE>&lt;tendo nei contesti&gt; eh: soprattutto ufficiali a evitare di parlare dialetto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>allora, anche nell'azienda dove lavoravo quando eh:: magari la riunione, (.) entra più nel vivo, eh s- c'è sempre la tendenza a passare dall'hochdeutsch al dia[letto].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>quindi nel contesti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>eh:: informali, è quasi scontato: il dialetto. tant'è che spesso dovevo chiedere di poter parlare in hochdeutsch perché non, alcune cose proprio non le riuscivo a,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a349">
