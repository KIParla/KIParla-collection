                <ANNOTATION_VALUE>però era proprio questo che accennavo al bilinguismo perf- im:perfetto, perché io, nel mio quartiere, (.) non ho &lt;mai mai&gt; parlato in tedesco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>eh n:essun negozio, in nessun ufficio pubblico, in: da da nessuna parte, con nessun amico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>perché::</ANNOTATION_VALUE>
