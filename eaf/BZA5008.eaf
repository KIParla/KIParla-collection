            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a561">
                <ANNOTATION_VALUE>allora il francese, eh: l'ho approfon- [non approfondito], ma, l'ho, (.) eh: diciamo utilizzato nei viaggi che ho fatto in francia tra parigi le havre [dove],</ANNOTATION_VALUE>
