        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>olandesi o comunque magari adesso arriva ma,</ANNOTATION_VALUE>
