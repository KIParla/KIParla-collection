        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a531">
                <ANNOTATION_VALUE>se il: bambino fa più fatica in italiano, si può aiutarlo in tedesco, e:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
