        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a509">
                <ANNOTATION_VALUE>eh:: non lo so a salorno, piuttosto che:,</ANNOTATION_VALUE>
