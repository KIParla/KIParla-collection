            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>in realtà no, (.) perché, (.) e:hm in inghilterra la avvertivo perché (.) &lt;in inghilterra con, in determinati ambienti&gt;,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>eh: la conoscenza dell'inglese è molto approfondita e ci tengono molto alla lingua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>eh: qui invece, &lt;al di là di alcuni ambienti&gt;, la lingua preferita in realtà sappiamo essere dialet[to],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>e quindi anche l'interlocutore che c'è eh: dall'altra parte non parla un tedesco perfetto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>eh quindi ecco la:,</ANNOTATION_VALUE>
