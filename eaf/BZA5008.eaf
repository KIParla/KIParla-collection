            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a367">
                <ANNOTATION_VALUE>allora nonostante, eh: sia anche questo secondo me un modo importantissimo per approfondire la lingua, (.) come fanno all'estero perché credo che, (.) ad esempio, tanti ragazzi olandesi che conosco, (.) eh: sono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>incentivati a imparare l'inglese perché non ci sono doppiatori diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
