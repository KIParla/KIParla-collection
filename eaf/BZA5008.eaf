        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>credo che in ambito lavorativo non ci sia spazio però per il dialetto. (.) [questa è una] criticità che ritengo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>molto poco professionale, (.) sia che sia dialetto italiano, che sia dialetto tedesco, chiaramente [non ho nessun] tipo di pregiudizio o di,</ANNOTATION_VALUE>
