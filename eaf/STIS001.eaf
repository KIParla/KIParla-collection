				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1615" ANNOTATION_REF="a32">
				<ANNOTATION_VALUE>per la sua malattia</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1616" ANNOTATION_REF="a33">
				<ANNOTATION_VALUE>il trattamento in italia è stato</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1617" ANNOTATION_REF="a43">
				<ANNOTATION_VALUE>abbiamo fatto le pratiche per l'assistenza</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1618" ANNOTATION_REF="a44">
				<ANNOTATION_VALUE>ospedaliera di mio figlio</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1619" ANNOTATION_REF="a46">
				<ANNOTATION_VALUE>in novembre in che data?</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1620" ANNOTATION_REF="a48">
				<ANNOTATION_VALUE>non mi ricordo la data però ci hanno ricoverato mio figlio e io</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1621" ANNOTATION_REF="a50">
				<ANNOTATION_VALUE>siamo rimasti dieci giorni</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1622" ANNOTATION_REF="a52">
				<ANNOTATION_VALUE>gli hanno fatto tutti gli esami</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1623" ANNOTATION_REF="a54">
				<ANNOTATION_VALUE>in perù hanno impiegato circa due anni</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1624" ANNOTATION_REF="a57">
				<ANNOTATION_VALUE>qui è stato velocissimo</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1625" ANNOTATION_REF="a60">
				<ANNOTATION_VALUE>quindi</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1626" ANNOTATION_REF="a63">
				<ANNOTATION_VALUE>perché in perù era in lista per un trapianto di cuore</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1627" ANNOTATION_REF="a67">
				<ANNOTATION_VALUE>in perù non c'era altra</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1628" ANNOTATION_REF="a68">
				<ANNOTATION_VALUE>non mi davano alte opzioni</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1629" ANNOTATION_REF="a70">
				<ANNOTATION_VALUE>sì allora qui in italia sì</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1630" ANNOTATION_REF="a71">
				<ANNOTATION_VALUE>mi hanno dato un'altra opzione e quindi gli hanno fatto questo intervento in gennaio</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1631" ANNOTATION_REF="a72">
				<ANNOTATION_VALUE>c'è un'altra possibilità grazie a cui non ha bisogno del trapianto del cuore</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1632" ANNOTATION_REF="a76">
				<ANNOTATION_VALUE>è migliorato</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1633" ANNOTATION_REF="a77">
				<ANNOTATION_VALUE>ovviamente siamo felici per questo</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1634" ANNOTATION_REF="a79">
				<ANNOTATION_VALUE>riguardo a mio figlio</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1635" ANNOTATION_REF="a91">
				<ANNOTATION_VALUE>abbiamo visitato pochi posti</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1636" ANNOTATION_REF="a92">
				<ANNOTATION_VALUE>in realtà perché ci siamo occupati più di nostro figlio della salute di nostro figlio</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1637" ANNOTATION_REF="a94">
				<ANNOTATION_VALUE>siamo stati impegnati con questo in questi cinque mesi che sono stata qui</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1639" ANNOTATION_REF="a140">
				<ANNOTATION_VALUE>allora</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a1642" ANNOTATION_REF="a189">
				<ANNOTATION_VALUE>altri posti non siamo riusciti a visitarli</ANNOTATION_VALUE>
