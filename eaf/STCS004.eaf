		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a578" ANNOTATION_REF="a132">
				<ANNOTATION_VALUE>e siccome era un paesino piccolo trovare un ospedale era impossibile si era impossibile</ANNOTATION_VALUE>
