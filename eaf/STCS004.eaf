				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a104">
				<ANNOTATION_VALUE>perché mi sentii male, perché dal principio mi dissero non avvicinarti ai cani</ANNOTATION_VALUE>
