			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a541" ANNOTATION_REF="a61">
				<ANNOTATION_VALUE>perché</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a62">
