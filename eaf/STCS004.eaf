				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a34">
				<ANNOTATION_VALUE>e vedo... buongiorno a tutti, inizio a salutare e vado dove stavano i cagnolini, che erano xxx</ANNOTATION_VALUE>
