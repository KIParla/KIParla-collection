				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a9">
				<ANNOTATION_VALUE>e praticamente il cagnolino chihuahua</ANNOTATION_VALUE>
