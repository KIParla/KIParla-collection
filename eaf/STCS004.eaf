				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a114">
				<ANNOTATION_VALUE>mi disse ti abbiamo detto di non avvicinarti al cane</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a569" ANNOTATION_REF="a117">
				<ANNOTATION_VALUE>ti abbiamo detto di non avvicinarti al cane, però non ci ho prestato attenzione</ANNOTATION_VALUE>
				</REF_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<REF_ANNOTATION ANNOTATION_ID="a570" ANNOTATION_REF="a118">
