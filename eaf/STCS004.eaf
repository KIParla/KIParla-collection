        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>ho portato un regalo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1071" ANNOTATION_REF="a1070">
                <ANNOTATION_VALUE>con calma sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1079" ANNOTATION_REF="a1078">
                <ANNOTATION_VALUE>((ridendo)) co:::me non lo sai</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1083" ANNOTATION_REF="a1082">
                <ANNOTATION_VALUE>come non lo sai? ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1087" ANNOTATION_REF="a1086">
                <ANNOTATION_VALUE>no no andiamo:: a fare:: arriva questa:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1091" ANNOTATION_REF="a1090">
                <ANNOTATION_VALUE>[p]ersona che insomma ci dà due dritte un po' più: professionali su come si:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1093" ANNOTATION_REF="a1092">
                <ANNOTATION_VALUE>su come si fa una visita guidata, perché questa è proprio una guida turistica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1097" ANNOTATION_REF="a1096">
                <ANNOTATION_VALUE>e quindi le facciamo vedere il nostro gi::ro le raccontiamo un po' cosa stiamo face::ndo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1101" ANNOTATION_REF="a1100">
                <ANNOTATION_VALUE>e ci:: ci dirà qualcosina no:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1103" ANNOTATION_REF="a1102">
                <ANNOTATION_VALUE>non so bene se si è preparata qualcosa però ha detto:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1105" ANNOTATION_REF="a1104">
                <ANNOTATION_VALUE>voi fateci vedere cosa volete fare io mag[ari:]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1109" ANNOTATION_REF="a1108">
                <ANNOTATION_VALUE>vi do: due:: elementi in più</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1113" ANNOTATION_REF="a1112">
                <ANNOTATION_VALUE>[sì sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1127" ANNOTATION_REF="a1126">
                <ANNOTATION_VALUE>com'è ragazzi state bene?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1133" ANNOTATION_REF="a1132">
                <ANNOTATION_VALUE>più o meno?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1137" ANNOTATION_REF="a1136">
                <ANNOTATION_VALUE>ah la gola eh hai mal di gola</ANNOTATION_VALUE>
