        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1804" ANNOTATION_REF="a1803">
                <ANNOTATION_VALUE>ma non mi ha dato l'apparecchio xxx</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1830" ANNOTATION_REF="a1829">
                <ANNOTATION_VALUE>eh ma non gli ha dato l'apparecchio, non c'è, xx per caso @amir è con loro?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1839" ANNOTATION_REF="a1838">
                <ANNOTATION_VALUE>quale apparecchio è quello che lei hai comprato?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1859" ANNOTATION_REF="a1858">
                <ANNOTATION_VALUE>ma vieni @yahya</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1895" ANNOTATION_REF="a1894">
                <ANNOTATION_VALUE>ho detto, sai, le ho detto che eri di cattivo umore e lei mi ha detto di venire</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1964" ANNOTATION_REF="a1963">
                <ANNOTATION_VALUE>ma cosa dobbiamo fare adesso?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2051" ANNOTATION_REF="a2050">
                <ANNOTATION_VALUE>questa, quella che ho fatto nuova</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2054" ANNOTATION_REF="a2053">
                <ANNOTATION_VALUE>si vede, conto corrente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2057" ANNOTATION_REF="a2056">
                <ANNOTATION_VALUE>allora, non versare quello, è solo tre, non versare quella è cinque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2060" ANNOTATION_REF="a2059">
                <ANNOTATION_VALUE>@nomebanca, l'abbiamo ricaricata e tutto però qui...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2063" ANNOTATION_REF="a2062">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2068" ANNOTATION_REF="a2067">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2075" ANNOTATION_REF="a2074">
                <ANNOTATION_VALUE>vado da loro?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2078" ANNOTATION_REF="a2077">
                <ANNOTATION_VALUE>ti diranno che c'è un applicazione, che non ti hanno aggiunto, e te la aggiungeranno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2081" ANNOTATION_REF="a2080">
                <ANNOTATION_VALUE>però, se gliela aggiungeranno, funzionerà in un giorno in modo veloce?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2086" ANNOTATION_REF="a2085">
                <ANNOTATION_VALUE>domani andremo, è quello che mi ha detto @amir, al mattino andremo da lui</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2103" ANNOTATION_REF="a2102">
                <ANNOTATION_VALUE>premi sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2110" ANNOTATION_REF="a2109">
                <ANNOTATION_VALUE>quando vado allo sportello automatico non risulta l'opzione del bonifico, chissà perchè, si vede che non è stata ancora aggiunta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2121" ANNOTATION_REF="a2120">
                <ANNOTATION_VALUE>andrò da loro la mattina, questa è la soluzione</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2127" ANNOTATION_REF="a2126">
                <ANNOTATION_VALUE>esatto, non perdiamo tempo che sennò rischiamo di sbagliare</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2133" ANNOTATION_REF="a2132">
                <ANNOTATION_VALUE>no, adesso, per esempio, quello del bonifico, mi faccia un bonifico</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2136" ANNOTATION_REF="a2135">
                <ANNOTATION_VALUE>sì, sorella mia, da lì, basta</ANNOTATION_VALUE>
