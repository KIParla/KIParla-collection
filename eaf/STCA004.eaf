                <ANNOTATION_VALUE>[quando stai lì a:h] però: c'è ramadan c'è lì: però: tutto chiu:so tutto capito?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1709" ANNOTATION_REF="a1708">
                <ANNOTATION_VALUE>sì sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1711" ANNOTATION_REF="a1710">
                <ANNOTATION_VALUE>però: non c'è ramadān c'è: o l'a:ltra cosa capito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1715" ANNOTATION_REF="a1714">
                <ANNOTATION_VALUE>non è:: con ramadān tu:tto chiuso co:n [i ba:r tutto chiuso]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1731" ANNOTATION_REF="a1730">
                <ANNOTATION_VALUE>sì e quando c'è ramadān meglio: c'è tu: c'è e vedi:: la vita: altra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1733" ANNOTATION_REF="a1732">
                <ANNOTATION_VALUE>ca[pito]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1737" ANNOTATION_REF="a1736">
                <ANNOTATION_VALUE>non è come ramadān tu:tto chiu:so</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
