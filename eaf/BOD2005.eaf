        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1500" ANNOTATION_REF="a1499">
                <ANNOTATION_VALUE>[madonna]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1504" ANNOTATION_REF="a1503">
                <ANNOTATION_VALUE>io pensavo che si [stesse palummando proprio] all'ennesimo livello tipo ((fa_versi))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1516" ANNOTATION_REF="a1515">
                <ANNOTATION_VALUE>io volevo accarezzarlo solo che ora ho paura che mi lecchi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1522" ANNOTATION_REF="a1521">
                <ANNOTATION_VALUE>non vogliamo chi?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1524" ANNOTATION_REF="a1523">
                <ANNOTATION_VALUE>tu o il cane?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1528" ANNOTATION_REF="a1527">
                <ANNOTATION_VALUE>perché secondo me lei sì, vuole che l'accar[ezzi]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1532" ANNOTATION_REF="a1531">
                <ANNOTATION_VALUE>comunque io mi sono divertito un sacco con quell'esame,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
