        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2968" ANNOTATION_REF="a2967">
                <ANNOTATION_VALUE>[i]o pe[nso di sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2972" ANNOTATION_REF="a2971">
                <ANNOTATION_VALUE>PERCHE' x il vaso non tende a: stare [alle intemperie così ta~]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2982" ANNOTATION_REF="a2981">
                <ANNOTATION_VALUE>[cioè] mi sembra più logico che la terracotta sbricioli che: il l'ethernit cioè che l'amianto onestame[nte]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2990" ANNOTATION_REF="a2989">
                <ANNOTATION_VALUE>ma l'amianto me lo immagino diverso non lo so poi eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2994" ANNOTATION_REF="a2993">
                <ANNOTATION_VALUE>[sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2996" ANNOTATION_REF="a2995">
                <ANNOTATION_VALUE>mi sembra: più:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3000" ANNOTATION_REF="a2999">
                <ANNOTATION_VALUE>[eh]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3002" ANNOTATION_REF="a3001">
                <ANNOTATION_VALUE>[E]SATTO fa le polveri ma non: si s~ non perde i pezzetti~ le briciole</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3006" ANNOTATION_REF="a3005">
                <ANNOTATION_VALUE>[ma] è polvere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3010" ANNOTATION_REF="a3009">
                <ANNOTATION_VALUE>[non] a caso l'altro mio nonno ((ride)) mo tornando sempre alla mia famiglia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3012" ANNOTATION_REF="a3011">
                <ANNOTATION_VALUE>ha: fatto per la maggior parte della sua vita pensione d'indennità perché lavorava nel[la::]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3016" ANNOTATION_REF="a3015">
                <ANNOTATION_VALUE>mio nonno lavorava nell</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3018" ANNOTATION_REF="a3017">
                <ANNOTATION_VALUE>che lavoravano:: l'amia[nto]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3022" ANNOTATION_REF="a3021">
                <ANNOTATION_VALUE>e quindi lui per molto tempo:: è stato:: cioè la maggior parte della sua vita l'ha passata a casa con la pensione d'invalidità perché</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3024" ANNOTATION_REF="a3023">
                <ANNOTATION_VALUE>era stato:: a contatto con l'amiant[o per anni anni] e anni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3032" ANNOTATION_REF="a3031">
                <ANNOTATION_VALUE>[no di tumore] no</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3034" ANNOTATION_REF="a3033">
                <ANNOTATION_VALUE>però:: ha avuto problemi di salute:: abbastanza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3038" ANNOTATION_REF="a3037">
                <ANNOTATION_VALUE>[problemi ai reni sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3040" ANNOTATION_REF="a3039">
                <ANNOTATION_VALUE>ma prima di avere problemi ai reni lui aveva problemi ai polmoni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3042" ANNOTATION_REF="a3041">
                <ANNOTATION_VALUE>per[ché av]endo respirato: l'amianto per tanti anni lui aveva p~ non gli è mai venuto per fortuna tumore robe del genere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3046" ANNOTATION_REF="a3045">
                <ANNOTATION_VALUE>però aveva problemi respiratori</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3050" ANNOTATION_REF="a3049">
                <ANNOTATION_VALUE>[e]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3052" ANNOTATION_REF="a3051">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3054" ANNOTATION_REF="a3053">
                <ANNOTATION_VALUE>fumava anche quindi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3058" ANNOTATION_REF="a3057">
                <ANNOTATION_VALUE>e:h un altra sto[ria quella]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3062" ANNOTATION_REF="a3061">
                <ANNOTATION_VALUE>[pe]rò e:h lui aveva sempre bisogno delle bossi~ delle bo: delle bombole di ossigeno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3064" ANNOTATION_REF="a3063">
                <ANNOTATION_VALUE>per poter respirare la notte tipo doveva mettersela perché aveva problemi respiratori</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3068" ANNOTATION_REF="a3067">
                <ANNOTATION_VALUE>allora ne~ all'inizio l'ha vissuta molto grave poi col tempo paradossalmente è migliora[to]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3074" ANNOTATION_REF="a3073">
                <ANNOTATION_VALUE>&gt;cioè mi ricordo che quando faceva la dialisi&lt; che lui non:: non usava quasi più la bombola giusto raramente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3076" ANNOTATION_REF="a3075">
                <ANNOTATION_VALUE>quando aveva problemi respiratori la utilizzava ma era quando si sentiva che non ce la faceva a respirare bene</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3080" ANNOTATION_REF="a3079">
                <ANNOTATION_VALUE>non era: tipo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3082" ANNOTATION_REF="a3081">
                <ANNOTATION_VALUE>posso fare un so</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3088" ANNOTATION_REF="a3087">
                <ANNOTATION_VALUE>[che cazzo è]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3096" ANNOTATION_REF="a3095">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
