                <ANNOTATION_VALUE>no in realtà era una una sagra di circolo per[ò non mi ri]cordo neanche dov'era perché era: un po' di tempo fa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4106" ANNOTATION_REF="a4105">
                <ANNOTATION_VALUE>però sagra sagra: ancora no [non:] non mi è capitato c'era la sagra del tartufo che volevo andarci però</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4110" ANNOTATION_REF="a4109">
                <ANNOTATION_VALUE>però (.) il mio problema sono i turni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4112" ANNOTATION_REF="a4111">
                <ANNOTATION_VALUE>e: quindi: quando magari non ho notte io ha notte l'altra amica [che cono]sce un po' la zona e::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4122" ANNOTATION_REF="a4121">
                <ANNOTATION_VALUE>[no] no[n: ce la pos][siam fare]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4132" ANNOTATION_REF="a4131">
                <ANNOTATION_VALUE>quindi sagre sagre no</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4136" ANNOTATION_REF="a4135">
                <ANNOTATION_VALUE>°mi dispiace°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4142" ANNOTATION_REF="a4141">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4150" ANNOTATION_REF="a4149">
                <ANNOTATION_VALUE>[oddio che buo]na</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4154" ANNOTATION_REF="a4153">
                <ANNOTATION_VALUE>noi le mangi[amo un sacco °sì°]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4162" ANNOTATION_REF="a4161">
                <ANNOTATION_VALUE>sì [sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4166" ANNOTATION_REF="a4165">
                <ANNOTATION_VALUE>la rana no</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4168" ANNOTATION_REF="a4167">
                <ANNOTATION_VALUE>la lu[maca sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4184" ANNOTATION_REF="a4183">
                <ANNOTATION_VALUE>[°eh devo venire°]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4192" ANNOTATION_REF="a4191">
                <ANNOTATION_VALUE>[è]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4194" ANNOTATION_REF="a4193">
                <ANNOTATION_VALUE>[è stra buo]na la luma~ noi abbiamo tre tipi di lumache,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4196" ANNOTATION_REF="a4195">
                <ANNOTATION_VALUE>quelle piccoline piccoline che le cuoci: [poi ci metti]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4200" ANNOTATION_REF="a4199">
                <ANNOTATION_VALUE>[quelle piccoline bianche]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4202" ANNOTATION_REF="a4201">
                <ANNOTATION_VALUE>e:: poi ci sono quelle con la panna</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4204" ANNOTATION_REF="a4203">
                <ANNOTATION_VALUE>che in realtà non è la panna però</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4206" ANNOTATION_REF="a4205">
                <ANNOTATION_VALUE>x m::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4208" ANNOTATION_REF="a4207">
                <ANNOTATION_VALUE>c(io)è c'hanno tipo la pellicol[a]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4214" ANNOTATION_REF="a4213">
                <ANNOTATION_VALUE>[che le] fai soffritte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4216" ANNOTATION_REF="a4215">
                <ANNOTATION_VALUE>e poi ci son quelle grosse tipo le escargot</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4220" ANNOTATION_REF="a4219">
                <ANNOTATION_VALUE>[eh io] sono un'[appassionata di lumache]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4226" ANNOTATION_REF="a4225">
                <ANNOTATION_VALUE>lo so che fa schifo per[ò]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4238" ANNOTATION_REF="a4237">
                <ANNOTATION_VALUE>[fari]na di insetti rega ((ride)) farina di inse[t~]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4242" ANNOTATION_REF="a4241">
                <ANNOTATION_VALUE>[nutrienti] ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4250" ANNOTATION_REF="a4249">
