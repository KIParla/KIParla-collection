            <REF_ANNOTATION ANNOTATION_ID="a3999" ANNOTATION_REF="a3998">
                <ANNOTATION_VALUE>e la superiore,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4001" ANNOTATION_REF="a4000">
                <ANNOTATION_VALUE>e poi allora puoi entrare all'università.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4005" ANNOTATION_REF="a4004">
                <ANNOTATION_VALUE>e l'università in italia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4007" ANNOTATION_REF="a4006">
                <ANNOTATION_VALUE>e:::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4009" ANNOTATION_REF="a4008">
                <ANNOTATION_VALUE>diciamo la cosa positiva è che non costa tanto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4011" ANNOTATION_REF="a4010">
                <ANNOTATION_VALUE>se tu (.) hai un reddito un guadagno basso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4013" ANNOTATION_REF="a4012">
                <ANNOTATION_VALUE>l'università ti aiuta::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4015" ANNOTATION_REF="a4014">
                <ANNOTATION_VALUE>quindi non è:: non è tanto:: costosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4019" ANNOTATION_REF="a4018">
                <ANNOTATION_VALUE>e:hm questo è buono perché invece in altri paesi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4021" ANNOTATION_REF="a4020">
                <ANNOTATION_VALUE>l'università costa tantissimo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4023" ANNOTATION_REF="a4022">
                <ANNOTATION_VALUE>e:::h e non c'è modo (.) di non pagare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4025" ANNOTATION_REF="a4024">
                <ANNOTATION_VALUE>invece in italia paghi, (.) in base a quanti soldi hai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4027" ANNOTATION_REF="a4026">
                <ANNOTATION_VALUE>quindi se:: se solo una persona lavora in casa ad esempio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4029" ANNOTATION_REF="a4028">
                <ANNOTATION_VALUE>devi pagare proprio (.) o NIENTE o duecento euro all'anno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4031" ANNOTATION_REF="a4030">
                <ANNOTATION_VALUE>okay e anche::: m::h non lo so,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4033" ANNOTATION_REF="a4032">
                <ANNOTATION_VALUE>puoi ricevere addirittura delle borse di studio:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4035" ANNOTATION_REF="a4034">
                <ANNOTATION_VALUE>per aiutare anche:: la persona a studiare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4039" ANNOTATION_REF="a4038">
