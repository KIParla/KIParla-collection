            <REF_ANNOTATION ANNOTATION_ID="a4183" ANNOTATION_REF="a4182">
                <ANNOTATION_VALUE>[eh]?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4185" ANNOTATION_REF="a4184">
                <ANNOTATION_VALUE>quindi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4187" ANNOTATION_REF="a4186">
                <ANNOTATION_VALUE>per andare nella sc~ nell'università,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4191" ANNOTATION_REF="a4190">
                <ANNOTATION_VALUE>devi avere esatto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4193" ANNOTATION_REF="a4192">
                <ANNOTATION_VALUE>che in pratica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4195" ANNOTATION_REF="a4194">
                <ANNOTATION_VALUE>la stessa durata nel senso che se lui fa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4197" ANNOTATION_REF="a4196">
                <ANNOTATION_VALUE>la formazione professionale dura di solito tre anni.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4199" ANNOTATION_REF="a4198">
                <ANNOTATION_VALUE>per avere la qualifica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4201" ANNOTATION_REF="a4200">
                <ANNOTATION_VALUE>m:h (.) potrebbe proseguire,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4203" ANNOTATION_REF="a4202">
                <ANNOTATION_VALUE>e:hm prendendosi un diploma di maturità con la scuola serale se vuole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4205" ANNOTATION_REF="a4204">
                <ANNOTATION_VALUE>perché è la stessa durata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4207" ANNOTATION_REF="a4206">
                <ANNOTATION_VALUE>dura tre anni.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4219" ANNOTATION_REF="a4218">
                <ANNOTATION_VALUE>[devono essere adulti]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4228" ANNOTATION_REF="a4227">
                <ANNOTATION_VALUE>se vuole si può [fare così]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4232" ANNOTATION_REF="a4231">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4234" ANNOTATION_REF="a4233">
                <ANNOTATION_VALUE>alcune prendono anche se hanno diciassette anni: se sono nell'anno:: dei diciotto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4236" ANNOTATION_REF="a4235">
                <ANNOTATION_VALUE>però,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
