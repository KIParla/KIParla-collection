            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4043" ANNOTATION_REF="a4042">
                <ANNOTATION_VALUE>perché:: se una persona vuole ricominciare l'università</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4045" ANNOTATION_REF="a4044">
