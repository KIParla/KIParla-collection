        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3262" ANNOTATION_REF="a3261">
                <ANNOTATION_VALUE>io ne ho conosciuta una,</ANNOTATION_VALUE>
