        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a540" ANNOTATION_REF="a539">
                <ANNOTATION_VALUE>cioè gli antropologi evoluzionisti, confrontano</ANNOTATION_VALUE>
