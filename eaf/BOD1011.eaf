        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3214" ANNOTATION_REF="a3213">
                <ANNOTATION_VALUE>e portavano alla diminuzione del piacere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3216" ANNOTATION_REF="a3215">
                <ANNOTATION_VALUE>e questo dal punto di vista culturale, non era un ragionamento efficace, eh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3218" ANNOTATION_REF="a3217">
                <ANNOTATION_VALUE>tu non puoi andare nei villaggi e dire così no? siamo più emancipate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3220" ANNOTATION_REF="a3219">
                <ANNOTATION_VALUE>però, soprattutto per quanto riguarda l'infibulazione, che consiste nella</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3222" ANNOTATION_REF="a3221">
