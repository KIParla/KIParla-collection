        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a533">
                <ANNOTATION_VALUE>questo l'abbiamo detto ieri no? i materiali che raccoglievano gli antropologi dell'otteocento, erano delle:</ANNOTATION_VALUE>
