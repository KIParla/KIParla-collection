        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>la monogamia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>mh?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>poi abbiamo ad esempio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>sul piano della religione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>l'animismo, cioè la credenza che ogni (.) oggetto ogni animale ha un'anima, nello stadio (.) più (.) selvaggio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>per via via arrivare al politeismo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>e infine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>nella cultura vittoriana dell'ottocento, qual era la forma religiosa (.) più alta?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>il monoteismo. vedete? mono~ gamia, mono~ teismo. perché il riferimento diventa sempre la cultura di appartenenza.</ANNOTATION_VALUE>
