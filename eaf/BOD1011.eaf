        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3242" ANNOTATION_REF="a3241">
                <ANNOTATION_VALUE>noi donne somale,</ANNOTATION_VALUE>
