        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a812" ANNOTATION_REF="a811">
                <ANNOTATION_VALUE>allora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a814" ANNOTATION_REF="a813">
                <ANNOTATION_VALUE>il concetto di cultura, naturalmente da tylor in poi cambia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a816" ANNOTATION_REF="a815">
                <ANNOTATION_VALUE>e sostanzialmente oggi, uno degli approcci più interessanti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a818" ANNOTATION_REF="a817">
                <ANNOTATION_VALUE>è quello di (.) clifford geertz.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a820" ANNOTATION_REF="a819">
                <ANNOTATION_VALUE>l'essere umano viene concepito come (.) un animale carente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a822" ANNOTATION_REF="a821">
                <ANNOTATION_VALUE>cosa significa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a824" ANNOTATION_REF="a823">
                <ANNOTATION_VALUE>che, come abbiamo detto precedentemente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a826" ANNOTATION_REF="a825">
                <ANNOTATION_VALUE>l'essere umano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a828" ANNOTATION_REF="a827">
                <ANNOTATION_VALUE>in assenza di una cultura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a830" ANNOTATION_REF="a829">
                <ANNOTATION_VALUE>non è in grado neppure di sopravvivere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a832" ANNOTATION_REF="a831">
                <ANNOTATION_VALUE>l'essere umano, è per definizione incompleto. voi sapete che,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a834" ANNOTATION_REF="a833">
                <ANNOTATION_VALUE>i bambini piccoli sono (.) sostanzialmente, prole inetta. no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a836" ANNOTATION_REF="a835">
                <ANNOTATION_VALUE>la specie umana ha questa caratteristica. un neonato da solo che fa? muore.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a838" ANNOTATION_REF="a837">
                <ANNOTATION_VALUE>tante altre specie animali invece hanno una prole che (.) può sopravvivere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a840" ANNOTATION_REF="a839">
                <ANNOTATION_VALUE>e quindi noi parliamo di incompletezza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a842" ANNOTATION_REF="a841">
                <ANNOTATION_VALUE>nel senso che ciascun individuo quando viene al mondo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a844" ANNOTATION_REF="a843">
                <ANNOTATION_VALUE>è come se fosse nudo, e viene completato dalla cultura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a846" ANNOTATION_REF="a845">
                <ANNOTATION_VALUE>viene reso uomo, reso donna, dalla cultura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a848" ANNOTATION_REF="a847">
                <ANNOTATION_VALUE>in realtà non è esatto dire così, no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a850" ANNOTATION_REF="a849">
                <ANNOTATION_VALUE>perché non viene completato dalla cultura, ma viene (.) completato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a852" ANNOTATION_REF="a851">
                <ANNOTATION_VALUE>dalle culture. cioè dalla singola specifica cultura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a854" ANNOTATION_REF="a853">
                <ANNOTATION_VALUE>del luogo (.) in cui nasce,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a856" ANNOTATION_REF="a855">
                <ANNOTATION_VALUE>uno degli esempi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a858" ANNOTATION_REF="a857">
                <ANNOTATION_VALUE>&gt;allora&lt; m:: noi adesso tante cose le diamo per scontate. a parte che non è vero, perché lo scalpore, avete sentito che::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a860" ANNOTATION_REF="a859">
                <ANNOTATION_VALUE>ve l'ho già detto ieri della, f~ dell'inglese no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a862" ANNOTATION_REF="a861">
                <ANNOTATION_VALUE>lo scalpore che ha suscitato il fatto che un inglese</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a864" ANNOTATION_REF="a863">
                <ANNOTATION_VALUE>di diecimila anni fa, fosse nero con gli occhi azzurri, ce la dice lunga sul fatto che in realtà (.) non abbiamo superato tutto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a866" ANNOTATION_REF="a865">
                <ANNOTATION_VALUE>però,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a868" ANNOTATION_REF="a867">
                <ANNOTATION_VALUE>l'idea che (.) ad esempio un bambino adottato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a870" ANNOTATION_REF="a869">
                <ANNOTATION_VALUE>cambi completamente e::h il proprio comportamento sulla base della famiglia che lo accoglie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a872" ANNOTATION_REF="a871">
                <ANNOTATION_VALUE>e non sulla base della sua genetica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a874" ANNOTATION_REF="a873">
                <ANNOTATION_VALUE>era un esempio che gli antropologi fornivano sempre e dicvano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a876" ANNOTATION_REF="a875">
                <ANNOTATION_VALUE>se noi prendiamo un bambino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a878" ANNOTATION_REF="a877">
                <ANNOTATION_VALUE>inuit,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a880" ANNOTATION_REF="a879">
                <ANNOTATION_VALUE>inuit sarebbe la parola più appropriata</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a882" ANNOTATION_REF="a881">
                <ANNOTATION_VALUE>per (.) definire quell che una volta venivano chiamati eschimesi. no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a884" ANNOTATION_REF="a883">
                <ANNOTATION_VALUE>eschimesi vuol dire mangiatori di carne cruda, un termine dispregiativo che usavano popolazioni vicine.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a886" ANNOTATION_REF="a885">
                <ANNOTATION_VALUE>quindi se un bambino inuit viene cresciuto, in un altro luogo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a888" ANNOTATION_REF="a887">
                <ANNOTATION_VALUE>si comporterà, come un bambino dell'altro luogo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a890" ANNOTATION_REF="a889">
                <ANNOTATION_VALUE>per noi adesso questo è scontato, ma nell'ottocento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a892" ANNOTATION_REF="a891">
                <ANNOTATION_VALUE>e quando pian pian gli antropologi hanno cominciato a combattere per questi temi, non lo era affatto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a894" ANNOTATION_REF="a893">
                <ANNOTATION_VALUE>quindi noi abbiamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a896" ANNOTATION_REF="a895">
                <ANNOTATION_VALUE>una (.) determinazione culturale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a898" ANNOTATION_REF="a897">
                <ANNOTATION_VALUE>che fa sì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a900" ANNOTATION_REF="a899">
                <ANNOTATION_VALUE>che (.) ci vestiamo in un certo modo, mangiamo certi alimenti, ci compor~ ci sediamo in una certa postura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a902" ANNOTATION_REF="a901">
                <ANNOTATION_VALUE>eccetera eccetera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a904" ANNOTATION_REF="a903">
                <ANNOTATION_VALUE>e: in generale, viene sottolineato come il corpo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a906" ANNOTATION_REF="a905">
                <ANNOTATION_VALUE>proprio un elemento che per eccellenza noi tendiamo a pensare come naturale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a908" ANNOTATION_REF="a907">
                <ANNOTATION_VALUE>in realta anche il corpo è profondamente culturale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a910" ANNOTATION_REF="a909">
                <ANNOTATION_VALUE>questo significa che quindi l'antorpologia immagina</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a912" ANNOTATION_REF="a911">
                <ANNOTATION_VALUE>gli individui come</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a914" ANNOTATION_REF="a913">
                <ANNOTATION_VALUE>incapaci di determinazione di libertà di scelta? siamo tutti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a916" ANNOTATION_REF="a915">
                <ANNOTATION_VALUE>vittime della nostra cultura?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a918" ANNOTATION_REF="a917">
                <ANNOTATION_VALUE>certamente non è così.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a920" ANNOTATION_REF="a919">
                <ANNOTATION_VALUE>c'è=una (.) parte di scelta. ma è una parte abbastanza limitata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a922" ANNOTATION_REF="a921">
                <ANNOTATION_VALUE>qui dentro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a924" ANNOTATION_REF="a923">
                <ANNOTATION_VALUE>è chiaro che ciascuno di voi ha i capelli di un colore diverso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a926" ANNOTATION_REF="a925">
                <ANNOTATION_VALUE>è vestito in modo diverso, eccetera. nessuno è venuto vestito da babbo natale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a928" ANNOTATION_REF="a927">
                <ANNOTATION_VALUE>mh? non so poi (.) siete in tanti non vedo tutti non si sa mai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a930" ANNOTATION_REF="a929">
                <ANNOTATION_VALUE>no? quindi ci sono dei range,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a932" ANNOTATION_REF="a931">
                <ANNOTATION_VALUE>per fare un esempio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a934" ANNOTATION_REF="a933">
                <ANNOTATION_VALUE>l'allattamento al seno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a936" ANNOTATION_REF="a935">
                <ANNOTATION_VALUE>indipendentemente dal fatto che uno lo faccia poco o molto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a938" ANNOTATION_REF="a937">
                <ANNOTATION_VALUE>ha un range rispetto alla cultura di appartenenza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a940" ANNOTATION_REF="a939">
                <ANNOTATION_VALUE>quindi è chiaro, ci sono delle determinazioni individuali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a942" ANNOTATION_REF="a941">
                <ANNOTATION_VALUE>e c'è una libertà di scelta, che però è abbastanza (.) contenuta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a944" ANNOTATION_REF="a943">
                <ANNOTATION_VALUE>quindi questo è il concetto di cultura che (.) propone fabietti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a946" ANNOTATION_REF="a945">
                <ANNOTATION_VALUE>è più articolato ovviamente di quello tylor,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a948" ANNOTATION_REF="a947">
                <ANNOTATION_VALUE>però come vedete non si discosta tantissimo da quella definizione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a950" ANNOTATION_REF="a949">
                <ANNOTATION_VALUE>e centra, ((tossisce))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a952" ANNOTATION_REF="a951">
                <ANNOTATION_VALUE>la sua attenzione, sul fatto che il conce~ che la cultura è tramandata ed acquisita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a954" ANNOTATION_REF="a953">
                <ANNOTATION_VALUE>la cultura si tramanda si acquisisce. ci sono dei processi educativi, formali e informali:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a956" ANNOTATION_REF="a955">
                <ANNOTATION_VALUE>che costituiscono l'individuo come membro della società.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a958" ANNOTATION_REF="a957">
                <ANNOTATION_VALUE>quindi sistemi educativi formali come la scuola,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a960" ANNOTATION_REF="a959">
                <ANNOTATION_VALUE>sistemi educativi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a962" ANNOTATION_REF="a961">
                <ANNOTATION_VALUE>informali come (.) varie attività che possono essere svolte con il gruppo dei pari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a964" ANNOTATION_REF="a963">
                <ANNOTATION_VALUE>ci sono attività (.) educative formali come le iniziazioni, che vedremo in seguito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a966" ANNOTATION_REF="a965">
                <ANNOTATION_VALUE>e: l'altro aspetto centrale di questa definizione è che e::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a968" ANNOTATION_REF="a967">
                <ANNOTATION_VALUE>gli individui si accostano al mondo, sia in senso pratico, sia in senso intellettuale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a970" ANNOTATION_REF="a969">
                <ANNOTATION_VALUE>quello che la cultura forgia di noi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a972" ANNOTATION_REF="a971">
                <ANNOTATION_VALUE>è anche il modo di pensare. (.) mh?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a974" ANNOTATION_REF="a973">
                <ANNOTATION_VALUE>e come abbiamo vis~ come abbiamo accennato ieri, anche le emozioni.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a976" ANNOTATION_REF="a975">
                <ANNOTATION_VALUE>quindi noi siamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a978" ANNOTATION_REF="a977">
                <ANNOTATION_VALUE>esseri umani, (.) culturalmente determinati.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a980" ANNOTATION_REF="a979">
                <ANNOTATION_VALUE>perché il corpo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a982" ANNOTATION_REF="a981">
                <ANNOTATION_VALUE>è così interessante come esempio di determinazione culturale?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a984" ANNOTATION_REF="a983">
                <ANNOTATION_VALUE>proprio perché, pensiamo che si allontani,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a986" ANNOTATION_REF="a985">
                <ANNOTATION_VALUE>dalla cultura e sia più vicino alla natura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a988" ANNOTATION_REF="a987">
                <ANNOTATION_VALUE>invece ogni azione che compiamo sul nostro corpo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a990" ANNOTATION_REF="a989">
                <ANNOTATION_VALUE>è (.) culturalmente determinata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a992" ANNOTATION_REF="a991">
                <ANNOTATION_VALUE>che cosa fate voi sul vostro corpo alla mattina?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a994" ANNOTATION_REF="a993">
                <ANNOTATION_VALUE>asupicabilmente, vi lavate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a996" ANNOTATION_REF="a995">
                <ANNOTATION_VALUE>vi lvate, in una modalità, che è culturalmente determinante. dopo di che,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a998" ANNOTATION_REF="a997">
                <ANNOTATION_VALUE>vi pettinate, vi vestite, vi lavate i denti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
