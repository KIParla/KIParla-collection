        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a544" ANNOTATION_REF="a543">
                <ANNOTATION_VALUE>in una popolazione e in un'altra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a546" ANNOTATION_REF="a545">
                <ANNOTATION_VALUE>prendono ad esempio (.) il matrimonio,</ANNOTATION_VALUE>
