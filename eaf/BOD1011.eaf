        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3210" ANNOTATION_REF="a3209">
                <ANNOTATION_VALUE>che le emme gi effe, per esempio</ANNOTATION_VALUE>
