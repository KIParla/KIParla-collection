        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>un altro aspetto che (.) è molto importante per stratificare (.) questi stadi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>è la cultura materiale.</ANNOTATION_VALUE>
