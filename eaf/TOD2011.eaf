            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a311">
                <ANNOTATION_VALUE>ed era tipo:: m::h giallognolo una roba del genere, (.) e infatti mi ricordo che noi toglievamo sempre sto formaggio dai toast perché era veramente immangia[bile],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
