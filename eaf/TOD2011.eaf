    </TIER>
    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@TO047" PARENT_REF="ref@TO047">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ciao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>allora io::, studio::: al politecnico di torino, e::: m::h seguo il corso di:: design e comunicazione visiva,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>che=è:=un corso:: della triennale::: al politecnico:, della sezione di architettura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>perché architettura=ha:: tre indirizzi, (.) uno è: architettura normale, l'altro è di urbanistica, e poi c'è questo che è di design,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>e::: m::h è un corso che:: al primo anno è uguale per tutti, e al secondo anno invece::: m::h ti: m:::h,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>e~ e:::h ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>scegli tu cosa fare, perché::: ci sono due indirizzi, uno è: di grafica e l'altro è: [di prodot]to,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>quindi::: mh ad esempio in quello di prodotto e::hm::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>è più relativo agli oggetti e:::=mh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>diciamo al progettare:: e:h qualcosa di materiale, mentre invece: per grafica, eh si parla soprattutto di web design, quindi::: m:::h poster=e::h tutto:: il quello che riguarda il mondo del=e:h del web.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>e:::h io ho scelto:: di fare:: grafica, perché::: e~ era un indirizzo che mi ispirava di più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>e:: anche perché:: prodotto non=e::h m::h già di primo acchitto non mi è mai ispirato più di tanto, e:::h mh,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>penso che limiti un pochino di più la tua creatività, perché comunque, e:::h hai sempre a che fare con misu:re che devi:: assolutamente rispettare perché:: poi comunque ad esempio per</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>ehm:: progettare una seduta, hai bisogno::=m:h (.) di capire quali sono le:: dimensio:ni:, la struttura, quali: materiali vanno meglio per fare in modo che la seduta rimanga in piedi, e cose del genere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>e quindi::, m::h=non lo so=ho sempre pensato:: che: così sarei:: stata più limitata:: a:: m::h m::h a fare quello che:: che volevo fare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>e:::h=m::h l'indirizzo di grafica invece::=è è molto più interessante perché::=m::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>eh. innanzitutto hai a che fare con=e::h de:i=m:::h,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>ehm:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>dei:: come si chiamano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>no. e::h dei::=m::::h dei programmi al com[pu:ter=eh], che:: m:h (.) sono molto più:: belli da utilizzare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>e::: ad esempio: soprattutto quelli in tre di che vabbè in realtà il=e::h m::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a57">
