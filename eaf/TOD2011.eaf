            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>e:: allora dunque:: e:::h i viaggi::, all'estero, che sono stati::: m:::h diciamo viaggi studio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>e::h risalgono tutti al periodo delle superiori:, ad esempio abbiamo fatto:=un viaggio studio di due settimane, siamo andati in irlanda e:: precisamente a: galway,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>e::: ehm:: che=è a tipo:: m::h due ore da:: dublino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>e::: m::h è stata una bellissima esperienza perché::: eravamo in=e::h eravamo ospiti da:: delle famiglie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a279">
