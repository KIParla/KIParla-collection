        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>((ride)) eh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a319">
                <ANNOTATION_VALUE>e::: m::h e poi anche:: la sera poi:: m::h ci riunivamo tutti:: al tavolo della cucina e mangiavamo tutti insieme,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a321">
                <ANNOTATION_VALUE>e:: la mia famiglia aveva::=m:h due bambini piccoli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a323">
