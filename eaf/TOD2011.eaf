            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>e::: quindi penso che: quando:: cioè se avrò l'occasione di poterne rifare altri, penso che: li rifarò,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
