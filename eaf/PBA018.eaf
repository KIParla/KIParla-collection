            <REF_ANNOTATION ANNOTATION_ID="a1708" ANNOTATION_REF="a1707">
                <ANNOTATION_VALUE>(in)vece: °c(io)è°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1710" ANNOTATION_REF="a1709">
                <ANNOTATION_VALUE>fumi sta sigaretta così, (.) bo:h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1712" ANNOTATION_REF="a1711">
                <ANNOTATION_VALUE>(ehm)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1714" ANNOTATION_REF="a1713">
                <ANNOTATION_VALUE>ti dà solo il sollievo, perché: sei diventato dipendente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1716" ANNOTATION_REF="a1715">
