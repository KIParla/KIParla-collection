        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1718" ANNOTATION_REF="a1717">
                <ANNOTATION_VALUE>s~ quella scarica di:</ANNOTATION_VALUE>
