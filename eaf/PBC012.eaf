            <REF_ANNOTATION ANNOTATION_ID="a2914" ANNOTATION_REF="a2913">
                <ANNOTATION_VALUE>[ver]amente io: il dialetto puro n[on l'ho ma]i parlato [perché]:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2922" ANNOTATION_REF="a2921">
                <ANNOTATION_VALUE>[allora] la la la la [la noi c'e]ra la la città</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2926" ANNOTATION_REF="a2925">
                <ANNOTATION_VALUE>ha diciassette porte (.) no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2930" ANNOTATION_REF="a2929">
                <ANNOTATION_VALUE>diciassette diciassette porte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2934" ANNOTATION_REF="a2933">
                <ANNOTATION_VALUE>capito [eran chiusa in] diciassette porte e ogni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2938" ANNOTATION_REF="a2937">
                <ANNOTATION_VALUE>porta è una zona</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2944" ANNOTATION_REF="a2943">
                <ANNOTATION_VALUE>[era (.) era una zona]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2948" ANNOTATION_REF="a2947">
                <ANNOTATION_VALUE>[allo]ra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2950" ANNOTATION_REF="a2949">
                <ANNOTATION_VALUE>una zona parlava un dialetto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2952" ANNOTATION_REF="a2951">
                <ANNOTATION_VALUE>un'altra zona parlava un altro dialetto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2958" ANNOTATION_REF="a2957">
                <ANNOTATION_VALUE>[eh però]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2960" ANNOTATION_REF="a2959">
                <ANNOTATION_VALUE>però capito molto più diciamo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2962" ANNOTATION_REF="a2961">
                <ANNOTATION_VALUE>però non eran tutti uguali</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2966" ANNOTATION_REF="a2965">
                <ANNOTATION_VALUE>[mi dispiace di non] poterti aiutare molto perché mh::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2976" ANNOTATION_REF="a2975">
                <ANNOTATION_VALUE>non: no ma dico anche perché con quella [(faccenda) che è] una cosa che mi da un fastidio della madonna</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2980" ANNOTATION_REF="a2979">
                <ANNOTATION_VALUE>preso male</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2992" ANNOTATION_REF="a2991">
                <ANNOTATION_VALUE>[mo ma scherzi]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2994" ANNOTATION_REF="a2993">
                <ANNOTATION_VALUE>te sei sempre: (.) accettato</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
