        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2736" ANNOTATION_REF="a2735">
                <ANNOTATION_VALUE>son del cinquantanove mia madre mi ha detto che m'ha portato una volta ma non (me lo ricordo) ((ride))</ANNOTATION_VALUE>
