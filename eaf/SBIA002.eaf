                <ANNOTATION_VALUE>entro [mezzogior]no tutti [i corrieri] devono:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4234" ANNOTATION_REF="a4233">
                <ANNOTATION_VALUE>sono quasi tutti iscritti nostri</ANNOTATION_VALUE>
