        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>pensa che una mia dipende:nte italiana (ha) imparato a parlare in spa[gnolo]</ANNOTATION_VALUE>
