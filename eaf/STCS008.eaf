        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>[noi] per esempio anche a lavoro: [parliamo: un mix] [e:h] italiano spagn[olo esatto]</ANNOTATION_VALUE>
