        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>perché io CERco di parlare in spagnolo però poi ovvia[me:nte mi esce l'ital]iano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>e invece quando dico ma sì dai con questa signora parlo: nella mia mente dico parlo in s~ parlo in spagnolo e lei che comincia a parlarmi in italiano allora</ANNOTATION_VALUE>
