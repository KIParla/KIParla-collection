            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2508" ANNOTATION_REF="a2507">
                <ANNOTATION_VALUE>più che altro il mio livello (.) quando sei poi giovane</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2510" ANNOTATION_REF="a2509">
