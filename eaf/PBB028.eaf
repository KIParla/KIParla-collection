                <ANNOTATION_VALUE>perché il campanaro suonava prima di messa e dopo messa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2470" ANNOTATION_REF="a2469">
                <ANNOTATION_VALUE>e nel frattempo rimaneva su</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2480" ANNOTATION_REF="a2479">
                <ANNOTATION_VALUE>no perché c'erano poi quelli un po' più grandi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2482" ANNOTATION_REF="a2481">
                <ANNOTATION_VALUE>albi co[sì], albi paolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2488" ANNOTATION_REF="a2487">
                <ANNOTATION_VALUE>a:h son~ (.) hanno circa [cinque anni più di me]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
