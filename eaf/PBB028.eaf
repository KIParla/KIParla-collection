        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2512" ANNOTATION_REF="a2511">
                <ANNOTATION_VALUE>loro erano già in quattro quindi (.) mi facevano entrare a me (.) giusto per farmi suonare allora non: (.) dopo un po' (no~) non ce l'ho [più fa]tta</ANNOTATION_VALUE>
