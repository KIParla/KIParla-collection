        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2496" ANNOTATION_REF="a2495">
                <ANNOTATION_VALUE>praticamente eran quelli grandi del paese:, allora mi piaceva andar su con loro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2498" ANNOTATION_REF="a2497">
                <ANNOTATION_VALUE>e::h niente ho iniziato un po' che m~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2500" ANNOTATION_REF="a2499">
                <ANNOTATION_VALUE>m'hanno insegnato</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2502" ANNOTATION_REF="a2501">
                <ANNOTATION_VALUE>poi:: ho sempre lasciato lì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2504" ANNOTATION_REF="a2503">
