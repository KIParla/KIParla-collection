        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a920" ANNOTATION_REF="a919">
                <ANNOTATION_VALUE>eh quello adesso non so perché io non so cosa fa bene al bambino, se poi fa casi:no,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a922" ANNOTATION_REF="a921">
                <ANNOTATION_VALUE>o: se sarebbe meglio parlargli in inglese direttamente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a924" ANNOTATION_REF="a923">
                <ANNOTATION_VALUE>che poi tanto: l'italiano il tedesco lo impara comunque,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a928" ANNOTATION_REF="a927">
                <ANNOTATION_VALUE>non saprei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a934" ANNOTATION_REF="a933">
                <ANNOTATION_VALUE>[sì sì ((ride))]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
