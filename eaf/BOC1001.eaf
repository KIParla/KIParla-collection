            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>[bibliote]che che presto crebbero siamo in età moderna, siamo in epoca del libro stampato, siamo in epoca di</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>avviamento delle tirature e anche del numero dei titoli rispetto (.) all'età nonantolana no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>e::hm e quindi xxxxxxx molto presto a, (.) a raggiungere dimensioni ragguardevoli no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>sì.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>la maggior parte di questi cataloghi quando esisevano, non sempre esistevano però in molti casi sì anche perché c'era una norma prevista [dalle rego]le</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>xx [xxx]x</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>[xxxx xxx]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>xx proprio c'è una norma che prevedeva appunto (.) la la (.) compilazione</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>di due cataloghi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>e:hm</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>e quindi (.) normalmente lo avevano in alcuni casi no xxx biblioteche erano molto piccole non l'avevano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>e:hm</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>in molti casi in cui vi era un catalogo questo era manoscritto. c'erano anche casi in cui questi cataloghi erano a stampa?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>[sì, brava].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>[però erano mino]ritari (.) [ricorda] anche:, (.) qualche collegio che ha cataloghi a stampa?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a381">
                <ANNOTATION_VALUE>viene indicato in una nota del mio primo saggio::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>il titolo (.) menzionava questo fatto molto eccezionale (.) °glielo dico subito.°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>è il caso di palermo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>il collegio massimo ha un catalogo a stampa che viene redatto nel diciassettesimo secolo xxxx non me lo ricordo, milleseicentottanta o qualcosa del genere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>però è un caso molto raro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a395">
                <ANNOTATION_VALUE>per lo più noi abbiamo cataloghi a stampa, forse lei è venuta a lezione di</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>lei è venuta a lezione? [per]ché la ricordo, e:hm di cataloghi::: (.) di asta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a403">
                <ANNOTATION_VALUE>[si] ricorda sa dirmi la differenza tra &lt;l'espulsione&gt; dei gesuiti e &lt;la soppressione&gt; dei gesuiti l'ha capita?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a407">
                <ANNOTATION_VALUE>è un provvedimento l[aico],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a413">
                <ANNOTATION_VALUE>brava, [sì:],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a417">
                <ANNOTATION_VALUE>ricorda l'anno?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a433">
                <ANNOTATION_VALUE>che appartiene proprio al diritto cano[nico] e °appunto° riguarda universalmente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a437">
                <ANNOTATION_VALUE>in verità ci fu un paese in cui i gesuiti non furono soppressi e in cui la bolla pontificia fu congelata,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a441">
                <ANNOTATION_VALUE>[e non] si applico per volontà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a445">
                <ANNOTATION_VALUE>[brava, la] russia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a447">
                <ANNOTATION_VALUE>bene,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a449">
