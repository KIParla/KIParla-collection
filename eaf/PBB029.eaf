                <ANNOTATION_VALUE>no:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1928" ANNOTATION_REF="a1927">
                <ANNOTATION_VALUE>cioè, non mi viene in mente un posto che dico è: il mio preferito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1930" ANNOTATION_REF="a1929">
                <ANNOTATION_VALUE>perché in generale la città, &gt;quando la visito&lt;, mi piace in generale m:h mh c(io)è,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1932" ANNOTATION_REF="a1931">
                <ANNOTATION_VALUE>&gt;un punto fisso&lt; che rimango sempre affascinato dalle due torri, rimango sempre affascinato da san petronio, dal nettuno:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1934" ANNOTATION_REF="a1933">
                <ANNOTATION_VALUE>dalle sette chies~ santo stefano. cioè,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1936" ANNOTATION_REF="a1935">
                <ANNOTATION_VALUE>mi piace c(io)è:, è bella come città, tutta in generale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1938" ANNOTATION_REF="a1937">
                <ANNOTATION_VALUE>amo molto, l'acco~ e:::h la collina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1940" ANNOTATION_REF="a1939">
                <ANNOTATION_VALUE>cioè quindi i [colli],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1946" ANNOTATION_REF="a1945">
                <ANNOTATION_VALUE>quindi vedermi la città dall'alto:, mi affascina sempre tanto. e di solito:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1948" ANNOTATION_REF="a1947">
                <ANNOTATION_VALUE>vado::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1950" ANNOTATION_REF="a1949">
                <ANNOTATION_VALUE>vado sempre a::: san don:~ san donato lì come cavolo si chiama,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1954" ANNOTATION_REF="a1953">
                <ANNOTATION_VALUE>[monte dona]to</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1956" ANNOTATION_REF="a1955">
                <ANNOTATION_VALUE>ecco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1958" ANNOTATION_REF="a1957">
                <ANNOTATION_VALUE>e:h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1962" ANNOTATION_REF="a1961">
                <ANNOTATION_VALUE>[vado sempre lì a mo]nte donato che è uno dei più vicini, però lì::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1964" ANNOTATION_REF="a1963">
                <ANNOTATION_VALUE>mi piace anche molte volte portarci i miei amici, così che magari e:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1966" ANNOTATION_REF="a1965">
                <ANNOTATION_VALUE>anche chi magari conosco che:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1968" ANNOTATION_REF="a1967">
                <ANNOTATION_VALUE>&gt;conosce poco&lt; bologna,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1970" ANNOTATION_REF="a1969">
                <ANNOTATION_VALUE>andarlo a portare [sui] colli:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1974" ANNOTATION_REF="a1973">
                <ANNOTATION_VALUE>quasi prima, di visitare la città,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1976" ANNOTATION_REF="a1975">
                <ANNOTATION_VALUE>c(io)è: vedere bologna dall'alto, fargli vedere:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1978" ANNOTATION_REF="a1977">
                <ANNOTATION_VALUE>tutta là, come si espande la città: da sopra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1980" ANNOTATION_REF="a1979">
                <ANNOTATION_VALUE>mi è sempre piaciuto di più, poi dopo, l'andiamo anche a visitare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1982" ANNOTATION_REF="a1981">
                <ANNOTATION_VALUE>però:, una meta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1984" ANNOTATION_REF="a1983">
                <ANNOTATION_VALUE>in cui &gt;effettivamente adesso che ci penso se devo far vedere qualcuno bologna&lt; [lo porto] sempre sui colli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1988" ANNOTATION_REF="a1987">
                <ANNOTATION_VALUE>e anche solo: farsi la serata lì, un aperitivo lì:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1990" ANNOTATION_REF="a1989">
                <ANNOTATION_VALUE>portarci:, la cena, e cenare:: [su un] telo sui colli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1994" ANNOTATION_REF="a1993">
                <ANNOTATION_VALUE>sempre una cosa che mi piace, fare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1996" ANNOTATION_REF="a1995">
                <ANNOTATION_VALUE>[mhmh]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2002" ANNOTATION_REF="a2001">
                <ANNOTATION_VALUE>[direi] colli, [come forse],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2006" ANNOTATION_REF="a2005">
                <ANNOTATION_VALUE>se devo adesso:, &gt;identificare forse i colli&lt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2010" ANNOTATION_REF="a2009">
                <ANNOTATION_VALUE>[sono la] cosa di bologna che più mi piacciono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2020" ANNOTATION_REF="a2019">
                <ANNOTATION_VALUE>[nie]nte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
