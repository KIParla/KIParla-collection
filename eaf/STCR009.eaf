    <TIER LINGUISTIC_TYPE_REF="ft-sa" TIER_ID="ft@PST087" PARENT_REF="ref@PST087">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>il signor @cosmin ha fatto prima faceva la signora @ecaterina</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a540" ANNOTATION_REF="a539">
                <ANNOTATION_VALUE>ma tipo da dove chiederle semplicemente tipo signora @ecaterina tipo da dove è venuta la vostra passione per il folklore così</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a673" ANNOTATION_REF="a672">
                <ANNOTATION_VALUE>ma guarda che dopo un po' cioè la signora @ecaterina non è una di quelle persone che devi tirarle fuori le parole di bocca</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@PST087" PARENT_REF="ref@PST087">
        <ANNOTATION>
