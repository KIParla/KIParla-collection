        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1447" ANNOTATION_REF="a1446">
                <ANNOTATION_VALUE>quindi::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1451" ANNOTATION_REF="a1450">
