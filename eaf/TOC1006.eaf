        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>vabbè. era interessante (.) questo (.) discorso sulle fonti perché (.) a un estremo abbiamo il dharma la: (.) ciò che viene (.) udito.</ANNOTATION_VALUE>
