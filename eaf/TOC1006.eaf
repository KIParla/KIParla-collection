                <ANNOTATION_VALUE>va bene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>senta, a=e::h mi vuole parlare della (.) concezione del diritto in india.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>sì:. le concezioni, (.) indù diciamo dell'ordine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>((colpi_di_tosse))</ANNOTATION_VALUE>
