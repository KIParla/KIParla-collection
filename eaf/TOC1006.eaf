            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>effettivamente (.) comprendere queste idee di ordine e di strumenti per=e::h mantenere l'ordine della ci~ del=eh dell'india classica, (.) può essere complicato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a285">
