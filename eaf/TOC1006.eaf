            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>come si fa a conoscere quali sono i comportamenti giusti.</ANNOTATION_VALUE>
