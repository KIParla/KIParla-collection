        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>è il pia[ce:re. non è proprio (.) un o]biettivo (.) elevato quanto il [dharma].</ANNOTATION_VALUE>
