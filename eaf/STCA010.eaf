        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>e quindi: scendo soltanto d'inverno quindi: nel periodo di natale</ANNOTATION_VALUE>
            </REF_ANNOTATION>
