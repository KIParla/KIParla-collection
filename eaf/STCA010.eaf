        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>ultimamente durante:: queste vacanze sto: in italia perché devo studiare e lavorare da mio padre</ANNOTATION_VALUE>
