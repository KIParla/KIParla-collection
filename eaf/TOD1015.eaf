        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2076" ANNOTATION_REF="a2075">
                <ANNOTATION_VALUE>valla era pure romano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2078" ANNOTATION_REF="a2077">
                <ANNOTATION_VALUE>ma persona de che? che significa persona? persona in latino significa maschera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2080" ANNOTATION_REF="a2079">
