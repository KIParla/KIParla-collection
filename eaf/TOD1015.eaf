            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3634" ANNOTATION_REF="a3633">
                <ANNOTATION_VALUE>è il discorso religioso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3636" ANNOTATION_REF="a3635">
                <ANNOTATION_VALUE>il discorso religioso,</ANNOTATION_VALUE>
