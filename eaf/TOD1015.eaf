            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2104" ANNOTATION_REF="a2103">
                <ANNOTATION_VALUE>e allora insorge,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2106" ANNOTATION_REF="a2105">
                <ANNOTATION_VALUE>una parte della chiesa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2108" ANNOTATION_REF="a2107">
                <ANNOTATION_VALUE>al concilio di nicea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2110" ANNOTATION_REF="a2109">
                <ANNOTATION_VALUE>trecentoventicinque dopo cristo dovrebbe essere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2112" ANNOTATION_REF="a2111">
                <ANNOTATION_VALUE>al concilio di nicea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2114" ANNOTATION_REF="a2113">
                <ANNOTATION_VALUE>il vescovo atanasio propone il credo. avete presente? credo in solo signo~,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
