        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3718" ANNOTATION_REF="a3717">
                <ANNOTATION_VALUE>secondo che dal datore d'essa ne fu ordinato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3720" ANNOTATION_REF="a3719">
                <ANNOTATION_VALUE>vi sarebbero stati gli stati e le repubbliche cristiane più unite e più felici.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3722" ANNOTATION_REF="a3721">
                <ANNOTATION_VALUE>cioè,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3724" ANNOTATION_REF="a3723">
                <ANNOTATION_VALUE>il discorso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3726" ANNOTATION_REF="a3725">
                <ANNOTATION_VALUE>che noi ritroveremo poi negli eretici, il discorso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3728" ANNOTATION_REF="a3727">
                <ANNOTATION_VALUE>vero,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3730" ANNOTATION_REF="a3729">
                <ANNOTATION_VALUE>del ritornare al cristianesimo delle origini.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3732" ANNOTATION_REF="a3731">
                <ANNOTATION_VALUE>erasmo, lo porterà avanti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3734" ANNOTATION_REF="a3733">
                <ANNOTATION_VALUE>tutti, avevano presente, che la chiesa, era diventata</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3736" ANNOTATION_REF="a3735">
                <ANNOTATION_VALUE>potere, (.) e basta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3738" ANNOTATION_REF="a3737">
                <ANNOTATION_VALUE>potere, gozzoviglie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3740" ANNOTATION_REF="a3739">
                <ANNOTATION_VALUE>i fratacchioni, che si umbria~ si=mbriacavano, facevano sesso, mangiavano, e::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3742" ANNOTATION_REF="a3741">
                <ANNOTATION_VALUE>facevano solo quello, invece di,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3744" ANNOTATION_REF="a3743">
                <ANNOTATION_VALUE>pensare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3746" ANNOTATION_REF="a3745">
                <ANNOTATION_VALUE>alla salute delle anime.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3748" ANNOTATION_REF="a3747">
                <ANNOTATION_VALUE>di queste polemiche, ne è piena, l'italia e l'europa, in quegli anni, fra quattro e cinquecento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3750" ANNOTATION_REF="a3749">
                <ANNOTATION_VALUE>e machiavelli, (.) lo sa perfettamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3752" ANNOTATION_REF="a3751">
                <ANNOTATION_VALUE>e allora comincia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3754" ANNOTATION_REF="a3753">
                <ANNOTATION_VALUE>a circolare, questo discorso, del ritorno alle origini, al cristianesimo delle origini,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3756" ANNOTATION_REF="a3755">
                <ANNOTATION_VALUE>al cristianesimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3758" ANNOTATION_REF="a3757">
                <ANNOTATION_VALUE>che non aveva nessuna ricchezza, in cui tutto era in comune,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3760" ANNOTATION_REF="a3759">
                <ANNOTATION_VALUE>e gli apostoli vivevano così,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3762" ANNOTATION_REF="a3761">
                <ANNOTATION_VALUE>non la chiesa, che è diventata una potenza mondana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3764" ANNOTATION_REF="a3763">
                <ANNOTATION_VALUE>fondata sullo sfarzo, sul lusso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3766" ANNOTATION_REF="a3765">
                <ANNOTATION_VALUE>e allora, dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3768" ANNOTATION_REF="a3767">
                <ANNOTATION_VALUE>e perché molti sono d'opinione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3770" ANNOTATION_REF="a3769">
                <ANNOTATION_VALUE>che il benessere delle città d'italia nasce dalla chiesa romana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3772" ANNOTATION_REF="a3771">
                <ANNOTATION_VALUE>voglia contro essa discorrere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3774" ANNOTATION_REF="a3773">
                <ANNOTATION_VALUE>e ne allegherò due ragioni potentissime.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3776" ANNOTATION_REF="a3775">
                <ANNOTATION_VALUE>la prima è che per gli esempi rei di quella corte, la corte di roma,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3778" ANNOTATION_REF="a3777">
                <ANNOTATION_VALUE>gli esempi rei,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3780" ANNOTATION_REF="a3779">
                <ANNOTATION_VALUE>cioè la corte romana è un esempio di nequizia, è un esempio::, (.) di reità,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3782" ANNOTATION_REF="a3781">
                <ANNOTATION_VALUE>è un esempio:: opposto all'esempio cristiano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3784" ANNOTATION_REF="a3783">
                <ANNOTATION_VALUE>per gli esempi rei di quella corte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3786" ANNOTATION_REF="a3785">
                <ANNOTATION_VALUE>questa provincia, l'italia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3788" ANNOTATION_REF="a3787">
                <ANNOTATION_VALUE>ha perduto ogni religione.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3790" ANNOTATION_REF="a3789">
                <ANNOTATION_VALUE>e poi lucien febvre,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3792" ANNOTATION_REF="a3791">
                <ANNOTATION_VALUE>in un libro famoso, sbagliatissimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3794" ANNOTATION_REF="a3793">
                <ANNOTATION_VALUE>ci verrà a dire che nel cinquecento non era proprio concepibile uscire dal cristianesimo, non era concepibile, non si poteva pensare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3796" ANNOTATION_REF="a3795">
                <ANNOTATION_VALUE>quindi forse un po' un incubo sarà stato, machiave~ chissà come gli è venuto, invece machiavelli lo scrive proprio espressamente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3798" ANNOTATION_REF="a3797">
                <ANNOTATION_VALUE>questa provincia, ha perduto ogni religione, più chiaro di così,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3800" ANNOTATION_REF="a3799">
                <ANNOTATION_VALUE>e secondo febvre non si poteva nemmeno pensare, questo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3802" ANNOTATION_REF="a3801">
                <ANNOTATION_VALUE>nel famoso libro la religion de rabelais, (.) in cui dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3804" ANNOTATION_REF="a3803">
                <ANNOTATION_VALUE>il cinquecento era un secolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3806" ANNOTATION_REF="a3805">
                <ANNOTATION_VALUE>qui veut cro:ire, che vuole credere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3808" ANNOTATION_REF="a3807">
                <ANNOTATION_VALUE>tutto cristiano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3810" ANNOTATION_REF="a3809">
                <ANNOTATION_VALUE>non si può uscire, dalla dimensio~, non è pensab::lie, uscire dalla dimensione della religione.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3812" ANNOTATION_REF="a3811">
                <ANNOTATION_VALUE>poi uno si legge un testo che è stato scritto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3814" ANNOTATION_REF="a3813">
                <ANNOTATION_VALUE>negli anni dieci del cinquecento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3816" ANNOTATION_REF="a3815">
                <ANNOTATION_VALUE>e dice, xx (come=è) che questo l'ha scritto?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3818" ANNOTATION_REF="a3817">
                <ANNOTATION_VALUE>come dice</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3820" ANNOTATION_REF="a3819">
                <ANNOTATION_VALUE>il che si tira dietro infiniti inconvenienti, che siamo senza religione e disordine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3822" ANNOTATION_REF="a3821">
                <ANNOTATION_VALUE>perché così come dov'è religione di presuppone ogni bene,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3824" ANNOTATION_REF="a3823">
                <ANNOTATION_VALUE>dove quella manca, (.) si presuppone il contrario.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3826" ANNOTATION_REF="a3825">
                <ANNOTATION_VALUE>abbiamo dunque, noi italiani,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3828" ANNOTATION_REF="a3827">
                <ANNOTATION_VALUE>con la chiesa e con i preti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3830" ANNOTATION_REF="a3829">
                <ANNOTATION_VALUE>questo primo obbligo, di essere diventati, senza religione, e cattivi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3832" ANNOTATION_REF="a3831">
                <ANNOTATION_VALUE>ma ne abbiamo ancora uno maggiore.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3834" ANNOTATION_REF="a3833">
                <ANNOTATION_VALUE>il quale è la seconda cagione della rovina nostra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3836" ANNOTATION_REF="a3835">
                <ANNOTATION_VALUE>questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3838" ANNOTATION_REF="a3837">
                <ANNOTATION_VALUE>e qua vedete come, (.) sono pochi anni dopo il principe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3840" ANNOTATION_REF="a3839">
                <ANNOTATION_VALUE>questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3842" ANNOTATION_REF="a3841">
                <ANNOTATION_VALUE>è che la chiesa ha tenuto e tiene, questa provincia, l'italia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3844" ANNOTATION_REF="a3843">
                <ANNOTATION_VALUE>divisa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3846" ANNOTATION_REF="a3845">
                <ANNOTATION_VALUE>e ancora lui ce l'ha, presente. è un problema, la divisione dell~, la disunione dell'italia, (.) è un problema gravissimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3848" ANNOTATION_REF="a3847">
                <ANNOTATION_VALUE>lui ci aveva provato, a dire pure pal papa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3850" ANNOTATION_REF="a3849">
                <ANNOTATION_VALUE>piglia 'na bandiera in mano, e vedi che tutta l'italia ti seguirà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3852" ANNOTATION_REF="a3851">
                <ANNOTATION_VALUE>ma il papa non l'ha ascoltato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3854" ANNOTATION_REF="a3853">
                <ANNOTATION_VALUE>e qua gliela fa pagare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3856" ANNOTATION_REF="a3855">
                <ANNOTATION_VALUE>questa chiesa tiene la provincia divisa, e veramente, alcuna provincia, non fu mai unita o felice se non la (viene) tutta all'obbedienza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3858" ANNOTATION_REF="a3857">
                <ANNOTATION_VALUE>di una repubblica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3860" ANNOTATION_REF="a3859">
                <ANNOTATION_VALUE>o d'uno principe, come avvenuto alla francia e alla spagna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3862" ANNOTATION_REF="a3861">
                <ANNOTATION_VALUE>è la cagione che in italia non sia, non sia venuto (.) questo stesso principe o una sola repubblica, è solamente la chiesa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3864" ANNOTATION_REF="a3863">
                <ANNOTATION_VALUE>perché avendovi quell'abitato e tenuto imperio temporale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3866" ANNOTATION_REF="a3865">
                <ANNOTATION_VALUE>non è stata, (.) sì potente e di tanta virtù,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3868" ANNOTATION_REF="a3867">
                <ANNOTATION_VALUE>che l'abbia occupato la tirannide d'italia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3870" ANNOTATION_REF="a3869">
                <ANNOTATION_VALUE>quindi non ha avuto la forza di occupare tutta l'italia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3872" ANNOTATION_REF="a3871">
                <ANNOTATION_VALUE>e d'altra parte non è stata tanto debole, che per paura di perdere il dominio delle sue cose,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3874" ANNOTATION_REF="a3873">
                <ANNOTATION_VALUE>non abbia potuto convocare uno potente che la difenda, contro a quello che in italia fosse diventato troppo potente cioè,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3876" ANNOTATION_REF="a3875">
                <ANNOTATION_VALUE>non essendo dunque stata la chiesa, potente da occupare la italia, né avendo permesso che un altro la occupi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3878" ANNOTATION_REF="a3877">
                <ANNOTATION_VALUE>è stata cagione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3880" ANNOTATION_REF="a3879">
                <ANNOTATION_VALUE>che non è potuta venire sotto un capo. ma è stata sotto più principi e signori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3882" ANNOTATION_REF="a3881">
                <ANNOTATION_VALUE>dai quali è nata tanta disunione e tanta debolezza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3884" ANNOTATION_REF="a3883">
                <ANNOTATION_VALUE>che le sia condotta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3886" ANNOTATION_REF="a3885">
                <ANNOTATION_VALUE>ad essere preda, solame~ non solamente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3888" ANNOTATION_REF="a3887">
                <ANNOTATION_VALUE>dei barbari potenti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3890" ANNOTATION_REF="a3889">
                <ANNOTATION_VALUE>ma di chiunque l'assalta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3892" ANNOTATION_REF="a3891">
                <ANNOTATION_VALUE>di che noi altri italiani, abbiamo obbligo con la chiesa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3894" ANNOTATION_REF="a3893">
                <ANNOTATION_VALUE>e non con altri.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3896" ANNOTATION_REF="a3895">
                <ANNOTATION_VALUE>(nel mille) a inizio del cinquecento, dire una cosa del genere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3898" ANNOTATION_REF="a3897">
                <ANNOTATION_VALUE>però vedete come ancora una volta ritorna, sotto traccia quel discorso dell'unificazione dell'italia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3900" ANNOTATION_REF="a3899">
                <ANNOTATION_VALUE>cioè il problema della chiesa, con gli esempi re:i,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3902" ANNOTATION_REF="a3901">
                <ANNOTATION_VALUE>la chiesa ci ha reso senza religione. quindi gli italiani,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3904" ANNOTATION_REF="a3903">
                <ANNOTATION_VALUE>sono senza religione.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3906" ANNOTATION_REF="a3905">
                <ANNOTATION_VALUE>dice machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3908" ANNOTATION_REF="a3907">
                <ANNOTATION_VALUE>ma soprattutto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3910" ANNOTATION_REF="a3909">
                <ANNOTATION_VALUE>non ha permesso, non è stata tanto potente, da occupare tutta l'italia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3912" ANNOTATION_REF="a3911">
                <ANNOTATION_VALUE>e non è stata abbastanza potente, (però) abbastanza debole, per permettere che qualcun altro, la riunificasse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3914" ANNOTATION_REF="a3913">
                <ANNOTATION_VALUE>e quindi noi con la chiesa, abbiamo quest~ questo, bel, (.) questo be:::l come dire, questo bel debito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3916" ANNOTATION_REF="a3915">
                <ANNOTATION_VALUE>quindi diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3918" ANNOTATION_REF="a3917">
                <ANNOTATION_VALUE>l'interesse, (.) fondamentale, (.) la libertà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3920" ANNOTATION_REF="a3919">
                <ANNOTATION_VALUE>il concetto di civi::le,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3922" ANNOTATION_REF="a3921">
                <ANNOTATION_VALUE>è qualità,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3924" ANNOTATION_REF="a3923">
                <ANNOTATION_VALUE>cioè uguaglianza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3926" ANNOTATION_REF="a3925">
                <ANNOTATION_VALUE>in machiavelli, comincia, già a diffondersi il discorso, non solo della libertà, ma pure dell'uguaglianza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3928" ANNOTATION_REF="a3927">
                <ANNOTATION_VALUE>che anche lì ci sembrano degli anacronismi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3930" ANNOTATION_REF="a3929">
                <ANNOTATION_VALUE>poi vedremo leggendo qualche altro testo del cinquecento, che non so' acronismi, anacronismi per niente, ma è ignoranza di chi studia i secoli seguenti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3932" ANNOTATION_REF="a3931">
                <ANNOTATION_VALUE>che non conosce gli autori rinascimentali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3934" ANNOTATION_REF="a3933">
                <ANNOTATION_VALUE>quando ci dice che gli ideali di libertà e uguaglianza, poi ci vorrà la rivoluzione francese e al massimo l'illuminismo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3936" ANNOTATION_REF="a3935">
                <ANNOTATION_VALUE>machiavelli ci dimostra che non è così.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3938" ANNOTATION_REF="a3937">
                <ANNOTATION_VALUE>e quelle qualità civile, (equalità,)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3940" ANNOTATION_REF="a3939">
                <ANNOTATION_VALUE>l'uguaglianza, come la chiama lui,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3942" ANNOTATION_REF="a3941">
                <ANNOTATION_VALUE>vuole che tenda anche ad una maggiore equlità di sustanze, come la chiama,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3944" ANNOTATION_REF="a3943">
                <ANNOTATION_VALUE>cioè, machiavelli, lancia un'idea, che sarà molto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3946" ANNOTATION_REF="a3945">
                <ANNOTATION_VALUE>molto portata avanti durante la rivoluzione francese,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3948" ANNOTATION_REF="a3947">
                <ANNOTATION_VALUE>cioè, (.) il fatto che,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3950" ANNOTATION_REF="a3949">
                <ANNOTATION_VALUE>l'eccessivo squilibrio di ricchezze,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3952" ANNOTATION_REF="a3951">
                <ANNOTATION_VALUE>fa male alla repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3954" ANNOTATION_REF="a3953">
                <ANNOTATION_VALUE>quando ci sono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3956" ANNOTATION_REF="a3955">
                <ANNOTATION_VALUE>pochi, (.) che hanno quasi tutto, (.) e la stragrande maggioranza, (.) che non hanno quasi niente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3958" ANNOTATION_REF="a3957">
                <ANNOTATION_VALUE>la repubblica va in rovina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3960" ANNOTATION_REF="a3959">
                <ANNOTATION_VALUE>prima v'ho citato la rivoluzione francese, ma pensate a quel movimento di pochi anni fa, occupò wall street,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3962" ANNOTATION_REF="a3961">
                <ANNOTATION_VALUE>siamo il novantanove per cento, contro l'uno per cento che detiene la ricchezza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3964" ANNOTATION_REF="a3963">
                <ANNOTATION_VALUE>il concetto, (.) è identico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3966" ANNOTATION_REF="a3965">
                <ANNOTATION_VALUE>è il concetto di machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3968" ANNOTATION_REF="a3967">
                <ANNOTATION_VALUE>che porteranno avanti tanti altri dopo di lui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3970" ANNOTATION_REF="a3969">
                <ANNOTATION_VALUE>bisogna livellare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3972" ANNOTATION_REF="a3971">
                <ANNOTATION_VALUE>è la repubblica, è lo stato, che deve essere ricco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3974" ANNOTATION_REF="a3973">
                <ANNOTATION_VALUE>non i singoli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3976" ANNOTATION_REF="a3975">
                <ANNOTATION_VALUE>(ciò) non vuol dire fare un machiavelli comunista, sia chiaro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3978" ANNOTATION_REF="a3977">
                <ANNOTATION_VALUE>machiavelli non ci pensa proprio, e né mai dà vagamente:::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3980" ANNOTATION_REF="a3979">
                <ANNOTATION_VALUE>infatti, (.) neanche, i grandi interpreti marxisti di machiavelli, hanno mai sostenuto una cosa del genere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3982" ANNOTATION_REF="a3981">
                <ANNOTATION_VALUE>però è estremamente significativo questo riferimento all'uguaglianza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3984" ANNOTATION_REF="a3983">
                <ANNOTATION_VALUE>che vuole, anche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3986" ANNOTATION_REF="a3985">
                <ANNOTATION_VALUE>ci sia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3988" ANNOTATION_REF="a3987">
                <ANNOTATION_VALUE>sul piano economico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3990" ANNOTATION_REF="a3989">
                <ANNOTATION_VALUE>non perché tutti dobbiamo avere lo stesso, ma non ci deve essere l'eccessivo squilibrio di ricchezze.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3992" ANNOTATION_REF="a3991">
                <ANNOTATION_VALUE>come oggi, (.) esattamente come oggi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3994" ANNOTATION_REF="a3993">
                <ANNOTATION_VALUE>e, (.) diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3996" ANNOTATION_REF="a3995">
                <ANNOTATION_VALUE>tutto questo discorso, machiavelli lo fa, per portare avanti il soggetto politico che più gli sta a cuore,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3998" ANNOTATION_REF="a3997">
                <ANNOTATION_VALUE>e cioè, (.) quella moltitudine che citavamo prima,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4000" ANNOTATION_REF="a3999">
                <ANNOTATION_VALUE>il popolo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4002" ANNOTATION_REF="a4001">
                <ANNOTATION_VALUE>è il popolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4004" ANNOTATION_REF="a4003">
                <ANNOTATION_VALUE>che per machiavelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4006" ANNOTATION_REF="a4005">
                <ANNOTATION_VALUE>è, (.) dev'essere a guardia della libertà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4008" ANNOTATION_REF="a4007">
                <ANNOTATION_VALUE>e dev'essere, (.) il cardine, della repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4010" ANNOTATION_REF="a4009">
                <ANNOTATION_VALUE>senza dubbio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4012" ANNOTATION_REF="a4011">
                <ANNOTATION_VALUE>se si considererà il x, machiavelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4014" ANNOTATION_REF="a4013">
                <ANNOTATION_VALUE>se si considererà il fine dei nobili, e degli ignobili,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4016" ANNOTATION_REF="a4015">
                <ANNOTATION_VALUE>si vedrà in quelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4018" ANNOTATION_REF="a4017">
                <ANNOTATION_VALUE>i nobili, desiderio grande di dominare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4020" ANNOTATION_REF="a4019">
                <ANNOTATION_VALUE>ed in questi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4022" ANNOTATION_REF="a4021">
                <ANNOTATION_VALUE>solo desiderio di non essere dominati, e per conseguente maggiore volontà, di vivere, (.) liberi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4024" ANNOTATION_REF="a4023">
                <ANNOTATION_VALUE>e anche, (.) quando,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4026" ANNOTATION_REF="a4025">
                <ANNOTATION_VALUE>parla del principato stesso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4028" ANNOTATION_REF="a4027">
                <ANNOTATION_VALUE>machiavelli, nel principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4030" ANNOTATION_REF="a4029">
                <ANNOTATION_VALUE>gli dice al principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4032" ANNOTATION_REF="a4031">
                <ANNOTATION_VALUE>ti devi fondare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4034" ANNOTATION_REF="a4033">
                <ANNOTATION_VALUE>sull'appoggio degli aristocratici, dei grandi, di quei pochi che tengono la ricchezza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4036" ANNOTATION_REF="a4035">
                <ANNOTATION_VALUE>o del popolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4038" ANNOTATION_REF="a4037">
                <ANNOTATION_VALUE>dico che si ascende a questo principato, o con il favore del popolo, o con quello dei grandi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4040" ANNOTATION_REF="a4039">
                <ANNOTATION_VALUE>perché in ogni città si trovano questi due umori diversi, queste due classi sociali diciamo, x nasce da questo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4042" ANNOTATION_REF="a4041">
                <ANNOTATION_VALUE>che il popolo desidera non essere comandato né oppresso da grandi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4044" ANNOTATION_REF="a4043">
                <ANNOTATION_VALUE>e i grandi desiderano comandare e opprimere il popolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4046" ANNOTATION_REF="a4045">
                <ANNOTATION_VALUE>vedete questa frase è molto simile a quella che avevo letto prima,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4048" ANNOTATION_REF="a4047">
                <ANNOTATION_VALUE>qui c'è il principe, prima c'erano i discorsi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4050" ANNOTATION_REF="a4049">
                <ANNOTATION_VALUE>cioè c'è, (.) una intima coerenza di machiavelli che spesso viene considerato contraddittorio, ma se lo si legge bene non è.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4052" ANNOTATION_REF="a4051">
                <ANNOTATION_VALUE>e allora colui che viene al principato con l'aiuto dei grandi, dell'aristocrazia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4054" ANNOTATION_REF="a4053">
                <ANNOTATION_VALUE>si mantiene con più difficoltà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4056" ANNOTATION_REF="a4055">
                <ANNOTATION_VALUE>che quello che lo diventa con l'aiuto del popolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4058" ANNOTATION_REF="a4057">
                <ANNOTATION_VALUE>perché quello del popolo è più onesto fine, che quello dei grandi. di nuovo, volendo questi opprimere, e quello non essere oppresso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4060" ANNOTATION_REF="a4059">
                <ANNOTATION_VALUE>del popolo inimico, uno principe, non si può mai assicurare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4062" ANNOTATION_REF="a4061">
                <ANNOTATION_VALUE>per essere troppi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4064" ANNOTATION_REF="a4063">
                <ANNOTATION_VALUE>dei grandi si può assicurare, per essere pochi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4066" ANNOTATION_REF="a4065">
                <ANNOTATION_VALUE>debbe per tanto, uno che diventi principe, mediante il favore del popolo, mantenerselo, (.) amico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4068" ANNOTATION_REF="a4067">
                <ANNOTATION_VALUE>il che gli sia facile</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4070" ANNOTATION_REF="a4069">
                <ANNOTATION_VALUE>non domandando lui, se non, di essere, di non essere, oppresso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4072" ANNOTATION_REF="a4071">
                <ANNOTATION_VALUE>quindi diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4074" ANNOTATION_REF="a4073">
                <ANNOTATION_VALUE>popolo, supremazia della legge,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4076" ANNOTATION_REF="a4075">
                <ANNOTATION_VALUE>repubblica, libertà, equalità, conflitto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4078" ANNOTATION_REF="a4077">
                <ANNOTATION_VALUE>religione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4080" ANNOTATION_REF="a4079">
                <ANNOTATION_VALUE>critica della religione cristiana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4082" ANNOTATION_REF="a4081">
                <ANNOTATION_VALUE>ma, (.) necessità politica della religione, questi sono tutti (.) ideali, diciamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4084" ANNOTATION_REF="a4083">
                <ANNOTATION_VALUE>critica della feudalità,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4086" ANNOTATION_REF="a4085">
                <ANNOTATION_VALUE>critica dell'aristocrazia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4088" ANNOTATION_REF="a4087">
                <ANNOTATION_VALUE>critica dell'ereditarietà delle cariche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4090" ANNOTATION_REF="a4089">
                <ANNOTATION_VALUE>analisi realistica, questi sono tutti elementi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4092" ANNOTATION_REF="a4091">
                <ANNOTATION_VALUE>che al di là delle critiche, (.) che si faranno a machiavelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4094" ANNOTATION_REF="a4093">
                <ANNOTATION_VALUE>molto spesso inventate, ieri vi acccennavo a capannella,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4096" ANNOTATION_REF="a4095">
                <ANNOTATION_VALUE>che si inventava un machiavelli inesistente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4098" ANNOTATION_REF="a4097">
                <ANNOTATION_VALUE>ma già diciamo in altri testi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4100" ANNOTATION_REF="a4099">
                <ANNOTATION_VALUE>e così, un famosissimo testo francese, il contre-machiavel,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4102" ANNOTATION_REF="a4101">
                <ANNOTATION_VALUE>è fondato, (.) cioè, sembra dice, ma questo l'ha letto machiavelli?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4104" ANNOTATION_REF="a4103">
                <ANNOTATION_VALUE>ma forse non l'ha letto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4106" ANNOTATION_REF="a4105">
                <ANNOTATION_VALUE>no erano, (.) istanze polemiche, che bisognava portare avanti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4108" ANNOTATION_REF="a4107">
                <ANNOTATION_VALUE>a un certo punto in francia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4110" ANNOTATION_REF="a4109">
                <ANNOTATION_VALUE>strozzi c'aveva mezzo debito pubblico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4112" ANNOTATION_REF="a4111">
                <ANNOTATION_VALUE>la regina, la reggente, era una de medici, e i francesi a un certo punto, hanno pensato, dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4114" ANNOTATION_REF="a4113">
                <ANNOTATION_VALUE>qua è venuto machiavelli che ci sta governando,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4116" ANNOTATION_REF="a4115">
                <ANNOTATION_VALUE>e allora hanno cominciato anche in francia, e quindi dall'italia si è diffusa anche in francia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4118" ANNOTATION_REF="a4117">
                <ANNOTATION_VALUE>questa immagine deteriore, demoniaca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4120" ANNOTATION_REF="a4119">
                <ANNOTATION_VALUE>completamente inventata,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4122" ANNOTATION_REF="a4121">
                <ANNOTATION_VALUE>del machiavelli, subdolo, cinico, indagato~ xxx, ingannatore, il machiavelli, machiavellico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4124" ANNOTATION_REF="a4123">
                <ANNOTATION_VALUE>che è un'immagine polemica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4126" ANNOTATION_REF="a4125">
                <ANNOTATION_VALUE>che nulla ha a che fare, (.) con machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4128" ANNOTATION_REF="a4127">
                <ANNOTATION_VALUE>un grande, grandissimo, personaggio, e soprattutto un grande pensatore della, (.) libertà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4130" ANNOTATION_REF="a4129">
                <ANNOTATION_VALUE>grazie. ci fermiamo qui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4132" ANNOTATION_REF="a4131">
                <ANNOTATION_VALUE>se ci sono::: ovviamente::::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4134" ANNOTATION_REF="a4133">
                <ANNOTATION_VALUE>richieste di charimenti, (.) ditemi pure diciamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4136" ANNOTATION_REF="a4135">
                <ANNOTATION_VALUE>vi è tutto chiaro:::?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
