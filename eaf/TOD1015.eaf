            <REF_ANNOTATION ANNOTATION_ID="a2970" ANNOTATION_REF="a2969">
                <ANNOTATION_VALUE>che va a combattere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2972" ANNOTATION_REF="a2971">
                <ANNOTATION_VALUE>per difendere se stesso, per difendere i propri cari, per difendere la propria patria.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2974" ANNOTATION_REF="a2973">
                <ANNOTATION_VALUE>non perché viene pagato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2976" ANNOTATION_REF="a2975">
                <ANNOTATION_VALUE>e questo è un problema,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2978" ANNOTATION_REF="a2977">
                <ANNOTATION_VALUE>che immediatamente diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2980" ANNOTATION_REF="a2979">
                <ANNOTATION_VALUE>gli aristocratici fiorentini colgono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2982" ANNOTATION_REF="a2981">
                <ANNOTATION_VALUE>da lì comincia l'antimachiavellismo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2984" ANNOTATION_REF="a2983">
                <ANNOTATION_VALUE>la repubblica era retta da un gonf~ gonfaloniere, si chiamava come se fosse un presidente della repubblica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2986" ANNOTATION_REF="a2985">
                <ANNOTATION_VALUE>di cui machiavelli era segretario, e allora gli aristocratici cominciano a dire, machiavelli si vuole fare mannerino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2988" ANNOTATION_REF="a2987">
                <ANNOTATION_VALUE>(mandarino), no il mandarino cinese. (di soderini) che vuole prendere l'impero, vuole prendere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2990" ANNOTATION_REF="a2989">
                <ANNOTATION_VALUE>cominciano a diffondere voci false, noi queste cose le sappiamo perché so' documentate non è che lo riteniamo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2992" ANNOTATION_REF="a2991">
                <ANNOTATION_VALUE>voci false.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2994" ANNOTATION_REF="a2993">
                <ANNOTATION_VALUE>su machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2996" ANNOTATION_REF="a2995">
                <ANNOTATION_VALUE>già quando egli è in vita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2998" ANNOTATION_REF="a2997">
                <ANNOTATION_VALUE>che alimentano, l'antimachiavellismo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3000" ANNOTATION_REF="a2999">
                <ANNOTATION_VALUE>che comincia a diffondersi in maniera sempre più pesante durante il cinquecento, quando poi dopo la sua morte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3002" ANNOTATION_REF="a3001">
                <ANNOTATION_VALUE>dopo la sua morte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3004" ANNOTATION_REF="a3003">
                <ANNOTATION_VALUE>escono il principe, e i discorsi sopra la prima deca di tito livio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3006" ANNOTATION_REF="a3005">
                <ANNOTATION_VALUE>che lui non pubblicherà mai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3008" ANNOTATION_REF="a3007">
                <ANNOTATION_VALUE>l'unico testo famoso di machiavelli pubblicato in vita, è l'arte della guerra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3010" ANNOTATION_REF="a3009">
                <ANNOTATION_VALUE>della guerra, in cui appunto porta avanti questa sua idea delle armi proprie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3012" ANNOTATION_REF="a3011">
                <ANNOTATION_VALUE>del cittadino soldato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3014" ANNOTATION_REF="a3013">
                <ANNOTATION_VALUE>contro, contro, gli eserciti dei mercenari.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3016" ANNOTATION_REF="a3015">
                <ANNOTATION_VALUE>uscito dalla repubblica, machiavelli cerca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3018" ANNOTATION_REF="a3017">
                <ANNOTATION_VALUE>di, (.) diciamo ingraziarsi, il favore dei medici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3020" ANNOTATION_REF="a3019">
                <ANNOTATION_VALUE>tornati, (.) a firenze.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3022" ANNOTATION_REF="a3021">
                <ANNOTATION_VALUE>cerca di ingraziarselo perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3024" ANNOTATION_REF="a3023">
                <ANNOTATION_VALUE>lui va in esilio, appena finisce la repubblica viene mandato in esilio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3026" ANNOTATION_REF="a3025">
                <ANNOTATION_VALUE>ci sono delle lettere sue meravigliose,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3028" ANNOTATION_REF="a3027">
                <ANNOTATION_VALUE>l'unica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3030" ANNOTATION_REF="a3029">
                <ANNOTATION_VALUE>l'unica:::, come dire, consolazione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3032" ANNOTATION_REF="a3031">
                <ANNOTATION_VALUE>c'è una lettera meravigliosa, su questo, sono le lettu:re:, dice, la sera, quando finalmente torna a casa, mi metto abiti puriali, ed entro nelle (antique) corti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3034" ANNOTATION_REF="a3033">
                <ANNOTATION_VALUE>e loro m'(accolgono, ed io mi pasco di quel cibo che solum è mio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3036" ANNOTATION_REF="a3035">
                <ANNOTATION_VALUE>cioè ci mostra come lo studio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3038" ANNOTATION_REF="a3037">
                <ANNOTATION_VALUE>lo studio possa essere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3040" ANNOTATION_REF="a3039">
                <ANNOTATION_VALUE>un balsamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3042" ANNOTATION_REF="a3041">
                <ANNOTATION_VALUE>risanatore di tanti mali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3044" ANNOTATION_REF="a3043">
                <ANNOTATION_VALUE>dell'animo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3046" ANNOTATION_REF="a3045">
                <ANNOTATION_VALUE>però, lui è un uomo d'azione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3048" ANNOTATION_REF="a3047">
                <ANNOTATION_VALUE>non ce la fa, e quindi vorrebbe cercare insomma,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3050" ANNOTATION_REF="a3049">
                <ANNOTATION_VALUE>in qualche modo di lavorare, e a un certo punto gli viene st'idea folle,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3052" ANNOTATION_REF="a3051">
                <ANNOTATION_VALUE>ci spiega, perché diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3054" ANNOTATION_REF="a3053">
                <ANNOTATION_VALUE>partiamo da una premessa, così siamo chiari, machiavelli, era un repubblicano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3056" ANNOTATION_REF="a3055">
                <ANNOTATION_VALUE>machiavelli voleva, (.) la repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3058" ANNOTATION_REF="a3057">
                <ANNOTATION_VALUE>e allora cerchiam~ ma il principe l'ha scritto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3060" ANNOTATION_REF="a3059">
                <ANNOTATION_VALUE>cerchiamo di capire meglio perché ha scritto il principe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3062" ANNOTATION_REF="a3061">
                <ANNOTATION_VALUE>il principe, (.) è un'opera, (.) veramente d'occasione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3064" ANNOTATION_REF="a3063">
                <ANNOTATION_VALUE>è un'opera d'occasione perché, (.) come lui racconta nella famosa lettera cui vi accennavo adesso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3066" ANNOTATION_REF="a3065">
                <ANNOTATION_VALUE>famosa lettera in cui, parla della composizione del principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3068" ANNOTATION_REF="a3067">
                <ANNOTATION_VALUE>è un libro d'occasione perché lui come scriveva a un amico dice guarda, mi facessero pure xxx (un sasso)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3070" ANNOTATION_REF="a3069">
                <ANNOTATION_VALUE>questi signori medici, fatemi fare qualche cosa che non ce la faccio più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3072" ANNOTATION_REF="a3071">
                <ANNOTATION_VALUE>a giocare a tric e trac e ad altre scemenze tutta la giornata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3074" ANNOTATION_REF="a3073">
                <ANNOTATION_VALUE>per le campagne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3076" ANNOTATION_REF="a3075">
                <ANNOTATION_VALUE>quindi diciamo, c'è, un aspetto fra virgolette, un poco cortigianesco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3078" ANNOTATION_REF="a3077">
                <ANNOTATION_VALUE>se vogliamo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3080" ANNOTATION_REF="a3079">
                <ANNOTATION_VALUE>non a caso, (.) i medici non gli faranno fa' quasi niente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3082" ANNOTATION_REF="a3081">
                <ANNOTATION_VALUE>però quando ri~ (.) risarà di nuovo proclamata la repubblica, nel millecinquecentoventisette, con la scacciata dei medici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3084" ANNOTATION_REF="a3083">
                <ANNOTATION_VALUE>i fiorentini non lo vorranno a machiavelli, (.) e machiavelli ci morirà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3086" ANNOTATION_REF="a3085">
                <ANNOTATION_VALUE>non lo vorranno come di nuovo segretario della repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3088" ANNOTATION_REF="a3087">
                <ANNOTATION_VALUE>perché dice ma tu, sei un poco, coi medici (ci hai un po' ciurlato nel manico), e mo ti freghi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3090" ANNOTATION_REF="a3089">
                <ANNOTATION_VALUE>e quindi diciamo non tornerà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3092" ANNOTATION_REF="a3091">
                <ANNOTATION_VALUE>però questo tentativo, non è tanto un tentativo di tipo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3094" ANNOTATION_REF="a3093">
                <ANNOTATION_VALUE>cortigianesco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3096" ANNOTATION_REF="a3095">
                <ANNOTATION_VALUE>il tentativo è (u)n' idea pazza che gli viene, perché a un certo punto, lui si rende conto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3098" ANNOTATION_REF="a3097">
                <ANNOTATION_VALUE>che forse ci sono delle condizioni, (.) oggettive,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3100" ANNOTATION_REF="a3099">
                <ANNOTATION_VALUE>che permettono un ideale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3102" ANNOTATION_REF="a3101">
                <ANNOTATION_VALUE>qual è l'idea?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3104" ANNOTATION_REF="a3103">
                <ANNOTATION_VALUE>come ci ha spiegato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3106" ANNOTATION_REF="a3105">
                <ANNOTATION_VALUE>xxxx xxx xxx xxx</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3108" ANNOTATION_REF="a3107">
                <ANNOTATION_VALUE>a un certo punto, mo machiavelli è un uomo, dopo vi leggerò un paio di passi. comunque contro la chiesa, e:hm ma di una violenza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3110" ANNOTATION_REF="a3109">
                <ANNOTATION_VALUE>inaudita,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3112" ANNOTATION_REF="a3111">
                <ANNOTATION_VALUE>a un certo punto, nel capitolo undicesimo del principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3114" ANNOTATION_REF="a3113">
                <ANNOTATION_VALUE>lui parla dei cosiddetti principati ecclesiastici. cioè appunto in primo luogo, lo stato della chiesa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3116" ANNOTATION_REF="a3115">
                <ANNOTATION_VALUE>e dice sono gli unici a essere felici.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3118" ANNOTATION_REF="a3117">
                <ANNOTATION_VALUE>dice ma com'è possibile sta cosa?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3120" ANNOTATION_REF="a3119">
                <ANNOTATION_VALUE>allora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3122" ANNOTATION_REF="a3121">
                <ANNOTATION_VALUE>facendo tutta una serie di legami, xxx xxx si è reso conto, che si è vero, lo pensava quello. perché lo pensava? che succede?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3124" ANNOTATION_REF="a3123">
                <ANNOTATION_VALUE>nel dodici mi pare, sale al soglio pontificio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3126" ANNOTATION_REF="a3125">
                <ANNOTATION_VALUE>un de medici, giovanni de medici, che diventa leone decimo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3128" ANNOTATION_REF="a3127">
                <ANNOTATION_VALUE>nel momento in cui,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3130" ANNOTATION_REF="a3129">
                <ANNOTATION_VALUE>i medici rientrano a firenze,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3132" ANNOTATION_REF="a3131">
                <ANNOTATION_VALUE>avviene,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3134" ANNOTATION_REF="a3133">
                <ANNOTATION_VALUE>una, diciamo, (.) congiuntura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3136" ANNOTATION_REF="a3135">
                <ANNOTATION_VALUE>molto particolare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3138" ANNOTATION_REF="a3137">
                <ANNOTATION_VALUE>cioè,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3140" ANNOTATION_REF="a3139">
                <ANNOTATION_VALUE>tutto il centro italia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3142" ANNOTATION_REF="a3141">
                <ANNOTATION_VALUE>sotto le mani di una dinastia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3144" ANNOTATION_REF="a3143">
                <ANNOTATION_VALUE>se noi usiamo, uniamo, (.) la toscana, (.) medicea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3146" ANNOTATION_REF="a3145">
                <ANNOTATION_VALUE>con lo stato pontificio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3148" ANNOTATION_REF="a3147">
                <ANNOTATION_VALUE>che prendeva le marche, la romagna, il lazio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3150" ANNOTATION_REF="a3149">
                <ANNOTATION_VALUE>diventava, (.) un enorme,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3152" ANNOTATION_REF="a3151">
                <ANNOTATION_VALUE>avete presente, all'epoca l'italia era divisa in tanti stati insomma,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
