            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2236" ANNOTATION_REF="a2235">
                <ANNOTATION_VALUE>invenzione ottocentesca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2238" ANNOTATION_REF="a2237">
                <ANNOTATION_VALUE>machiavelli non ha MAI scritto, il fine giustifica i mezzi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2240" ANNOTATION_REF="a2239">
                <ANNOTATION_VALUE>c'è una locuzione, nel capitolo diciotto del principe che vagamente,</ANNOTATION_VALUE>
