        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3696" ANNOTATION_REF="a3695">
                <ANNOTATION_VALUE>pe:erché:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3698" ANNOTATION_REF="a3697">
                <ANNOTATION_VALUE>rende gli uomini più ubbidienti,</ANNOTATION_VALUE>
