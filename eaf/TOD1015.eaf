            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1072" ANNOTATION_REF="a1071">
                <ANNOTATION_VALUE>era tutto quel percorso della pittura italiana che era iniziato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1074" ANNOTATION_REF="a1073">
                <ANNOTATION_VALUE>come ci spiegò già vasari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1076" ANNOTATION_REF="a1075">
                <ANNOTATION_VALUE>cioè ne avevano già cognizione nel cinquecento gli stessi umanisti di questo fenomeno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1078" ANNOTATION_REF="a1077">
