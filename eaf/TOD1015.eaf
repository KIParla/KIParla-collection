        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a429">
                <ANNOTATION_VALUE>vi leggo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a431">
                <ANNOTATION_VALUE>il genere umano, per uscire dalla barbarie, ebbe bisogno di una di quelle rivoluzioni che rinnovano completamente la faccia della terra. ((legge))</ANNOTATION_VALUE>
