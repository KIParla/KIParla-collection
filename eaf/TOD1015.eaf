            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a576" ANNOTATION_REF="a575">
                <ANNOTATION_VALUE>diciamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a578" ANNOTATION_REF="a577">
                <ANNOTATION_VALUE>un mondo nuovo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a580" ANNOTATION_REF="a579">
                <ANNOTATION_VALUE>l'inizio del mondo nuovo che porterà, all'emergere delle arti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a582" ANNOTATION_REF="a581">
                <ANNOTATION_VALUE>della scultura, della pittura::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a584" ANNOTATION_REF="a583">
                <ANNOTATION_VALUE>e tutte le grandi glorie::, (.) glorie del rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a586" ANNOTATION_REF="a585">
                <ANNOTATION_VALUE>non solo le arti, perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a588" ANNOTATION_REF="a587">
                <ANNOTATION_VALUE>poi dopo ci accenno e però ci ritornerò poi in un'altra lezione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a590" ANNOTATION_REF="a589">
                <ANNOTATION_VALUE>il rinascimento è molto importante anche per aver dato il via, diciamo la premessa a quella che sarà poi la rivoluzione scientifica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a592" ANNOTATION_REF="a591">
                <ANNOTATION_VALUE>anche questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a594" ANNOTATION_REF="a593">
                <ANNOTATION_VALUE>scusate, però sta nel rinascimento nella testa dei francesi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a596" ANNOTATION_REF="a595">
                <ANNOTATION_VALUE>anche questo ci riconoscono nel senso che galileo, giordano bruno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a598" ANNOTATION_REF="a597">
                <ANNOTATION_VALUE>so' perso~, loro che sono veramente (.) chiusi al loro interno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a600" ANNOTATION_REF="a599">
                <ANNOTATION_VALUE>e per leggersi un'opera che non sia francese ce ne vuo:le:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a602" ANNOTATION_REF="a601">
                <ANNOTATION_VALUE>qua hanno a che fa' con galileo, con giordano bruno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a604" ANNOTATION_REF="a603">
                <ANNOTATION_VALUE>quantomeno, continuano in quel riconoscere la grandezza del nostro rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a606" ANNOTATION_REF="a605">
                <ANNOTATION_VALUE>continuano a riconoscere la nostra grandezza, anche su quel piano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a608" ANNOTATION_REF="a607">
                <ANNOTATION_VALUE>perché uno dei caratteri fondamentali del rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a610" ANNOTATION_REF="a609">
                <ANNOTATION_VALUE>è proprio lo studio della natura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a612" ANNOTATION_REF="a611">
                <ANNOTATION_VALUE>cioè</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a614" ANNOTATION_REF="a613">
                <ANNOTATION_VALUE>nella mondanizzazione, nello scendere da::, quel mondo popolato da spiriti, spiritelli, demoni, e quant'altro, che era il medioevo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a616" ANNOTATION_REF="a615">
                <ANNOTATION_VALUE>col rinascimento si ritorna sulla terra in quache modo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a618" ANNOTATION_REF="a617">
                <ANNOTATION_VALUE>quel ritorno sulla terra noi lo vediamo per esempio nella pittura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a620" ANNOTATION_REF="a619">
                <ANNOTATION_VALUE>la pittura diciamo, già nella nascita della prospettiva,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a622" ANNOTATION_REF="a621">
                <ANNOTATION_VALUE>noi vediamo come la realtà sia in modo più efficace ritratta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a624" ANNOTATION_REF="a623">
                <ANNOTATION_VALUE>e questo diciamo anche proprio nelle forme, al di là della prospettiva,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a626" ANNOTATION_REF="a625">
                <ANNOTATION_VALUE>se noi facciamo un paragone con la pittura bizantina,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a628" ANNOTATION_REF="a627">
                <ANNOTATION_VALUE>quegli umu:ncoli, come li chiamava vasari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a630" ANNOTATION_REF="a629">
                <ANNOTATION_VALUE>gli omiccini, senza prospettiva, senza nessuna, (.) realtà::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a632" ANNOTATION_REF="a631">
                <ANNOTATION_VALUE>e la confrontiamo co' un quadro di michelangelo, il quadro di michelangelo ci pare una cosa reale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a634" ANNOTATION_REF="a633">
                <ANNOTATION_VALUE>con tutti quei fasci di muscoli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a636" ANNOTATION_REF="a635">
                <ANNOTATION_VALUE>quella, quella realtà che prorompe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a637">
                <ANNOTATION_VALUE>quella realtà naturale che prevede anche degli studi anatomici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a640" ANNOTATION_REF="a639">
                <ANNOTATION_VALUE>cioè, anche qui, i fenomeni sono sempre intrecciati,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a642" ANNOTATION_REF="a641">
                <ANNOTATION_VALUE>e allora, lo studio, della pittura, porta anche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a644" ANNOTATION_REF="a643">
                <ANNOTATION_VALUE>e della scultura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a645">
                <ANNOTATION_VALUE>porta anche ad uno studio dell'anatomia umana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a648" ANNOTATION_REF="a647">
                <ANNOTATION_VALUE>non a caso il cinquecento, il rinascimento è l'epoca del grande anatomista andrea vesalio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a650" ANNOTATION_REF="a649">
                <ANNOTATION_VALUE>che comincia diciamo a fare le dissezioni,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a651">
                <ANNOTATION_VALUE>le le le l~ le autopsi::e::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a654" ANNOTATION_REF="a653">
                <ANNOTATION_VALUE>come diremmo oggi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a655">
                <ANNOTATION_VALUE>per cominciare a capire come è realmente formato il corpo umano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a658" ANNOTATION_REF="a657">
                <ANNOTATION_VALUE>in quell'epoca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a660" ANNOTATION_REF="a659">
                <ANNOTATION_VALUE>ci ritornerò,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a661">
                <ANNOTATION_VALUE>un grande eretico, (.) che sarà condannato a morte, serveto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a664" ANNOTATION_REF="a663">
                <ANNOTATION_VALUE>e=e::::h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a666" ANNOTATION_REF="a665">
                <ANNOTATION_VALUE>a un certo punto, intuisce la circolazione del sangue,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a668" ANNOTATION_REF="a667">
                <ANNOTATION_VALUE>cioè c'è tutto anche un filone appunto naturalistico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a670" ANNOTATION_REF="a669">
                <ANNOTATION_VALUE>nel rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a672" ANNOTATION_REF="a671">
                <ANNOTATION_VALUE>che è legato al discorso generale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a674" ANNOTATION_REF="a673">
                <ANNOTATION_VALUE>quindi lo vediamo nella pittura, nella scultura eccetera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a676" ANNOTATION_REF="a675">
                <ANNOTATION_VALUE>ma diventa vera e propria filosofia naturale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a678" ANNOTATION_REF="a677">
                <ANNOTATION_VALUE>diventa ricerca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a680" ANNOTATION_REF="a679">
                <ANNOTATION_VALUE>di come dirà poi bernardino telesio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a682" ANNOTATION_REF="a681">
                <ANNOTATION_VALUE>della natura iuxta propria principia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a684" ANNOTATION_REF="a683">
                <ANNOTATION_VALUE>la natura va studiata per se stessa, in sé</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a686" ANNOTATION_REF="a685">
                <ANNOTATION_VALUE>analizzando una formica, analizzando un filo d'erba, un albero,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a688" ANNOTATION_REF="a687">
                <ANNOTATION_VALUE>non analizzando quello che dice dio o quello che dice aristotele sulla natura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a690" ANNOTATION_REF="a689">
                <ANNOTATION_VALUE>la natura va studiata per sé stessa. e questa la premessa necessaria per l'indagine scientifica</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a692" ANNOTATION_REF="a691">
                <ANNOTATION_VALUE>se non ci fosse stato prima quello,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a693">
                <ANNOTATION_VALUE>a galileo, di pigliare e costruirsi il suo telescopio, di puntarlo verso il cielo e scoprire i satelliti di giove,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a696" ANNOTATION_REF="a695">
                <ANNOTATION_VALUE>non gli sarebbe venuto proprio in mente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a698" ANNOTATION_REF="a697">
                <ANNOTATION_VALUE>probabilmente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a699">
                <ANNOTATION_VALUE>ma alle spalle, galileo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a702" ANNOTATION_REF="a701">
                <ANNOTATION_VALUE>e tutta la generazione seicentesca della rivoluzione scientifica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a704" ANNOTATION_REF="a703">
                <ANNOTATION_VALUE>c'aveva la filosofia naturale del rinascimento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a706" ANNOTATION_REF="a705">
                <ANNOTATION_VALUE>lo studio della natura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a708" ANNOTATION_REF="a707">
                <ANNOTATION_VALUE>ora, francis bacon, grandissimo autore molto amato dagli illuministi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a710" ANNOTATION_REF="a709">
                <ANNOTATION_VALUE>dirà che queste erano, filosofie pastorali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a712" ANNOTATION_REF="a711">
                <ANNOTATION_VALUE>dirà che per esempio telesio, era stato molto più bravo nel distruggere, quello che c'era prima che nel costruire</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a714" ANNOTATION_REF="a713">
                <ANNOTATION_VALUE>dirà che si erano rifatti agli autori antichi, e anche qui vediamo il rinascimento però.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a716" ANNOTATION_REF="a715">
                <ANNOTATION_VALUE>nel riproporre lucrezio, nel riproporre democrito, nel riproporre parmenide, nel riproporre tutta una serie di autori presocratici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a718" ANNOTATION_REF="a717">
                <ANNOTATION_VALUE>gli umanisti, i protagonisti del rinascimento, si sottraggono alla dittatura come era di aritstotele,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a720" ANNOTATION_REF="a719">
                <ANNOTATION_VALUE>e trovano dei modi, alternativi di vedere il mondo, che sono più aderenti alla natura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a722" ANNOTATION_REF="a721">
                <ANNOTATION_VALUE>democrito aveva parlato degli atomi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a724" ANNOTATION_REF="a723">
                <ANNOTATION_VALUE>l'atomismo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a726" ANNOTATION_REF="a725">
                <ANNOTATION_VALUE>poi diciamo diviene un vero e proprio discorso scientifico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a728" ANNOTATION_REF="a727">
                <ANNOTATION_VALUE>nel seicento, quando c'è già la rivoluzione scientifica in atto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a730" ANNOTATION_REF="a729">
                <ANNOTATION_VALUE>e quindi gli esperime:nti, per verificare le teorie eccetera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a732" ANNOTATION_REF="a731">
                <ANNOTATION_VALUE>ma, anche lì, ha il precedente importantissimo nel rinascimento della rinascita delle filosofie dell'antichità, tra cui, (.) l'atomismo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a734" ANNOTATION_REF="a733">
                <ANNOTATION_VALUE>portato avanti anche da lucrezio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a736" ANNOTATION_REF="a735">
                <ANNOTATION_VALUE>eh quando, (.) telesio scrive de rerum natura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a738" ANNOTATION_REF="a737">
                <ANNOTATION_VALUE>ce l'avrà avuto presente che un certo lucrezio aveva scritto il de rerum natura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a740" ANNOTATION_REF="a739">
                <ANNOTATION_VALUE>chiaro che, (.) diciamo in qualche modo è proprio una citazione, un omaggio, a quelle tradizioni dell'antichità</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a742" ANNOTATION_REF="a741">
                <ANNOTATION_VALUE>perché in quelle tradizioni dell'antichità trovano nuova linfa:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a744" ANNOTATION_REF="a743">
                <ANNOTATION_VALUE>e lo stesso bacon però riconoscerà, (.) a telesio, il ruolo di primus homini novi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a746" ANNOTATION_REF="a745">
                <ANNOTATION_VALUE>primo degli uomini nuovi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a748" ANNOTATION_REF="a747">
                <ANNOTATION_VALUE>ora, anche questa è una forzatura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a750" ANNOTATION_REF="a749">
                <ANNOTATION_VALUE>perché probabilmente in questo discorso scientifico dovremmo vedere già leonardo da vinci come primo degli uomini nuovi, che viene molto prima di telesio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a752" ANNOTATION_REF="a751">
                <ANNOTATION_VALUE>dovremmo vedere copernico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a754" ANNOTATION_REF="a753">
                <ANNOTATION_VALUE>che scrive prima di telesio, e che per la prima volta finalmente, fa uscire diciamo l'occidente da questo mito per cui la terra è il centro di tutto l'universo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a756" ANNOTATION_REF="a755">
                <ANNOTATION_VALUE>mentre copernico si dimostr~ riesce a dimostrare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a758" ANNOTATION_REF="a757">
                <ANNOTATION_VALUE>sul piano solo matematico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a760" ANNOTATION_REF="a759">
                <ANNOTATION_VALUE>per dimostrarlo empiricamente ci vorrà galilei,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a762" ANNOTATION_REF="a761">
                <ANNOTATION_VALUE>ma copernico già sul piano matematico dimostra che è la terra che gira intorno al sole, non il sole che gira intorno alla terra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a764" ANNOTATION_REF="a763">
                <ANNOTATION_VALUE>come tutti ritenevano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a766" ANNOTATION_REF="a765">
                <ANNOTATION_VALUE>come la bibbia riteneva</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a768" ANNOTATION_REF="a767">
                <ANNOTATION_VALUE>nella bibbia ci so' vari passi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a770" ANNOTATION_REF="a769">
                <ANNOTATION_VALUE>a un certo punto dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a772" ANNOTATION_REF="a771">
                <ANNOTATION_VALUE>si è fermato il so:le.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a774" ANNOTATION_REF="a773">
                <ANNOTATION_VALUE>allora se s'(è fermato il sole, vuol dire che il sole si muove,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a776" ANNOTATION_REF="a775">
                <ANNOTATION_VALUE>e allora anche lì la bibbia dice sciocchezze</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a778" ANNOTATION_REF="a777">
                <ANNOTATION_VALUE>a un certo punto, gli occidentali, gli europei, si rendono conto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a780" ANNOTATION_REF="a779">
                <ANNOTATION_VALUE>anche da questo punto di vista la bibbia dice sciocchezze,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a782" ANNOTATION_REF="a781">
                <ANNOTATION_VALUE>in ogni caso, comunque, al di là de:::lla:: del discorso della pittura, al di là del discorso (.) e:::h della filosofia naturale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a784" ANNOTATION_REF="a783">
                <ANNOTATION_VALUE>mi interessa, diciamo leggervi anche un altro (.) passettino che è più o meno contemporaneo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a786" ANNOTATION_REF="a785">
                <ANNOTATION_VALUE>a quello di:, a quello di:: m::h (.) di d'alembert.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a788" ANNOTATION_REF="a787">
