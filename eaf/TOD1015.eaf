        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2118" ANNOTATION_REF="a2117">
                <ANNOTATION_VALUE>in cui dice che la trinità,</ANNOTATION_VALUE>
