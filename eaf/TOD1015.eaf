        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3678" ANNOTATION_REF="a3677">
                <ANNOTATION_VALUE>no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3680" ANNOTATION_REF="a3679">
                <ANNOTATION_VALUE>ehm.</ANNOTATION_VALUE>
