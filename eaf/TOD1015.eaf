            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1080" ANNOTATION_REF="a1079">
                <ANNOTATION_VALUE>e che aveva dato vita poi alla, dai primitivi in poi, all'arte::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1082" ANNOTATION_REF="a1081">
                <ANNOTATION_VALUE>alla meravigliosa stagione dell'arte italiana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1084" ANNOTATION_REF="a1083">
                <ANNOTATION_VALUE>in cui diciamo la, creatività::, (.) emerge, eccome.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1086" ANNOTATION_REF="a1085">
                <ANNOTATION_VALUE>e per esempio, se andiamo a guardare, diciamo (.) la ritrattistica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1088" ANNOTATION_REF="a1087">
                <ANNOTATION_VALUE>che è uno, è uno degli elementi (.) tipicamente caratteristici del rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1090" ANNOTATION_REF="a1089">
                <ANNOTATION_VALUE>ieri ve l'accennavo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1092" ANNOTATION_REF="a1091">
                <ANNOTATION_VALUE>anche perché mette l'uomo al centro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1094" ANNOTATION_REF="a1093">
                <ANNOTATION_VALUE>l'essere umano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1096" ANNOTATION_REF="a1095">
                <ANNOTATION_VALUE>anche la donna, comunque l'essere umano, mette al centro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1098" ANNOTATION_REF="a1097">
                <ANNOTATION_VALUE>quindi l'essere umano che sempre più (.) emerge come il protagonista di questa vita uma~ di questa vita sulla terra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1100" ANNOTATION_REF="a1099">
                <ANNOTATION_VALUE>e allora, se però andiamo a vedere questo dato, noi vediamo come (.) nel quattrocento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1102" ANNOTATION_REF="a1101">
                <ANNOTATION_VALUE>la ritrattistica tendesse,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1104" ANNOTATION_REF="a1103">
                <ANNOTATION_VALUE>a, (.) riprodurre immagini di profilo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1106" ANNOTATION_REF="a1105">
                <ANNOTATION_VALUE>e allora lì noi cogliamo, il nesso con la classicità con le monete.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1108" ANNOTATION_REF="a1107">
                <ANNOTATION_VALUE>i grandi imperatori, xxx (.) nel verso delle monete c'era sempre la testa dell'imperatore con cui è stata all'epoca di cui era stata coniata la moneta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1110" ANNOTATION_REF="a1109">
                <ANNOTATION_VALUE>e quindi diciamo quello era l'unico in qualche modo modello più reale che potevano avere i pittori da guardare rispetto all'iconografia dell'antichità.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1112" ANNOTATION_REF="a1111">
                <ANNOTATION_VALUE>ma, quando poi arriviamo a a a::: a leonardo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1114" ANNOTATION_REF="a1113">
                <ANNOTATION_VALUE>((tossisce)) scusatemi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1116" ANNOTATION_REF="a1115">
                <ANNOTATION_VALUE>a leonardo, raffaello e ancora oltre,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1118" ANNOTATION_REF="a1117">
                <ANNOTATION_VALUE>tiziano, eccetera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1120" ANNOTATION_REF="a1119">
                <ANNOTATION_VALUE>finirà questo discorso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1122" ANNOTATION_REF="a1121">
                <ANNOTATION_VALUE>e quindi non c'abbiamo più solo i profili,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1124" ANNOTATION_REF="a1123">
                <ANNOTATION_VALUE>ma c'abbiamo pure il frontale, il:: mezzobusto un po' a tre quarti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1126" ANNOTATION_REF="a1125">
                <ANNOTATION_VALUE>e anche lì è una creatività, è un mettere qualcosa di nuovo che gli artisti fanno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1128" ANNOTATION_REF="a1127">
                <ANNOTATION_VALUE>ancor meno diciamo, (.) imitazione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1130" ANNOTATION_REF="a1129">
                <ANNOTATION_VALUE>e:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1132" ANNOTATION_REF="a1131">
                <ANNOTATION_VALUE>no, c'arriviamo c'arriviamo dopo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1134" ANNOTATION_REF="a1133">
                <ANNOTATION_VALUE>altro carattere, scusatemi. altro carattere eh fondamentale, come vi accennavo ieri, è il discorso dell'eccellenza, della dignità dell'uomo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1136" ANNOTATION_REF="a1135">
                <ANNOTATION_VALUE>dopo un medioevo in cui, la figura dell'individuo era, totalmente diciamo, e::h (.) messa da parte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1138" ANNOTATION_REF="a1137">
                <ANNOTATION_VALUE>a confronto al cosmo generale::, in cui tutto quanto doveva tendere ad unità::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1140" ANNOTATION_REF="a1139">
                <ANNOTATION_VALUE>nell'umanesimo e nel rinascimento questo fenomeno si inverte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1142" ANNOTATION_REF="a1141">
                <ANNOTATION_VALUE>allora vi leggo un breve passo, dalla orazione de dignitate et excellentia hominis di::: pico della mirandola,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1144" ANNOTATION_REF="a1143">
                <ANNOTATION_VALUE>che::, (.) fa dire a dio:, (.) dio sta parlando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1146" ANNOTATION_REF="a1145">
                <ANNOTATION_VALUE>da nessun limite costretto, secondo il tuo arbitrio alla cui potestà ti affidai, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1148" ANNOTATION_REF="a1147">
                <ANNOTATION_VALUE>io dio ti affidai,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1150" ANNOTATION_REF="a1149">
                <ANNOTATION_VALUE>ti posi al centro del mondo. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1152" ANNOTATION_REF="a1151">
                <ANNOTATION_VALUE>perché di lì ti potessi meglio osservare tutto ciò che è nel mondo. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1154" ANNOTATION_REF="a1153">
                <ANNOTATION_VALUE>e non ti feci né celeste né terrestre, né mortale né immortale, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1156" ANNOTATION_REF="a1155">
                <ANNOTATION_VALUE>perché tu liberamente, come artefice di te stesso, possa foggiarti e plasmarti nella forma che avrai preferito. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1158" ANNOTATION_REF="a1157">
                <ANNOTATION_VALUE>ora qui vediamo come appunto diciamo, l'individuo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1160" ANNOTATION_REF="a1159">
                <ANNOTATION_VALUE>la libertà dell'individuo, diventa il centro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1162" ANNOTATION_REF="a1161">
                <ANNOTATION_VALUE>dell'esistenza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1164" ANNOTATION_REF="a1163">
                <ANNOTATION_VALUE>non è più dio, (.) ma è dio stesso che dice all'uomo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1166" ANNOTATION_REF="a1165">
                <ANNOTATION_VALUE>riprenditi quello che è tuo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1168" ANNOTATION_REF="a1167">
                <ANNOTATION_VALUE>riprenditi il tuo destino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1170" ANNOTATION_REF="a1169">
                <ANNOTATION_VALUE>riprenditi la tua vita, decidi tu se arriverai o non arriverai alla salvezza eterna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1172" ANNOTATION_REF="a1171">
                <ANNOTATION_VALUE>sii artefice di te stesso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1174" ANNOTATION_REF="a1173">
                <ANNOTATION_VALUE>&gt;cioè&lt; è l'individuo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1176" ANNOTATION_REF="a1175">
                <ANNOTATION_VALUE>ora questo in effetti c'era stato già un po' nel medioevo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1178" ANNOTATION_REF="a1177">
                <ANNOTATION_VALUE>nel medioevo qualche autobiografia c'era per esempio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1180" ANNOTATION_REF="a1179">
                <ANNOTATION_VALUE>l'autobiografia segnala che l'individuo ha coscienza di sé stesso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1182" ANNOTATION_REF="a1181">
                <ANNOTATION_VALUE>parla di sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1184" ANNOTATION_REF="a1183">
                <ANNOTATION_VALUE>però erano poche le autobiografie nel medioevo, invece nel rinascimento sono tante le autobiografie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1186" ANNOTATION_REF="a1185">
                <ANNOTATION_VALUE>nel rinascimento c'è la ritrattistica, nel rinascimento ritorna al centro o si pone al centro l'essere umano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1188" ANNOTATION_REF="a1187">
                <ANNOTATION_VALUE>questo non sarebbe potuto bastare per creare l'individuo moderno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1190" ANNOTATION_REF="a1189">
                <ANNOTATION_VALUE>e allora quando i critici del rinascimento, osservano questo c'hanno pure ragione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1192" ANNOTATION_REF="a1191">
                <ANNOTATION_VALUE>però i critici del rinascimento, si dimenticano, che più o meno contestualmente, c'è stata pure la riforma protestante,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1194" ANNOTATION_REF="a1193">
                <ANNOTATION_VALUE>l'individuo, la coscienza individuale richiamata dalla riforma protestante,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1196" ANNOTATION_REF="a1195">
                <ANNOTATION_VALUE>legata con la coscienza individuale richiamata dal rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1198" ANNOTATION_REF="a1197">
                <ANNOTATION_VALUE>crea l'individuo moderno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1200" ANNOTATION_REF="a1199">
                <ANNOTATION_VALUE>ci ritorneremo quando parleremo della riforma protestante,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1202" ANNOTATION_REF="a1201">
                <ANNOTATION_VALUE>però, ancora una volta, i fenomeni si rinforzano l'un l'altro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1204" ANNOTATION_REF="a1203">
                <ANNOTATION_VALUE>la modernità non è figlia di un, fenomeno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1206" ANNOTATION_REF="a1205">
                <ANNOTATION_VALUE>è un percorso estremamente complicato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1208" ANNOTATION_REF="a1207">
                <ANNOTATION_VALUE>in cui le cose poi si possono rafforzare l'una all'altra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1210" ANNOTATION_REF="a1209">
                <ANNOTATION_VALUE>rinascimento e riforma sono uno di quei casi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1212" ANNOTATION_REF="a1211">
                <ANNOTATION_VALUE>in modo, (.) evidente, e lapalissiano. nonostante molti storici del rinascimento ormai, non lo dicano più.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1214" ANNOTATION_REF="a1213">
                <ANNOTATION_VALUE>perché i grandi storici del passato come edelio candimori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1216" ANNOTATION_REF="a1215">
                <ANNOTATION_VALUE>che si studiavano il rinascimento, e si studiavano la riforma,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1218" ANNOTATION_REF="a1217">
                <ANNOTATION_VALUE>non ci sono più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1220" ANNOTATION_REF="a1219">
                <ANNOTATION_VALUE>siccome la storia è diventata patrimonio degli iperspecialismi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1222" ANNOTATION_REF="a1221">
                <ANNOTATION_VALUE>ci sono colleghi che sanno tutto, della rivoluzione francese, ma se gli vai a chiedere machiavelli, leonardo, dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1224" ANNOTATION_REF="a1223">
                <ANNOTATION_VALUE>m:h fammi pensa' quand'è vissuto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1226" ANNOTATION_REF="a1225">
                <ANNOTATION_VALUE>non hanno la più pallida idea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1228" ANNOTATION_REF="a1227">
                <ANNOTATION_VALUE>questo è molto grave, ma è un fenomeno::: della del degli studi::: che va avanti da una trentina d'anni,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1230" ANNOTATION_REF="a1229">
                <ANNOTATION_VALUE>e quindi allora, (.) se, voi vi leggevate di i te:sti: di una cinquantina d'anni fa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1232" ANNOTATION_REF="a1231">
                <ANNOTATION_VALUE>era scontato mettere in relazione rinascimento e riformismo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1234" ANNOTATION_REF="a1233">
                <ANNOTATION_VALUE>era scontato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1236" ANNOTATION_REF="a1235">
                <ANNOTATION_VALUE>oggi, non ci trovate manco un riferimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1238" ANNOTATION_REF="a1237">
                <ANNOTATION_VALUE>voi vi leggete una storia del rinascimento e la riforma semplicemente non c'è,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1240" ANNOTATION_REF="a1239">
                <ANNOTATION_VALUE>non esiste,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1242" ANNOTATION_REF="a1241">
                <ANNOTATION_VALUE>eppure, (.) ve lo ridirò dopo e ci ritorneremo più volte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1244" ANNOTATION_REF="a1243">
                <ANNOTATION_VALUE>due fra i grandi nomi, diciamo, soprattutto fra i radicali religiosi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1246" ANNOTATION_REF="a1245">
                <ANNOTATION_VALUE>su cui ritorneremo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1248" ANNOTATION_REF="a1247">
                <ANNOTATION_VALUE>sono erasmo da rotterdam e lorenzo valla,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1250" ANNOTATION_REF="a1249">
                <ANNOTATION_VALUE>cioè quando questi vanno a fare la critica religiosa, dicono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1252" ANNOTATION_REF="a1251">
                <ANNOTATION_VALUE>ma erasmo ha detto, valla ha detto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1254" ANNOTATION_REF="a1253">
                <ANNOTATION_VALUE>non lutero ha detto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1256" ANNOTATION_REF="a1255">
                <ANNOTATION_VALUE>cioè, sono poi degli umanisti, che prendono anche un percorso di riforma religiosa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1258" ANNOTATION_REF="a1257">
                <ANNOTATION_VALUE>e questo comincia già all'interno dell'umanesimo stesso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1260" ANNOTATION_REF="a1259">
                <ANNOTATION_VALUE>quindi come facciamo a distinguere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1262" ANNOTATION_REF="a1261">
                <ANNOTATION_VALUE>questi a:mbiti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1264" ANNOTATION_REF="a1263">
                <ANNOTATION_VALUE>come diceva brodelli, i muri degli orti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1266" ANNOTATION_REF="a1265">
                <ANNOTATION_VALUE>perché poi que:sto è,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1268" ANNOTATION_REF="a1267">
                <ANNOTATION_VALUE>è potere acccademico alla base.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1270" ANNOTATION_REF="a1269">
                <ANNOTATION_VALUE>le distinzioni, le partizioni disciplinari, (.) con cu~ che se ci sembrano cose naturali, attraverso cui il sapere è articolato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1272" ANNOTATION_REF="a1271">
                <ANNOTATION_VALUE>molto spesso, dietro, non hanno niente altro che, potere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1274" ANNOTATION_REF="a1273">
                <ANNOTATION_VALUE>discorsi di, potere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1276" ANNOTATION_REF="a1275">
                <ANNOTATION_VALUE>perché se io poi mi faccio un corso di storia del rinascimento, i rinascimentisti poi magari li controllo io, e decido io chi entra e chi non entra all'università</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1278" ANNOTATION_REF="a1277">
                <ANNOTATION_VALUE>di questo stiamo parlando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1280" ANNOTATION_REF="a1279">
                <ANNOTATION_VALUE>molto spesso, dietro, e:h co:nte:se, dietro cose che sembrano culturali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1282" ANNOTATION_REF="a1281">
                <ANNOTATION_VALUE>c'è il gre:ve, potere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1284" ANNOTATION_REF="a1283">
                <ANNOTATION_VALUE>e l'accademia è uno dei posti dove questo al massimo livello si esprime,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1286" ANNOTATION_REF="a1285">
                <ANNOTATION_VALUE>in maniera veramente mortificante, perché vorrei capire quale potere abbiamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1288" ANNOTATION_REF="a1287">
                <ANNOTATION_VALUE>cioè forse una volta, i professori universitari avevano potere accademico. oggi come oggi non contano niente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1290" ANNOTATION_REF="a1289">
                <ANNOTATION_VALUE>oggi come oggi non contano niente i professori universitari.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1292" ANNOTATION_REF="a1291">
                <ANNOTATION_VALUE>eppure pure per tenersi una cosetta così, xxx l'iperspecialista,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1294" ANNOTATION_REF="a1293">
                <ANNOTATION_VALUE>così controlla tutto lui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1296" ANNOTATION_REF="a1295">
                <ANNOTATION_VALUE>controlla tutto lui e poi dice fesserie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1298" ANNOTATION_REF="a1297">
                <ANNOTATION_VALUE>comunque vabbè</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1300" ANNOTATION_REF="a1299">
                <ANNOTATION_VALUE>scusatemi diciamo la::, (.) la deviazione dal rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1302" ANNOTATION_REF="a1301">
                <ANNOTATION_VALUE>però questo vi deve essere chiaro, perché uno si chiede dice vabbè,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1304" ANNOTATION_REF="a1303">
                <ANNOTATION_VALUE>ma allora, se le interpretazioni dicono che il rinascimento con la riforma non centra niente, negli ultimi tempi perché il professore dice ste cose.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1306" ANNOTATION_REF="a1305">
                <ANNOTATION_VALUE>e ve lo devo dire che questo dipende, o da ignoranza, (.) oppure proprio peggio, da dinamiche di potere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1308" ANNOTATION_REF="a1307">
                <ANNOTATION_VALUE>perché se no non ci capite niente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1310" ANNOTATION_REF="a1309">
                <ANNOTATION_VALUE>cioè anche questo è elemento storiografico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1312" ANNOTATION_REF="a1311">
                <ANNOTATION_VALUE>anche capire queste cose è elemento storiografico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1314" ANNOTATION_REF="a1313">
                <ANNOTATION_VALUE>nel mio (campanella) vedrete che proprio pure per miserie perso:na:li, miseriucce personali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1316" ANNOTATION_REF="a1315">
                <ANNOTATION_VALUE>individiuzze,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1318" ANNOTATION_REF="a1317">
                <ANNOTATION_VALUE>spingevano questo o quello studioso a pigliare una via piuttosto che un'altra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1320" ANNOTATION_REF="a1319">
                <ANNOTATION_VALUE>non la convinzione filologica dello studio, (.) matto e disperato delle cose.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1322" ANNOTATION_REF="a1321">
                <ANNOTATION_VALUE>no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1324" ANNOTATION_REF="a1323">
                <ANNOTATION_VALUE>perché uno magari, un professore, era stato un poco offensivo nei confronti di un altro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1326" ANNOTATION_REF="a1325">
                <ANNOTATION_VALUE>mentre si pigliavano il caffè, che ne so.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1328" ANNOTATION_REF="a1327">
                <ANNOTATION_VALUE>allora dice, mo te la faccio pagare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1330" ANNOTATION_REF="a1329">
                <ANNOTATION_VALUE>e te la faccio pagare con qualche noticina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1332" ANNOTATION_REF="a1331">
                <ANNOTATION_VALUE>nei miei libri.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1334" ANNOTATION_REF="a1333">
                <ANNOTATION_VALUE>purtroppo, questo, bisogna averlo, sempre, presente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1336" ANNOTATION_REF="a1335">
                <ANNOTATION_VALUE>sempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1338" ANNOTATION_REF="a1337">
                <ANNOTATION_VALUE>magari, diciamo la cultura, fosse del tutto avulsa da questioni di potere, da miserie personali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1340" ANNOTATION_REF="a1339">
                <ANNOTATION_VALUE>magari, ma non lo è per niente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1342" ANNOTATION_REF="a1341">
                <ANNOTATION_VALUE>non lo è per niente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1344" ANNOTATION_REF="a1343">
                <ANNOTATION_VALUE>questo dev'essere chiarissimo diciamo eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1346" ANNOTATION_REF="a1345">
                <ANNOTATION_VALUE>ed è una tipica tara, (.) una tipica tara dell'italia questa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1348" ANNOTATION_REF="a1347">
                <ANNOTATION_VALUE>quindi diciamo e::h l'individuo, (.) abbiamo detto la rinascita della classicità,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1350" ANNOTATION_REF="a1349">
                <ANNOTATION_VALUE>un altro fondamentale aspetto del rinascimento che spingerà, diciamo i suoi effetti fino all'illuminismo e anche fino a noi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1352" ANNOTATION_REF="a1351">
                <ANNOTATION_VALUE>è quello finalmente di un'educazione laica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1354" ANNOTATION_REF="a1353">
                <ANNOTATION_VALUE>cioè la ripresa di questi studiae humanitatis, da cui vi è studi di umanità, da cui viene il termine umanista,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1356" ANNOTATION_REF="a1355">
                <ANNOTATION_VALUE>porta alla creazione di tutta una serie di scuole,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1358" ANNOTATION_REF="a1357">
                <ANNOTATION_VALUE>e dovete avere ben presente, che fino a quel momento, l'educazione era monopolio esclusivo della chiesa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1360" ANNOTATION_REF="a1359">
                <ANNOTATION_VALUE>non c'erano scuole laiche diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1362" ANNOTATION_REF="a1361">
                <ANNOTATION_VALUE>per cui, la nascita del movimento umanistico, ha un effetto storico portentoso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1364" ANNOTATION_REF="a1363">
                <ANNOTATION_VALUE>anche per questo motivo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1366" ANNOTATION_REF="a1365">
                <ANNOTATION_VALUE>si diffonde enormemente anche per questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1368" ANNOTATION_REF="a1367">
                <ANNOTATION_VALUE>perché le scuole sono piene di questi grammatici che vanno a insegnare queste cose,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1370" ANNOTATION_REF="a1369">
                <ANNOTATION_VALUE>quindi i giovani, mano mano le nuove generazioni,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1372" ANNOTATION_REF="a1371">
                <ANNOTATION_VALUE>sempre più, riescono in qualche modo, a distaccarsi dal mondo medioevale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1374" ANNOTATION_REF="a1373">
                <ANNOTATION_VALUE>e a porsi nei confronti dell'età nuova, in maniera innovativa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1376" ANNOTATION_REF="a1375">
                <ANNOTATION_VALUE>fattore fondamentale, sul piano proprio strumentale, ma non solo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1378" ANNOTATION_REF="a1377">
                <ANNOTATION_VALUE>è il fatto che, (.) viene inventata la stampa a caratteri mobili,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1380" ANNOTATION_REF="a1379">
                <ANNOTATION_VALUE>diciamo fin quando c'era petrarca ancora c'erano i manoscritti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1382" ANNOTATION_REF="a1381">
                <ANNOTATION_VALUE>l'invenzione della stampa a caratteri mobili consente una diffusione dei testi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1384" ANNOTATION_REF="a1383">
                <ANNOTATION_VALUE>che prima era inconcepibile, i manoscritti erano pochissimi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1386" ANNOTATION_REF="a1385">
                <ANNOTATION_VALUE>di una singola opera, quanti ce ne potevano essere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1388" ANNOTATION_REF="a1387">
                <ANNOTATION_VALUE>invece là cominciamo ad avere tirature da duecento, trecento, cinquecento, mille copie, (.) di un libro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1390" ANNOTATION_REF="a1389">
                <ANNOTATION_VALUE>e allora il libro comincia a circolare enormemente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1392" ANNOTATION_REF="a1391">
                <ANNOTATION_VALUE>e circola non solo, (.) perché se ne possono stampare di più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1394" ANNOTATION_REF="a1393">
                <ANNOTATION_VALUE>ma circola perché costa di meno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1396" ANNOTATION_REF="a1395">
                <ANNOTATION_VALUE>questo è un dato fondamentale, che spesso si dimentica</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1398" ANNOTATION_REF="a1397">
                <ANNOTATION_VALUE>cioè l'invenzione della stampa non solo permette di produrre mo:~ infinitamente di più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1400" ANNOTATION_REF="a1399">
                <ANNOTATION_VALUE>ma permette di abbattere pesantissimamente i costi della stampa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1402" ANNOTATION_REF="a1401">
                <ANNOTATION_VALUE>perché paga' un monaco che ti ricopiava tutto un trattato a penna, insomma eh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1404" ANNOTATION_REF="a1403">
                <ANNOTATION_VALUE>invece, coi caratteri mobili, (.) tutto cambia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1406" ANNOTATION_REF="a1405">
                <ANNOTATION_VALUE>e si cominciano ad affermare, diciamo, ricordiamo, (.) forse il più grande editore del rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1408" ANNOTATION_REF="a1407">
                <ANNOTATION_VALUE>l'italiano alzo manuzio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1410" ANNOTATION_REF="a1409">
                <ANNOTATION_VALUE>delle vicinanze di roma, ma agiva operava, a venezia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1412" ANNOTATION_REF="a1411">
                <ANNOTATION_VALUE>le famose a:ldi:ne,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1414" ANNOTATION_REF="a1413">
                <ANNOTATION_VALUE>con il loro frontespizio con un'ancora circondata da un delfino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1416" ANNOTATION_REF="a1415">
                <ANNOTATION_VALUE>sono il massimo dell'eleganza tipografica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1418" ANNOTATION_REF="a1417">
                <ANNOTATION_VALUE>e infatti costano ogg~ all'epoca costavano poco. oggi costano un sacco di soldi se uno se la vuole comprare un'aldina</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1420" ANNOTATION_REF="a1419">
                <ANNOTATION_VALUE>però diventano veramente il modello dell'eleganza della stampa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1422" ANNOTATION_REF="a1421">
                <ANNOTATION_VALUE>e aiutano la diffusione maggiore dei testi, perché aldo si inventa il tascabile.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1424" ANNOTATION_REF="a1423">
                <ANNOTATION_VALUE>cioè prima e::h ((ride)) erano delle bestie così diciamo, i volumi, no,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1426" ANNOTATION_REF="a1425">
                <ANNOTATION_VALUE>quindi pure da trasportare, (.) non era così semplice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1428" ANNOTATION_REF="a1427">
                <ANNOTATION_VALUE>invece, cominciano a comparire dei forma~ dei piccoli formati,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1430" ANNOTATION_REF="a1429">
                <ANNOTATION_VALUE>aldo è il primo che diciamo insiste molto su questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1432" ANNOTATION_REF="a1431">
                <ANNOTATION_VALUE>e anche questo favorisce, (.) non solo la diffusione legale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1434" ANNOTATION_REF="a1433">
                <ANNOTATION_VALUE>ma anche, la diffusione, (.) i:llegale</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1436" ANNOTATION_REF="a1435">
                <ANNOTATION_VALUE>non ancora all'epoca di aldo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1438" ANNOTATION_REF="a1437">
                <ANNOTATION_VALUE>ma, dopo una cinquantina d'anni, un po' di meno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1440" ANNOTATION_REF="a1439">
                <ANNOTATION_VALUE>c'è l'indice dei libri proibiti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1442" ANNOTATION_REF="a1441">
                <ANNOTATION_VALUE>quindi comincia ad esserci il problema, (.) dei libri che non si possono vendere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1444" ANNOTATION_REF="a1443">
                <ANNOTATION_VALUE>e ovviamente, dato che non si possono vendere, si vendono tantissimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1446" ANNOTATION_REF="a1445">
                <ANNOTATION_VALUE>no? la cosa proibita, (.) è sempre quella verso cui uno sbava eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1448" ANNOTATION_REF="a1447">
                <ANNOTATION_VALUE>perché se no se fosse disponibile,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1450" ANNOTATION_REF="a1449">
                <ANNOTATION_VALUE>machiavelli che era odiato, eccetera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1452" ANNOTATION_REF="a1451">
                <ANNOTATION_VALUE>eh le opere di machiavelli hanno avuto nell'età moderna un successo spettacolare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1454" ANNOTATION_REF="a1453">
                <ANNOTATION_VALUE>c'è la bibliografia delle ristampe di machiavelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1456" ANNOTATION_REF="a1455">
                <ANNOTATION_VALUE>son quattro volumi così</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1458" ANNOTATION_REF="a1457">
                <ANNOTATION_VALUE>in cui ci sono solo i titoli delle ristampe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1460" ANNOTATION_REF="a1459">
                <ANNOTATION_VALUE>dal millecinquecentotrentuno in avanti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1462" ANNOTATION_REF="a1461">
                <ANNOTATION_VALUE>saranno cinquecento, seicento ristampe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1464" ANNOTATION_REF="a1463">
                <ANNOTATION_VALUE>solo di machiavelli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1466" ANNOTATION_REF="a1465">
                <ANNOTATION_VALUE>e allora il formato, no, aiutava,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1468" ANNOTATION_REF="a1467">
                <ANNOTATION_VALUE>scusate (le mie xx)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1470" ANNOTATION_REF="a1469">
                <ANNOTATION_VALUE>i colporteurs, come si chiamavano, camminavano, (.) col mantello</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1472" ANNOTATION_REF="a1471">
                <ANNOTATION_VALUE>e allora sotto il mantello, il xxx libro di nascondeva meglio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1474" ANNOTATION_REF="a1473">
                <ANNOTATION_VALUE>e quindi c'era questa proprio questa espressione gergale che viene dalla francia, sous le manteau, sotto il mantello,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1476" ANNOTATION_REF="a1475">
                <ANNOTATION_VALUE>che significa il trasporto dei libri proibiti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1478" ANNOTATION_REF="a1477">
                <ANNOTATION_VALUE>andatevi a portare un xxxxx insomma come si fa?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1480" ANNOTATION_REF="a1479">
                <ANNOTATION_VALUE>invece col tascabile, anche, il contrabbando, (.) ha un enorme sviluppo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1482" ANNOTATION_REF="a1481">
                <ANNOTATION_VALUE>ed è uno di quei contrabbandi che a noi ci piacciono insomma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1484" ANNOTATION_REF="a1483">
                <ANNOTATION_VALUE>poi tante altre cose sono illegali, per carità</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1486" ANNOTATION_REF="a1485">
                <ANNOTATION_VALUE>ma il contrabbando dei libri proibiti insomma. sarà 'na cosa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1488" ANNOTATION_REF="a1487">
                <ANNOTATION_VALUE>almeno dei libri proibiti dell'epoca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1490" ANNOTATION_REF="a1489">
                <ANNOTATION_VALUE>poi il contrabbando del mein kampf non ci piace,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1492" ANNOTATION_REF="a1491">
                <ANNOTATION_VALUE>ma insomma il contrabbando dei libri dell'epoca invece è una cosa importante</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1494" ANNOTATION_REF="a1493">
                <ANNOTATION_VALUE>manuzio va anche ricordato perché iniziò, a stampare i caratteri greci,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1496" ANNOTATION_REF="a1495">
                <ANNOTATION_VALUE>e quindi quel ritorno del greco poté anche avvenire grazie alla stampa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1498" ANNOTATION_REF="a1497">
                <ANNOTATION_VALUE>si stampava in caratteri greci.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1500" ANNOTATION_REF="a1499">
                <ANNOTATION_VALUE>e manuzio, inventò il carattere che all'estero chiamano italico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1502" ANNOTATION_REF="a1501">
                <ANNOTATION_VALUE>il carattere italico è il nostro corsivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1504" ANNOTATION_REF="a1503">
                <ANNOTATION_VALUE>quando noi sul computer ci mettia~, adesso c'è ci, una volta c'era i</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1506" ANNOTATION_REF="a1505">
                <ANNOTATION_VALUE>quando mettevamo il corsivo no? selezioniamo a mettiamo in corsivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1508" ANNOTATION_REF="a1507">
                <ANNOTATION_VALUE>quel carattere se l'è inventato aldo manuzio, in italia, all'inizio del cinquecento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1510" ANNOTATION_REF="a1509">
                <ANNOTATION_VALUE>è un no:stro:, un nostro, una delle no:stre:: grandi grandi scoperte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1512" ANNOTATION_REF="a1511">
                <ANNOTATION_VALUE>è l'epoca, del predominio, del latino, della lingua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1514" ANNOTATION_REF="a1513">
                <ANNOTATION_VALUE>delle lingue colte, però anche questo diciamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1516" ANNOTATION_REF="a1515">
                <ANNOTATION_VALUE>inizia, (.) in modo prodigioso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1518" ANNOTATION_REF="a1517">
                <ANNOTATION_VALUE>l'affermarsi delle lingue volgari</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1520" ANNOTATION_REF="a1519">
                <ANNOTATION_VALUE>nel millecinquecentoventicinque, in italia, pietro bembo, scrive le prose della volgar lingua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1522" ANNOTATION_REF="a1521">
                <ANNOTATION_VALUE>e diciamo il fiorentino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1524" ANNOTATION_REF="a1523">
                <ANNOTATION_VALUE>diventa la base del linguaggio italiano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1526" ANNOTATION_REF="a1525">
                <ANNOTATION_VALUE>e, questo, ancora una volta si lega moltissimo con la riforma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1528" ANNOTATION_REF="a1527">
                <ANNOTATION_VALUE>se noi andiamo a vedere la nascita del volgare tedesco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1530" ANNOTATION_REF="a1529">
                <ANNOTATION_VALUE>la nascita del volgare tedesco deve moltissimo alla traduzione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1532" ANNOTATION_REF="a1531">
                <ANNOTATION_VALUE>uscita in quegli anni proprio delle prose della volgar lingua di bembo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1534" ANNOTATION_REF="a1533">
                <ANNOTATION_VALUE>alla traduzione della bibbia in tedesco, fatta da lutero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1536" ANNOTATION_REF="a1535">
                <ANNOTATION_VALUE>ora è chiaro, voi sapete benissimo diciamo, che la stragrande maggioranza della popolazione europea era analfabeta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1538" ANNOTATION_REF="a1537">
                <ANNOTATION_VALUE>'sti libri a che servivano?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1540" ANNOTATION_REF="a1539">
                <ANNOTATION_VALUE>ma c'era una pratica, che oggi non esiste più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1542" ANNOTATION_REF="a1541">
                <ANNOTATION_VALUE>e invece all'epoca era estremamente diffusa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1544" ANNOTATION_REF="a1543">
                <ANNOTATION_VALUE>che era quella della lettura comunitaria diciamo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1546" ANNOTATION_REF="a1545">
                <ANNOTATION_VALUE>c'era uno che sapeva leggere, leggeva ad alta voce, e trasmetteva e faceva circolare le idee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1548" ANNOTATION_REF="a1547">
                <ANNOTATION_VALUE>noi così cominciano a capire, com'è possibile che, soprattutto diciamo nel radicalismo religioso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1550" ANNOTATION_REF="a1549">
                <ANNOTATION_VALUE>c'abbiamo così tante persone di u:milissime origini,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1552" ANNOTATION_REF="a1551">
                <ANNOTATION_VALUE>che è evidente che non sapevano leggere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1554" ANNOTATION_REF="a1553">
                <ANNOTATION_VALUE>non sempre, perché c'abbiam pure il caso celeberrimo, del mugnaio menocchio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1556" ANNOTATION_REF="a1555">
                <ANNOTATION_VALUE>e menocchio sapeva leggere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1558" ANNOTATION_REF="a1557">
                <ANNOTATION_VALUE>ma normalmente non sapevano leggere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1560" ANNOTATION_REF="a1559">
                <ANNOTATION_VALUE>quindi come facevano a sapere quelle idee?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1562" ANNOTATION_REF="a1561">
                <ANNOTATION_VALUE>c'era la predicazione orale, c'era la circolazione delle idee orale, ma c'era la lettura ad alta voce.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1564" ANNOTATION_REF="a1563">
                <ANNOTATION_VALUE>che favoriva la diffusione delle idee, e favoriva anche la diffusione del linguaggio, anche la diffusione del volgare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1566" ANNOTATION_REF="a1565">
                <ANNOTATION_VALUE>man mano che il cinquecento procede, sempre più i testi saranno scritti in volgare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1568" ANNOTATION_REF="a1567">
                <ANNOTATION_VALUE>diciamo fin quando non prevarrà tra sette ottocento insomma ci vuole perché prevalgano le lingue volgari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1570" ANNOTATION_REF="a1569">
                <ANNOTATION_VALUE>che è un altro dei caratteri fondamentali, della modernità.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1572" ANNOTATION_REF="a1571">
                <ANNOTATION_VALUE>l'uso della lingua volgare e non più del latino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1574" ANNOTATION_REF="a1573">
                <ANNOTATION_VALUE>in ogni caso come vi accennavo ieri, diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1576" ANNOTATION_REF="a1575">
                <ANNOTATION_VALUE>il portato forse maggio:re del del rinascimento al al al nostro mondo moderno, viene dalla filologia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1578" ANNOTATION_REF="a1577">
                <ANNOTATION_VALUE>e non tanto dalla filologia in se stessa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1580" ANNOTATION_REF="a1579">
                <ANNOTATION_VALUE>quanto dall'attitudine alla critica che la filologia porta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1582" ANNOTATION_REF="a1581">
                <ANNOTATION_VALUE>il verificare le lezioni tra i testi che ci erano stati tratti dalla tradizione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1584" ANNOTATION_REF="a1583">
                <ANNOTATION_VALUE>e i testi diciamo che cominciano ad affluire in greco, i testi originali, oppure manoscritti riscoperti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1586" ANNOTATION_REF="a1585">
                <ANNOTATION_VALUE>c'erano st'umanisti che andavano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1588" ANNOTATION_REF="a1587">
                <ANNOTATION_VALUE>quando si comincia a capire qual è il discorso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1590" ANNOTATION_REF="a1589">
                <ANNOTATION_VALUE>ci sono una serie di umanisti che vanno girando per abbazie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1592" ANNOTATION_REF="a1591">
                <ANNOTATION_VALUE>qua in piemonte c'era questa di bobbio che aveva una spettacolare biblioteca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1594" ANNOTATION_REF="a1593">
                <ANNOTATION_VALUE>e gli umanisti andavano e fregavano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1596" ANNOTATION_REF="a1595">
                <ANNOTATION_VALUE>cioè si comincia, (.) questo è un fenomeno proprio di massa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1598" ANNOTATION_REF="a1597">
                <ANNOTATION_VALUE>questi umanisti che vanno girando per sti conventi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1600" ANNOTATION_REF="a1599">
                <ANNOTATION_VALUE>dice, q'avete qualco::sa e poi se lo mettono in tasca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1602" ANNOTATION_REF="a1601">
                <ANNOTATION_VALUE>questo ha permesso che molti di quei testi si salvassero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1604" ANNOTATION_REF="a1603">
                <ANNOTATION_VALUE>cioè all'origine c'è un crimine diciamo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1606" ANNOTATION_REF="a1605">
                <ANNOTATION_VALUE>che insom~ il furto è sempre:: è sempre un crimine orribile. anche all'epoca era furto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1608" ANNOTATION_REF="a1607">
                <ANNOTATION_VALUE>mo non è che all'epoca non si concepisse così</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1610" ANNOTATION_REF="a1609">
                <ANNOTATION_VALUE>però, quel furto, ha permesso, a tutta una serie di autori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1612" ANNOTATION_REF="a1611">
                <ANNOTATION_VALUE>della classicità, che erano rimasti ormai confinati dentro polverosi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1614" ANNOTATION_REF="a1613">
                <ANNOTATION_VALUE>gli umanis~ spesso li descrivono, dice ho trovato sto codice che era pieno di muffa, pieno di polvere, che nessuno apriva da secoli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1616" ANNOTATION_REF="a1615">
                <ANNOTATION_VALUE>gli umanisti gli danno nuova vita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1618" ANNOTATION_REF="a1617">
                <ANNOTATION_VALUE>li ristampano, fanno nuove edizioni, fanno ri~ ri~ ritornare, diciamo tutta la classicità,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1620" ANNOTATION_REF="a1619">
                <ANNOTATION_VALUE>la fanno ritornare in auge, nella cultura europea, grazie a quest'opera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1622" ANNOTATION_REF="a1621">
                <ANNOTATION_VALUE>quest'opera, di f~ filologica, però appunto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1624" ANNOTATION_REF="a1623">
                <ANNOTATION_VALUE>innesca un'attitudine alla cri~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1626" ANNOTATION_REF="a1625">
                <ANNOTATION_VALUE>di~ c'è qualcosa che non è chiaro?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1628" ANNOTATION_REF="a1627">
                <ANNOTATION_VALUE>c'è qualcosa che non è chiaro?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1632" ANNOTATION_REF="a1631">
                <ANNOTATION_VALUE>la filologia in generale</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1636" ANNOTATION_REF="a1635">
                <ANNOTATION_VALUE>e:h proprio come attitudine alla filologia, come metodo di studio diciamo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1638" ANNOTATION_REF="a1637">
                <ANNOTATION_VALUE>il metodo di studio per cui tu c'hai un testo manoscritto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1640" ANNOTATION_REF="a1639">
                <ANNOTATION_VALUE>c'hai un manoscritto in greco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1642" ANNOTATION_REF="a1641">
                <ANNOTATION_VALUE>vai a confrontare e ti rendi conto, ci so' salti di righe, ci so::no:: paro:le: capite male,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1644" ANNOTATION_REF="a1643">
                <ANNOTATION_VALUE>quest~ è piena, a me sta mattina m'(è arrivata 'na co:sa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1646" ANNOTATION_REF="a1645">
                <ANNOTATION_VALUE>c'era una citazione che avevo preso (di un x) monsignor dati,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1648" ANNOTATION_REF="a1647">
                <ANNOTATION_VALUE>c'avrò perso un mese a capire chi cacchio era sto monsignor dati</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1650" ANNOTATION_REF="a1649">
                <ANNOTATION_VALUE>poi so' andato a controllare il manoscritto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1652" ANNOTATION_REF="a1651">
                <ANNOTATION_VALUE>ed è monsignor datario,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1654" ANNOTATION_REF="a1653">
                <ANNOTATION_VALUE>il datario pontificio era una carica importante all'interno del pontificato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1656" ANNOTATION_REF="a1655">
                <ANNOTATION_VALUE>e non c'entra niente con il supposto monsignor dati.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1658" ANNOTATION_REF="a1657">
                <ANNOTATION_VALUE>però c'è uno che ha letto male,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1660" ANNOTATION_REF="a1659">
                <ANNOTATION_VALUE>l'ha trascritta male,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1662" ANNOTATION_REF="a1661">
                <ANNOTATION_VALUE>n'altra cosa, mi so' trovato l'altro giorno, sempre con una x su cui sto impazzendo, per la treccani,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1664" ANNOTATION_REF="a1663">
                <ANNOTATION_VALUE>c'era un certo monsignor (diserve)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1666" ANNOTATION_REF="a1665">
                <ANNOTATION_VALUE>°insomma non si capiva chi era sto benedetto monsignor (diserve),° ci stavo impazzendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1668" ANNOTATION_REF="a1667">
                <ANNOTATION_VALUE>su una vicenda di uno che era andato in un convento, bernardino telesio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1670" ANNOTATION_REF="a1669">
                <ANNOTATION_VALUE>(non si capisce) c'ho perso, non avete idea di quanto tempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1672" ANNOTATION_REF="a1671">
                <ANNOTATION_VALUE>a un certo punto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1674" ANNOTATION_REF="a1673">
                <ANNOTATION_VALUE>vedo che questa abbazia (che) era di un certo monsignor campeggi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1676" ANNOTATION_REF="a1675">
                <ANNOTATION_VALUE>apro il file, (.) e mi esce, monsignor campeggi, vescovo di fe:ltre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1678" ANNOTATION_REF="a1677">
                <ANNOTATION_VALUE>e mi è venuto un lampo negli occhi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1680" ANNOTATION_REF="a1679">
                <ANNOTATION_VALUE>selve, feltre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1682" ANNOTATION_REF="a1681">
                <ANNOTATION_VALUE>si era sbagliato a leggere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1684" ANNOTATION_REF="a1683">
                <ANNOTATION_VALUE>era monsignor di feltre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1686" ANNOTATION_REF="a1685">
                <ANNOTATION_VALUE>cioè la esse, che possa sembrare una effe, (.) nella scrittura cinquecentesca, è il minimo che possa accadere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1688" ANNOTATION_REF="a1687">
                <ANNOTATION_VALUE>perché so' scritte quasi uguali</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1690" ANNOTATION_REF="a1689">
                <ANNOTATION_VALUE>e che una ti erre, possa dare una vi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1692" ANNOTATION_REF="a1691">
                <ANNOTATION_VALUE>allora ti erre,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1694" ANNOTATION_REF="a1693">
                <ANNOTATION_VALUE>non ci vuole niente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1696" ANNOTATION_REF="a1695">
                <ANNOTATION_VALUE>e però da questi errorucci, (.) poi, (.) xxx infini:ti, erro:ri seguono</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1698" ANNOTATION_REF="a1697">
                <ANNOTATION_VALUE>e questo è proprio il classico, esempio, che è appunto del discorso della filologia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1700" ANNOTATION_REF="a1699">
                <ANNOTATION_VALUE>il copista, poteva capire una parola male.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1702" ANNOTATION_REF="a1701">
                <ANNOTATION_VALUE>e ti ribaltava il senso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1704" ANNOTATION_REF="a1703">
                <ANNOTATION_VALUE>della cosa che aveva scritto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1706" ANNOTATION_REF="a1705">
                <ANNOTATION_VALUE>quindi, è stata un'attività fondamentale, per la cultura occidentale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1708" ANNOTATION_REF="a1707">
                <ANNOTATION_VALUE>ma vi ripeto, non è solo il discorso di riportare il cicerone, l'ovidio:, orazio::, tibullo e catullo e tutti quelli che volete</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1710" ANNOTATION_REF="a1709">
                <ANNOTATION_VALUE>alla versione originaria</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1712" ANNOTATION_REF="a1711">
                <ANNOTATION_VALUE>non è stato solo quello.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1714" ANNOTATION_REF="a1713">
                <ANNOTATION_VALUE>perché appunto quest'attitudine alla critica, porterà ben presto all'estensione della critica nei confronti del fatto religioso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1716" ANNOTATION_REF="a1715">
                <ANNOTATION_VALUE>oppure nei confronti del fatto politico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1718" ANNOTATION_REF="a1717">
                <ANNOTATION_VALUE>ed entrambe le cose sono per esempio presenti nella celeberrima dimostrazione della falsità della cosiddetta donazione di costantino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1720" ANNOTATION_REF="a1719">
                <ANNOTATION_VALUE>da parte del più grande di tutti gli umanisti, che è stato lorenzo valla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1722" ANNOTATION_REF="a1721">
                <ANNOTATION_VALUE>lorenzo valla, in questo testo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1724" ANNOTATION_REF="a1723">
                <ANNOTATION_VALUE>de falso ed ementita donatione costantini,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1726" ANNOTATION_REF="a1725">
                <ANNOTATION_VALUE>di che cosa parla?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1728" ANNOTATION_REF="a1727">
                <ANNOTATION_VALUE>sapete che cos'è la donazione di costantino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1730" ANNOTATION_REF="a1729">
                <ANNOTATION_VALUE>allora a un certo punto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1732" ANNOTATION_REF="a1731">
                <ANNOTATION_VALUE>nel medioevo c'è la lotta fra papato e impero,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1734" ANNOTATION_REF="a1733">
                <ANNOTATION_VALUE>questo ce l'avete presente diciamo no,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1736" ANNOTATION_REF="a1735">
                <ANNOTATION_VALUE>guelfi e ghibellini,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1738" ANNOTATION_REF="a1737">
                <ANNOTATION_VALUE>il papato, (.) reclama, (.) la proprietà, (.) dell'impero d'occidente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1740" ANNOTATION_REF="a1739">
                <ANNOTATION_VALUE>di tutto l'occidente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1742" ANNOTATION_REF="a1741">
                <ANNOTATION_VALUE>non solo di roma, non solo dell'italia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1744" ANNOTATION_REF="a1743">
                <ANNOTATION_VALUE>tutto, l'occidente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1746" ANNOTATION_REF="a1745">
                <ANNOTATION_VALUE>e perché la reclama?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1748" ANNOTATION_REF="a1747">
                <ANNOTATION_VALUE>perché c'è un testo, (.) la donazione di costantino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1750" ANNOTATION_REF="a1749">
                <ANNOTATION_VALUE>era evidente, che a un certo punto, l'imperatore costantino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1752" ANNOTATION_REF="a1751">
                <ANNOTATION_VALUE>xxxx</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1754" ANNOTATION_REF="a1753">
                <ANNOTATION_VALUE>a un certo punto s'(era ammalato di lebbra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1756" ANNOTATION_REF="a1755">
                <ANNOTATION_VALUE>si era ammalato di lebbra, stava morendo, arriva il papa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1758" ANNOTATION_REF="a1757">
                <ANNOTATION_VALUE>silvestro primo, quello che celebriamo la notte di capodanno, la notte di san silvestro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1760" ANNOTATION_REF="a1759">
                <ANNOTATION_VALUE>e lo guarisce dalla lebbra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1762" ANNOTATION_REF="a1761">
                <ANNOTATION_VALUE>allora costantino, (.) che era tanto generoso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1764" ANNOTATION_REF="a1763">
                <ANNOTATION_VALUE>dice, guarda sai che c'è, grazie che mi hai guarito dalla lebbra, ti regalo l'impero d'occidente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1766" ANNOTATION_REF="a1765">
                <ANNOTATION_VALUE>così è</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1768" ANNOTATION_REF="a1767">
                <ANNOTATION_VALUE>ebbene, per qualche secolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1770" ANNOTATION_REF="a1769">
                <ANNOTATION_VALUE>ci sono tomi e tomi e tomi in cui diciamo i difensori della potestà papale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1772" ANNOTATION_REF="a1771">
                <ANNOTATION_VALUE>e allora qua non c'è discorso, ce l'avete donata voi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1774" ANNOTATION_REF="a1773">
                <ANNOTATION_VALUE>cioè l'imperatore laico, c'ha donato a noi, al capo religioso l'impero d'occidente, quindi qual è il problema?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1776" ANNOTATION_REF="a1775">
                <ANNOTATION_VALUE>che vi ritirate il regalo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1778" ANNOTATION_REF="a1777">
                <ANNOTATION_VALUE>questa è una cosa che va avanti per secoli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1780" ANNOTATION_REF="a1779">
                <ANNOTATION_VALUE>fin quando,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1782" ANNOTATION_REF="a1781">
                <ANNOTATION_VALUE>già diciamo il cardinale nicolò cusano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1784" ANNOTATION_REF="a1783">
                <ANNOTATION_VALUE>(l'umanista anche se vogliamo)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1786" ANNOTATION_REF="a1785">
                <ANNOTATION_VALUE>gli venne qualche dubietto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1788" ANNOTATION_REF="a1787">
                <ANNOTATION_VALUE>dice, ma siamo sicuri che è vera, che è autentica, questa donazione di costantino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1790" ANNOTATION_REF="a1789">
                <ANNOTATION_VALUE>fin quando, non arrivò, lorenzo valla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1792" ANNOTATION_REF="a1791">
                <ANNOTATION_VALUE>e allora lorenzo valla, utilizzò, semplicemente gli strumenti della filologia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1794" ANNOTATION_REF="a1793">
                <ANNOTATION_VALUE>e dimostrò, che era un falso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1796" ANNOTATION_REF="a1795">
                <ANNOTATION_VALUE>un falso clamoroso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1798" ANNOTATION_REF="a1797">
                <ANNOTATION_VALUE>un falso probabilmente risalente, (.) al nono secolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1800" ANNOTATION_REF="a1799">
                <ANNOTATION_VALUE>l'ottavo secolo, l'ottocento, il novecento, dopo cristo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1802" ANNOTATION_REF="a1801">
                <ANNOTATION_VALUE>e come se ne accorge?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1804" ANNOTATION_REF="a1803">
                <ANNOTATION_VALUE>se ne accorge, semplicemente perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1806" ANNOTATION_REF="a1805">
                <ANNOTATION_VALUE>comincia a fare un'analisi linguistica, per esempio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1808" ANNOTATION_REF="a1807">
                <ANNOTATION_VALUE>e allora si rende conto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1810" ANNOTATION_REF="a1809">
                <ANNOTATION_VALUE>dice a un certo punto, il baglivo gli ha da~,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1812" ANNOTATION_REF="a1811">
                <ANNOTATION_VALUE>dice no quale baglivo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1814" ANNOTATION_REF="a1813">
                <ANNOTATION_VALUE>il baglivo è u:n:, una carica amministrativa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1816" ANNOTATION_REF="a1815">
                <ANNOTATION_VALUE>che viene inventata nel medioevo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1818" ANNOTATION_REF="a1817">
                <ANNOTATION_VALUE>non c'era ai tempi di costantino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1820" ANNOTATION_REF="a1819">
                <ANNOTATION_VALUE>dice, poi sono andati a costantinopoli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1822" ANNOTATION_REF="a1821">
                <ANNOTATION_VALUE>dice, no quale costantinopoli, quella si chiamava bisanzio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1824" ANNOTATION_REF="a1823">
                <ANNOTATION_VALUE>poi dopo, si è chiamata costantinopoli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1826" ANNOTATION_REF="a1825">
                <ANNOTATION_VALUE>ma se il documento risale all'epoca di costantino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1828" ANNOTATION_REF="a1827">
                <ANNOTATION_VALUE>bisanzio, si deve chiamare, se non chiama bisanzio, c'è qualcosa che non va.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1830" ANNOTATION_REF="a1829">
                <ANNOTATION_VALUE>andando avanti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1832" ANNOTATION_REF="a1831">
                <ANNOTATION_VALUE>parola per parola, parola per parola,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1834" ANNOTATION_REF="a1833">
                <ANNOTATION_VALUE>valla dimostra che è impossibile,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1836" ANNOTATION_REF="a1835">
                <ANNOTATION_VALUE>che quel testo possa risalire all'antichità romana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1838" ANNOTATION_REF="a1837">
                <ANNOTATION_VALUE>è impossibile.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1840" ANNOTATION_REF="a1839">
                <ANNOTATION_VALUE>ed è 'na bomba termonucleare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1842" ANNOTATION_REF="a1841">
                <ANNOTATION_VALUE>non è 'na cosetta così,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1844" ANNOTATION_REF="a1843">
                <ANNOTATION_VALUE>e valla lo sa bene, guardate vi leggo, giusto per capire cosa volesse dire criticare la te~ la la chiesa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1846" ANNOTATION_REF="a1845">
                <ANNOTATION_VALUE>vi leggo come comincia valla il suo, (.) favoloso pamphlet.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1848" ANNOTATION_REF="a1847">
                <ANNOTATION_VALUE>ci sono di que~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1850" ANNOTATION_REF="a1849">
                <ANNOTATION_VALUE>è una traduzione italiana naturalmente era scritto in latino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1852" ANNOTATION_REF="a1851">
                <ANNOTATION_VALUE>ci sono di quelli che mal mi sopportano, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1854" ANNOTATION_REF="a1853">
                <ANNOTATION_VALUE>e mi accusano di sacrilega temerarietà, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1856" ANNOTATION_REF="a1855">
                <ANNOTATION_VALUE>perché nei moltissimi libri da me pubblicati, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1858" ANNOTATION_REF="a1857">
                <ANNOTATION_VALUE>io dissento da non pochi grandi autori, già da tempo apprezzati. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1860" ANNOTATION_REF="a1859">
                <ANNOTATION_VALUE>e quindi già qui che cosa c'è?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1862" ANNOTATION_REF="a1861">
                <ANNOTATION_VALUE>è il rovesciamento del principio d'autorità,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1864" ANNOTATION_REF="a1863">
                <ANNOTATION_VALUE>è il principio d'autortià quello che valeva, ve lo dicevo ieri,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1866" ANNOTATION_REF="a1865">
                <ANNOTATION_VALUE>siccome l'ha detto un autore precendete, ipse dixit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1868" ANNOTATION_REF="a1867">
                <ANNOTATION_VALUE>e il valla sa perfettamente, a me non mi sopportano, perché a me dell'ipse dixit non me ne frega niente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
