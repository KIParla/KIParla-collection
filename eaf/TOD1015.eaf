            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a556" ANNOTATION_REF="a555">
                <ANNOTATION_VALUE>nella sua opera essai sur les mœurs, saggio sui costumi e sullo spirito delle nazioni,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a557">
                <ANNOTATION_VALUE>voltaire vede una vera e propria svolta nell'epoca rinascimentale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a559">
                <ANNOTATION_VALUE>cioè pone un momento periodizzante nell'epoca rinascimentale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a561">
                <ANNOTATION_VALUE>e qualche anno dopo, quando questa visione storiografica si perfezionerà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a563">
