        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2224" ANNOTATION_REF="a2223">
                <ANNOTATION_VALUE>dove l'ha scritta sta frase machivelli?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2226" ANNOTATION_REF="a2225">
                <ANNOTATION_VALUE>non l'ha mai scritta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2228" ANNOTATION_REF="a2227">
                <ANNOTATION_VALUE>non esiste questa frase.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2230" ANNOTATION_REF="a2229">
