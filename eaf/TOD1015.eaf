            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a427">
                <ANNOTATION_VALUE>contiene anche dei riferimenti proprio al rinascimento</ANNOTATION_VALUE>
