        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2128" ANNOTATION_REF="a2127">
                <ANNOTATION_VALUE>non è che lo dice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2130" ANNOTATION_REF="a2129">
