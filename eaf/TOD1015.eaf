        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a936" ANNOTATION_REF="a935">
                <ANNOTATION_VALUE>se alle nostre spalle, non avessimo i tempi barbarici, se questi non avessero durato così a lungo, povera europa, ((legge))</ANNOTATION_VALUE>
