            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1026" ANNOTATION_REF="a1025">
                <ANNOTATION_VALUE>c'era qualcosina nella domus aurea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1028" ANNOTATION_REF="a1027">
                <ANNOTATION_VALUE>ma non era stata ancora riscoperta pompei,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1030" ANNOTATION_REF="a1029">
                <ANNOTATION_VALUE>ci vorrà il settecento per riscoprire pompei,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1032" ANNOTATION_REF="a1031">
                <ANNOTATION_VALUE>e quindi i pittori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1034" ANNOTATION_REF="a1033">
                <ANNOTATION_VALUE>contrariamente agli architetti e agli scultori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1036" ANNOTATION_REF="a1035">
                <ANNOTATION_VALUE>non c'avevano, diciamo, un esempio da imitare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1038" ANNOTATION_REF="a1037">
                <ANNOTATION_VALUE>certo, per esempio, botticelli, e::h fece la la calunnia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1040" ANNOTATION_REF="a1039">
                <ANNOTATION_VALUE>la calunnia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1042" ANNOTATION_REF="a1041">
                <ANNOTATION_VALUE>un dipinto di botticelli è esemplato sul racconto di un quadro di apelle, (.) che fa lo scrittore antico luciano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1044" ANNOTATION_REF="a1043">
                <ANNOTATION_VALUE>però è 'na descrizione, è una descrizione verbale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1046" ANNOTATION_REF="a1045">
                <ANNOTATION_VALUE>per cui nella pittura, questo discorso, già questo discorso dell'imitazione si vede che vale fino a un certo punto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1048" ANNOTATION_REF="a1047">
                <ANNOTATION_VALUE>perché se fosse solo un fenomeno di imitazione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1050" ANNOTATION_REF="a1049">
                <ANNOTATION_VALUE>non ci sarebbe quasi nulla o nulla di creatività,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1052" ANNOTATION_REF="a1051">
                <ANNOTATION_VALUE>dove sarebbe la grandezza della stagione rinascimentale?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1054" ANNOTATION_REF="a1053">
                <ANNOTATION_VALUE>invece la pittura ci dimostra che eccome,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1056" ANNOTATION_REF="a1055">
                <ANNOTATION_VALUE>eccome se ci fo se ci fu un diciamo (.) e::h una creatività che portò versa un'età nuova</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1058" ANNOTATION_REF="a1057">
                <ANNOTATION_VALUE>poi per carità, (.) botticelli:: ha fatto la venere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1060" ANNOTATION_REF="a1059">
                <ANNOTATION_VALUE>pallade::: e::h venere e marte, pallade (il) centauro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1062" ANNOTATION_REF="a1061">
                <ANNOTATION_VALUE>cioè ci sono i temi mitologici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1064" ANNOTATION_REF="a1063">
                <ANNOTATION_VALUE>e questi li vedremo diffondersi nel quattrocento, nel cinquecento, nel seicento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1066" ANNOTATION_REF="a1065">
                <ANNOTATION_VALUE>ma temi mitologici, (.) dipinti da loro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1068" ANNOTATION_REF="a1067">
