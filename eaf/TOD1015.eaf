            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3690" ANNOTATION_REF="a3689">
                <ANNOTATION_VALUE>quel discorso religioso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3692" ANNOTATION_REF="a3691">
                <ANNOTATION_VALUE>però era un discorso religioso. e in quanto tale, aveva credito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3694" ANNOTATION_REF="a3693">
                <ANNOTATION_VALUE>cioè la religione serve,</ANNOTATION_VALUE>
