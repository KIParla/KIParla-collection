        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3672" ANNOTATION_REF="a3671">
                <ANNOTATION_VALUE>racconta un esempio che tutti, poi riporteranno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3674" ANNOTATION_REF="a3673">
                <ANNOTATION_VALUE>eh dice quand~ dopo romolo::, come si chiama il seco~, servio tullio, come si chiama il secondo: re di roma?</ANNOTATION_VALUE>
