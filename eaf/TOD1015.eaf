            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2178" ANNOTATION_REF="a2177">
                <ANNOTATION_VALUE>però nel momento in cui la filologia dimostra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2180" ANNOTATION_REF="a2179">
                <ANNOTATION_VALUE>la falsità di qualcosa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2182" ANNOTATION_REF="a2181">
                <ANNOTATION_VALUE>è facile poi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2184" ANNOTATION_REF="a2183">
                <ANNOTATION_VALUE>che ci sia qualcuno che ne trae le conseguenze in termini politici, che ne trae le conseguenze in termini religiosi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2186" ANNOTATION_REF="a2185">
                <ANNOTATION_VALUE>quindi la critica, entra ormai a pieno titolo,</ANNOTATION_VALUE>
