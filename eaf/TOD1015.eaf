            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2084" ANNOTATION_REF="a2083">
                <ANNOTATION_VALUE>viene sancito nel quarto secolo dopo cristo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2086" ANNOTATION_REF="a2085">
                <ANNOTATION_VALUE>mica quando c'è la chiesa di gesù,</ANNOTATION_VALUE>
