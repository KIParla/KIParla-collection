        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2210" ANNOTATION_REF="a2209">
                <ANNOTATION_VALUE>qual è la frase, simbolo, di machiavelli?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2212" ANNOTATION_REF="a2211">
