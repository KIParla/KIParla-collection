            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a531">
                <ANNOTATION_VALUE>quindi questo forse va bene, perché noi italiani non siamo sempre così bravi a valorizzare le nostre bellezze</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
