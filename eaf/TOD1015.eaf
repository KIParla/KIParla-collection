            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a465">
                <ANNOTATION_VALUE>sarebbe ingiusto, da parte nostra, (.) noi francesi, (.) non riconoscere il nostro debito verso l'italia. ((legge))</ANNOTATION_VALUE>
