            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a435">
                <ANNOTATION_VALUE>l'invenzione della stampa, la produzione dei medici e di francesco primo rianimano gli spiriti ((legge))</ANNOTATION_VALUE>
