            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2132" ANNOTATION_REF="a2131">
                <ANNOTATION_VALUE>toglie diciamo nella sua edizione del vangelo, elimina, quella parte che sembrava ammettere il pensiero trinitario.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
