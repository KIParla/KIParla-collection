            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2156" ANNOTATION_REF="a2155">
                <ANNOTATION_VALUE>è stato costretto a farlo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2158" ANNOTATION_REF="a2157">
                <ANNOTATION_VALUE>ma, gli eretici successivi sapranno bene,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2160" ANNOTATION_REF="a2159">
