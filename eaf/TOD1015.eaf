        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2088" ANNOTATION_REF="a2087">
                <ANNOTATION_VALUE>gesù dice, oh io sono la seconda persona della trinità eh, l'avete capito?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2090" ANNOTATION_REF="a2089">
                <ANNOTATION_VALUE>eh questo non esiste.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2092" ANNOTATION_REF="a2091">
                <ANNOTATION_VALUE>e non lo dice nessuno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2094" ANNOTATION_REF="a2093">
                <ANNOTATION_VALUE>salvo finché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2096" ANNOTATION_REF="a2095">
                <ANNOTATION_VALUE>il vescovo (avio), comincia la disputa ariana, che ovviamente non centra niente con gli ariani dei nazisti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2098" ANNOTATION_REF="a2097">
                <ANNOTATION_VALUE>comincia la disputa ariana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2100" ANNOTATION_REF="a2099">
                <ANNOTATION_VALUE>e dice, non è vero che gesù è dio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2102" ANNOTATION_REF="a2101">
