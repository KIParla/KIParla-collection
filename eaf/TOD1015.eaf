        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3682" ANNOTATION_REF="a3681">
                <ANNOTATION_VALUE>dice, servo tullio, fingeva,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3684" ANNOTATION_REF="a3683">
                <ANNOTATION_VALUE>di nascondersi con una ni::, (.) con una ninfa, dice che parla~ fingeva di parlare con una ninfa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3686" ANNOTATION_REF="a3685">
                <ANNOTATION_VALUE>poi quando ritornava:, diciamo in pubblico, dice, eh la ninfa mi ha detto di fare così e colì. e aveva credito, perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3688" ANNOTATION_REF="a3687">
