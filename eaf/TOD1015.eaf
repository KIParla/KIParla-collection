        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2188" ANNOTATION_REF="a2187">
                <ANNOTATION_VALUE>nella concezione degli europei,</ANNOTATION_VALUE>
