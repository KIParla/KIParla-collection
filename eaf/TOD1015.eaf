            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2072" ANNOTATION_REF="a2071">
                <ANNOTATION_VALUE>e valla gli diceva, ma che vol dì persone?</ANNOTATION_VALUE>
