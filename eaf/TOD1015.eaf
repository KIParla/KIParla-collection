        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2120" ANNOTATION_REF="a2119">
                <ANNOTATION_VALUE>dio è uno, e trino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2122" ANNOTATION_REF="a2121">
                <ANNOTATION_VALUE>è n'invenzione, (.) dell'epoca, diciamo, della presunta donazione di costantino.</ANNOTATION_VALUE>
