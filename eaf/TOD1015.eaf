        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3670" ANNOTATION_REF="a3669">
                <ANNOTATION_VALUE>per esempio machiavelli,</ANNOTATION_VALUE>
