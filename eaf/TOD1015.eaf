            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3714" ANNOTATION_REF="a3713">
                <ANNOTATION_VALUE>la quale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3716" ANNOTATION_REF="a3715">
                <ANNOTATION_VALUE>se nei principi della repubblica cristiana si fosse mantenuta,</ANNOTATION_VALUE>
