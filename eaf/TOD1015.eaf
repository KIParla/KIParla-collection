            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2170" ANNOTATION_REF="a2169">
                <ANNOTATION_VALUE>che porranno le basi, diciamo delle libertà moderne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2172" ANNOTATION_REF="a2171">
