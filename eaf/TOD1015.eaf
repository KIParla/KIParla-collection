        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2214" ANNOTATION_REF="a2213">
                <ANNOTATION_VALUE>non ho sentito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2216" ANNOTATION_REF="a2215">
                <ANNOTATION_VALUE>qualcuno se la ricorda meglio?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2218" ANNOTATION_REF="a2217">
                <ANNOTATION_VALUE>il fine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2220" ANNOTATION_REF="a2219">
                <ANNOTATION_VALUE>ahò</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2222" ANNOTATION_REF="a2221">
                <ANNOTATION_VALUE>il fine giustifica i mezzi.</ANNOTATION_VALUE>
