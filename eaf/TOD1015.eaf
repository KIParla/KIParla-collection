        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2068" ANNOTATION_REF="a2067">
                <ANNOTATION_VALUE>lo sapete la trinità è composta da tre persone,</ANNOTATION_VALUE>
