        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2136" ANNOTATION_REF="a2135">
                <ANNOTATION_VALUE>tanto che in una successiva edizione, erasmo dice, vabbé,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2138" ANNOTATION_REF="a2137">
                <ANNOTATION_VALUE>considerate le reazioni che ci sono state,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2140" ANNOTATION_REF="a2139">
                <ANNOTATION_VALUE>io lo rimetto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2142" ANNOTATION_REF="a2141">
                <ANNOTATION_VALUE>ma lo dice in una nota, dice, guardate so' state le reazioni.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2144" ANNOTATION_REF="a2143">
                <ANNOTATION_VALUE>quindi pe' carità, se tanto vi dà scandalo, eccovi il comma johanneum,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2146" ANNOTATION_REF="a2145">
                <ANNOTATION_VALUE>però io vi ripeto nella nota, che quello non c'è.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2148" ANNOTATION_REF="a2147">
                <ANNOTATION_VALUE>e quindi è una forma anche di dissimulazione,</ANNOTATION_VALUE>
