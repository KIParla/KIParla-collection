        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2190" ANNOTATION_REF="a2189">
                <ANNOTATION_VALUE>e ben presto quella critica,</ANNOTATION_VALUE>
