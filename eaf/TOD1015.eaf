        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2192" ANNOTATION_REF="a2191">
                <ANNOTATION_VALUE>diventa critica religiosa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2194" ANNOTATION_REF="a2193">
                <ANNOTATION_VALUE>e la critica religiosa ben presto si affianca alla critica politica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2196" ANNOTATION_REF="a2195">
                <ANNOTATION_VALUE>e si preparano le basi per le grandi stagioni rivoluzionarie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2198" ANNOTATION_REF="a2197">
                <ANNOTATION_VALUE>da noi sono cose che 'nsomma avvengono, in modo complicato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2200" ANNOTATION_REF="a2199">
