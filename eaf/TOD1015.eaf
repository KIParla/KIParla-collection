        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3660" ANNOTATION_REF="a3659">
                <ANNOTATION_VALUE>cioè, (.) lui lu~ (.) lo dice che, (.) (i)nsomma per lui è falsa, la religione.</ANNOTATION_VALUE>
