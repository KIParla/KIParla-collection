            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a491">
                <ANNOTATION_VALUE>e basta andare al faubourg saint honoré o all'avenue montaigne, per le strade del grande lusso parigino per vedere quasi sono diciamo le grandi griffe e quanto l'italia conta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a493">
                <ANNOTATION_VALUE>e infine appunto, il rinascimento</ANNOTATION_VALUE>
