        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3638" ANNOTATION_REF="a3637">
                <ANNOTATION_VALUE>lui dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3640" ANNOTATION_REF="a3639">
