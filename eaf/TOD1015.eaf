        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2422" ANNOTATION_REF="a2421">
                <ANNOTATION_VALUE>scaltro, del machiavelli soprattutto fautore del principe, assolutistico, senza nessuna:::, nessuno:: scrupolo:,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2424" ANNOTATION_REF="a2423">
                <ANNOTATION_VALUE>può ammazzare, avvelenare, chiunque voglia, il massimo del principato assoluto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2426" ANNOTATION_REF="a2425">
                <ANNOTATION_VALUE>poi uno si va a leggere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2428" ANNOTATION_REF="a2427">
                <ANNOTATION_VALUE>l'altra grande opera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2430" ANNOTATION_REF="a2429">
                <ANNOTATION_VALUE>principale opera di machiavelli, che sono i discorsi sopra la prima deca di tito livio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2432" ANNOTATION_REF="a2431">
                <ANNOTATION_VALUE>e apre tipo al capitolo cinquantotto, e legge,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2434" ANNOTATION_REF="a2433">
                <ANNOTATION_VALUE>questo titolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2436" ANNOTATION_REF="a2435">
                <ANNOTATION_VALUE>la moltitudine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2438" ANNOTATION_REF="a2437">
                <ANNOTATION_VALUE>(cioè la plebe)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2440" ANNOTATION_REF="a2439">
                <ANNOTATION_VALUE>la massa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2442" ANNOTATION_REF="a2441">
                <ANNOTATION_VALUE>è più savia, e più costante, (.) che uno principe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2444" ANNOTATION_REF="a2443">
                <ANNOTATION_VALUE>ma come machiavelli ha scritto il principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2446" ANNOTATION_REF="a2445">
                <ANNOTATION_VALUE>e qua viene a scrivere che la moltitudine è meglio del principe?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2448" ANNOTATION_REF="a2447">
                <ANNOTATION_VALUE>comincia ad emergere qualche problema sull'immagine di machiavelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2450" ANNOTATION_REF="a2449">
                <ANNOTATION_VALUE>e leggiamo un po' di questo capitoletto, che è molto istruttivo e sintetizza moltissime, delle idee,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2452" ANNOTATION_REF="a2451">
                <ANNOTATION_VALUE>chiave, cardine, di machiavelli, (.) del vero machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2454" ANNOTATION_REF="a2453">
                <ANNOTATION_VALUE>nessuna cosa, essere più vaga e più incostante che la moltitudine.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2456" ANNOTATION_REF="a2455">
                <ANNOTATION_VALUE>così, tito livio nostro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2458" ANNOTATION_REF="a2457">
                <ANNOTATION_VALUE>questi sono i commenti sui libri di livio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2460" ANNOTATION_REF="a2459">
                <ANNOTATION_VALUE>come tutti gli altri storici affermano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2462" ANNOTATION_REF="a2461">
                <ANNOTATION_VALUE>allora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2464" ANNOTATION_REF="a2463">
                <ANNOTATION_VALUE>questo dovete aver presente, che machiavelli quasi sempre,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2466" ANNOTATION_REF="a2465">
                <ANNOTATION_VALUE>dice, (.) c'è sta tesi che, è diffusissima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2468" ANNOTATION_REF="a2467">
                <ANNOTATION_VALUE>io la conosco benissimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2470" ANNOTATION_REF="a2469">
                <ANNOTATION_VALUE>xxx</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2472" ANNOTATION_REF="a2471">
                <ANNOTATION_VALUE>io lo so, (.) che dirò una cosa totalmente nuova.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2474" ANNOTATION_REF="a2473">
                <ANNOTATION_VALUE>ma la dico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2476" ANNOTATION_REF="a2475">
                <ANNOTATION_VALUE>è quello che voglio fare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2478" ANNOTATION_REF="a2477">
                <ANNOTATION_VALUE>cioè lui ha una totale, coscienza, della profondissima innovazione, che apporta alla cultura politica europea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2480" ANNOTATION_REF="a2479">
                <ANNOTATION_VALUE>machiavelli è il vero, e proprio fondatore, della politica moderna. del discorso, politico moderno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2482" ANNOTATION_REF="a2481">
                <ANNOTATION_VALUE>sia per la sua eno:rme diffusione, a cui vi accennavo prima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2484" ANNOTATION_REF="a2483">
                <ANNOTATION_VALUE>tutti, hanno letto machiavelli nell'età moderna, tutti quelli che contavano, tutti quello che diciamo avevano qualcosa da dire. tutti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2486" ANNOTATION_REF="a2485">
                <ANNOTATION_VALUE>e soprattutto pone una serie di questioni, che fino a quel momento, nessuno aveva mai posto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2488" ANNOTATION_REF="a2487">
                <ANNOTATION_VALUE>dire all'epoca, che la plebe, la moltitudine, quanto di peggio ci fosse al mondo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2490" ANNOTATION_REF="a2489">
                <ANNOTATION_VALUE>tutti, xxx degli umanisti, (ma anche) la vile plebe, che all'epoca erano veramente delle bestie (i)nsomma eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2492" ANNOTATION_REF="a2491">
                <ANNOTATION_VALUE>machiavelli, (.) dice, (.) tutti dicono così.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2494" ANNOTATION_REF="a2493">
                <ANNOTATION_VALUE>vediamo come va avanti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2496" ANNOTATION_REF="a2495">
                <ANNOTATION_VALUE>io non so se mi prenderò una provincia, nel senso una tema,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2498" ANNOTATION_REF="a2497">
                <ANNOTATION_VALUE>dura, e piena di tanta difficoltà che mi convenga, o abbandonarla con vergogna, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2500" ANNOTATION_REF="a2499">
                <ANNOTATION_VALUE>o seguirla con carico, con difficoltà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2502" ANNOTATION_REF="a2501">
                <ANNOTATION_VALUE>volendo difendere una cosa, la quale, come ho detto, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2504" ANNOTATION_REF="a2503">
                <ANNOTATION_VALUE>da tutti gli scrittori è accusata. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2506" ANNOTATION_REF="a2505">
                <ANNOTATION_VALUE>cioè l'incostanza della plebe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2508" ANNOTATION_REF="a2507">
                <ANNOTATION_VALUE>ma comunque si sia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2510" ANNOTATION_REF="a2509">
                <ANNOTATION_VALUE>io non giudico, né giudicherò mai essere diffetto, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2512" ANNOTATION_REF="a2511">
                <ANNOTATION_VALUE>difendere alcuna opinione, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2514" ANNOTATION_REF="a2513">
                <ANNOTATION_VALUE>opinione, con le ragioni. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2516" ANNOTATION_REF="a2515">
                <ANNOTATION_VALUE>senza volervi usare l'autorità o la forza. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2518" ANNOTATION_REF="a2517">
                <ANNOTATION_VALUE>anche questo, vedete quest'uso del termine ragione.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2520" ANNOTATION_REF="a2519">
                <ANNOTATION_VALUE>noi di solito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2522" ANNOTATION_REF="a2521">
                <ANNOTATION_VALUE>riallacciamo il razionalismo all'illuminismo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2524" ANNOTATION_REF="a2523">
                <ANNOTATION_VALUE>ma ancora qui, durante il rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2526" ANNOTATION_REF="a2525">
                <ANNOTATION_VALUE>il termine ragione compare moltissimo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2528" ANNOTATION_REF="a2527">
                <ANNOTATION_VALUE>cioè che gli uomini si mettano a ragionare con la propria testa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2530" ANNOTATION_REF="a2529">
                <ANNOTATION_VALUE>è uno dei caratteri del rinascimento. e lo vediamo qua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2532" ANNOTATION_REF="a2531">
                <ANNOTATION_VALUE>come machiavelli ci dice, ma io difendo un'opinione con le ragioni, e non con la forza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2534" ANNOTATION_REF="a2533">
                <ANNOTATION_VALUE>e su questo io non mi tiro mai indietro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2536" ANNOTATION_REF="a2535">
                <ANNOTATION_VALUE>e allora dico adunque, come di quello difetto, di cui accusano gli scrittori la moltitudine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2538" ANNOTATION_REF="a2537">
                <ANNOTATION_VALUE>se ne possono accusare tutti gli uomini,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2540" ANNOTATION_REF="a2539">
                <ANNOTATION_VALUE>e massimi i principi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2542" ANNOTATION_REF="a2541">
                <ANNOTATION_VALUE>perché ciascuno che non sia regolato dall leggi, farebbe quelli medesimi errori che la moltitudine sciolta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2544" ANNOTATION_REF="a2543">
                <ANNOTATION_VALUE>e già qui c'è un elemento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2546" ANNOTATION_REF="a2545">
                <ANNOTATION_VALUE>come le leggi? ma machiavelli è l'autore del principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2548" ANNOTATION_REF="a2547">
                <ANNOTATION_VALUE>e della violazione della norma sistematica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2550" ANNOTATION_REF="a2549">
                <ANNOTATION_VALUE>e invece no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2552" ANNOTATION_REF="a2551">
                <ANNOTATION_VALUE>machiavelli è uno dei primissimi autori del pensiero politico europeo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2554" ANNOTATION_REF="a2553">
                <ANNOTATION_VALUE>che ricomincia a porre al centro del proprio discorso, la supremazia della legge.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2556" ANNOTATION_REF="a2555">
                <ANNOTATION_VALUE>le legge è sovrana, è suprema, (.) e tutti, devono obbedire alla leggi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2558" ANNOTATION_REF="a2557">
                <ANNOTATION_VALUE>comincia quel discorso a cui vi accennavo ieri, cioè per la tutela della stessa libertà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2560" ANNOTATION_REF="a2559">
                <ANNOTATION_VALUE>c'è bisogno di leggi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2562" ANNOTATION_REF="a2561">
                <ANNOTATION_VALUE>se no ognuno può fare quello che vuole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2564" ANNOTATION_REF="a2563">
                <ANNOTATION_VALUE>e quello che vuole può voler dire pure che uno m'(ammazza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2566" ANNOTATION_REF="a2565">
                <ANNOTATION_VALUE>questo non è che sia proprio il massimo della tutela dell'individuo diciamo no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2568" ANNOTATION_REF="a2567">
                <ANNOTATION_VALUE>allora dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2570" ANNOTATION_REF="a2569">
                <ANNOTATION_VALUE>possono errare, (.) sia gli uni, (.) che gli altri.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2572" ANNOTATION_REF="a2571">
                <ANNOTATION_VALUE>sia la moltitudine, che i principi. già comincia a mettere un po' in crisi, sto fatto che la moltitudine è vana e incostante.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2574" ANNOTATION_REF="a2573">
                <ANNOTATION_VALUE>e allora dice, quando succedono de:i,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2576" ANNOTATION_REF="a2575">
                <ANNOTATION_VALUE>problemi, dice quello che racconta tito livio sulla natura della moltitudine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2578" ANNOTATION_REF="a2577">
                <ANNOTATION_VALUE>non dice di quella che è regolata dalle leggi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2580" ANNOTATION_REF="a2579">
                <ANNOTATION_VALUE>ma della sciolta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2582" ANNOTATION_REF="a2581">
                <ANNOTATION_VALUE>la quale fa gli errori, che fanno gli uomini (infiurati) e sciolti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2584" ANNOTATION_REF="a2583">
                <ANNOTATION_VALUE>però non è da incolpare la natura della moltitudine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2586" ANNOTATION_REF="a2585">
                <ANNOTATION_VALUE>perché tutti possono errare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2588" ANNOTATION_REF="a2587">
                <ANNOTATION_VALUE>quando tutti, hanno la possibilità di farlo. nel senso che non ci sono le leggi e quindi gli è lecito fare qualunque cosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2590" ANNOTATION_REF="a2589">
                <ANNOTATION_VALUE>(conchiudo) dunque,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2592" ANNOTATION_REF="a2591">
                <ANNOTATION_VALUE>contro alla comune opinione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2594" ANNOTATION_REF="a2593">
                <ANNOTATION_VALUE>la quale dice come i popoli quando sono principi, cioè quando hanno il potere, quando c'è la democrazia, sono vari, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2596" ANNOTATION_REF="a2595">
                <ANNOTATION_VALUE>mutabili ed ingrati, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2598" ANNOTATION_REF="a2597">
                <ANNOTATION_VALUE>io dico che non ci siano questi difetti in loro, altrimenti che non siano nei principi particolari, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2600" ANNOTATION_REF="a2599">
                <ANNOTATION_VALUE>e accusando alcuni popoli ed i principi insieme, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2602" ANNOTATION_REF="a2601">
                <ANNOTATION_VALUE>potrebbe dire il vero, ma traendone i principi, si inganna. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2604" ANNOTATION_REF="a2603">
                <ANNOTATION_VALUE>perché, un popolo, che comandi e sia bene ordinato, sarà stabile, prudente e grato, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2606" ANNOTATION_REF="a2605">
                <ANNOTATION_VALUE>non altrimenti che un principe, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2608" ANNOTATION_REF="a2607">
                <ANNOTATION_VALUE>o meglio, che un principe. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2610" ANNOTATION_REF="a2609">
                <ANNOTATION_VALUE>e dall'altra parte, un principe sciolto dalle leggi, sarà ingrato, vario ed imprudente, ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2612" ANNOTATION_REF="a2611">
                <ANNOTATION_VALUE>più che il popolo. ((legge))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2614" ANNOTATION_REF="a2613">
                <ANNOTATION_VALUE>quindi, la variazione, non nasce dalla natura diversa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2616" ANNOTATION_REF="a2615">
                <ANNOTATION_VALUE>perché in tutti è in un modo. e se vi è vantaggio di bene,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2618" ANNOTATION_REF="a2617">
                <ANNOTATION_VALUE>è nel popolo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2620" ANNOTATION_REF="a2619">
                <ANNOTATION_VALUE>ma la variazione nasce, dall'avere più o meno rispetto alle leggi, dentro le quali, l'uno e l'altro vive.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2622" ANNOTATION_REF="a2621">
                <ANNOTATION_VALUE>e insomma, per (conchiudere) questa materia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2624" ANNOTATION_REF="a2623">
                <ANNOTATION_VALUE>dico, come hanno durato assai gli stati dei principi, hanno durato assai gli stati delle repubbliche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2626" ANNOTATION_REF="a2625">
                <ANNOTATION_VALUE>e l'uno e l'altro ha avuto bisogno di essere regolato dalle leggi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2628" ANNOTATION_REF="a2627">
                <ANNOTATION_VALUE>perché?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2630" ANNOTATION_REF="a2629">
                <ANNOTATION_VALUE>un principe, (.) che può fare ciò che vuole,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2632" ANNOTATION_REF="a2631">
                <ANNOTATION_VALUE>è pazzo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2634" ANNOTATION_REF="a2633">
                <ANNOTATION_VALUE>un popolo che può fare ciò che vuole,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2636" ANNOTATION_REF="a2635">
                <ANNOTATION_VALUE>non è savio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2638" ANNOTATION_REF="a2637">
                <ANNOTATION_VALUE>già la differenza, quello è proprio pazzo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2640" ANNOTATION_REF="a2639">
                <ANNOTATION_VALUE>il popolo non è savio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2642" ANNOTATION_REF="a2641">
                <ANNOTATION_VALUE>vedete come emerge questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2644" ANNOTATION_REF="a2643">
                <ANNOTATION_VALUE>favore di machiavelli per il popolo, non per il principe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2646" ANNOTATION_REF="a2645">
                <ANNOTATION_VALUE>e quando si vedrà, diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2648" ANNOTATION_REF="a2647">
                <ANNOTATION_VALUE>se adunque si ragionerà di un principe obbligato alle leggi ed un popolo incatenato da quelli, si vedrà più virtù nel pri~ nel popolo, che nel principe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2650" ANNOTATION_REF="a2649">
                <ANNOTATION_VALUE>se si ragionerà dell'uno e dell'altro sciolto dalle leggi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2652" ANNOTATION_REF="a2651">
                <ANNOTATION_VALUE>si vedranno meno errori nel popolo che nel principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2654" ANNOTATION_REF="a2653">
                <ANNOTATION_VALUE>e quelli minori, (.) ed avranno maggiori rimedi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2656" ANNOTATION_REF="a2655">
                <ANNOTATION_VALUE>e continua su questo tema.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2658" ANNOTATION_REF="a2657">
                <ANNOTATION_VALUE>cioè,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2660" ANNOTATION_REF="a2659">
                <ANNOTATION_VALUE>eh, (.) col principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2662" ANNOTATION_REF="a2661">
                <ANNOTATION_VALUE>c'è qualcosa che non va,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2664" ANNOTATION_REF="a2663">
                <ANNOTATION_VALUE>se noi leggiamo l'inizio del principe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2666" ANNOTATION_REF="a2665">
                <ANNOTATION_VALUE>il principe dice, tutti gli stati, tutti i domini che hanno, e che hanno avuto, imperi sopra gli uomini, sono stati e sono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2668" ANNOTATION_REF="a2667">
                <ANNOTATION_VALUE>o repubbliche, (.) o principati.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2670" ANNOTATION_REF="a2669">
                <ANNOTATION_VALUE>in questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2672" ANNOTATION_REF="a2671">
                <ANNOTATION_VALUE>celeberrimo esordio del principe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2674" ANNOTATION_REF="a2673">
                <ANNOTATION_VALUE>machiavelli rompe, con la tradizione classica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2676" ANNOTATION_REF="a2675">
                <ANNOTATION_VALUE>aristotelica, ancora una volta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2678" ANNOTATION_REF="a2677">
                <ANNOTATION_VALUE>che classificava le forme di governo in,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2680" ANNOTATION_REF="a2679">
                <ANNOTATION_VALUE>monarchia, aristocrazia, e democrazia, con le forme corrotte. tirannia, oligarchia, oclocrazia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2682" ANNOTATION_REF="a2681">
                <ANNOTATION_VALUE>ma, quella era una tipologia, che andava bene per l'antichità. nell'epoca di machiavelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2684" ANNOTATION_REF="a2683">
                <ANNOTATION_VALUE>o ci sono monarchie, o ci sono repubbliche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2686" ANNOTATION_REF="a2685">
                <ANNOTATION_VALUE>quindi diciamo, intanto, parte da un dato di realtà,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2688" ANNOTATION_REF="a2687">
                <ANNOTATION_VALUE>quello è uno dei concetti fondamentali,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2690" ANNOTATION_REF="a2689">
                <ANNOTATION_VALUE>(esse)ndo l'intenzione mia, andare dritto non all'immaginazione della cosa ma alla verità di essa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2692" ANNOTATION_REF="a2691">
                <ANNOTATION_VALUE>machiavelli fonda l'indagine realistica, della politica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2694" ANNOTATION_REF="a2693">
                <ANNOTATION_VALUE>lo dice espressamente. mo:lti si sono immaginati repubbliche che non si sono mai viste essere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2696" ANNOTATION_REF="a2695">
                <ANNOTATION_VALUE>pensa alla repubblica di platone,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2698" ANNOTATION_REF="a2697">
                <ANNOTATION_VALUE>probabilmente già pensa all'utopia di thomas more, che è del millecinquecentosedici, diciassette.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2700" ANNOTATION_REF="a2699">
                <ANNOTATION_VALUE>successiv~ e:h precedente all'uscita dei libri di machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2702" ANNOTATION_REF="a2701">
                <ANNOTATION_VALUE>però lui lo dice chiaramente, a me non mi interessa niente di immaginare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2704" ANNOTATION_REF="a2703">
                <ANNOTATION_VALUE>e:h co::se: che non stanno né in cielo né in terra. a me interessa l'analisi reale,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2706" ANNOTATION_REF="a2705">
                <ANNOTATION_VALUE>e con questo fonda proprio l'analisi scientifica, della politica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2708" ANNOTATION_REF="a2707">
                <ANNOTATION_VALUE>i politologi, diciamo quelli che analizzano la politica scientificamente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2710" ANNOTATION_REF="a2709">
                <ANNOTATION_VALUE>hanno il loro, (.) antenato, in machiavelli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2712" ANNOTATION_REF="a2711">
                <ANNOTATION_VALUE>e allora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2714" ANNOTATION_REF="a2713">
                <ANNOTATION_VALUE>elevando la repubblica, a tipo ideale, insieme alla monarchia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2716" ANNOTATION_REF="a2715">
                <ANNOTATION_VALUE>machiavelli non fa solo un'operazione analitica, che è più corrispondente alla realtà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2718" ANNOTATION_REF="a2717">
                <ANNOTATION_VALUE>ripeto all'epoca c'è la repubblica di venezia, la repubblica di genova, la repubblica di lucca, la repubblica di ragusa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2720" ANNOTATION_REF="a2719">
                <ANNOTATION_VALUE>in germania, xxx le terre dell'impero, non esiste ancora la germania</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2722" ANNOTATION_REF="a2721">
                <ANNOTATION_VALUE>è pieno di repubbliche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2724" ANNOTATION_REF="a2723">
                <ANNOTATION_VALUE>quindi all'epoca di machiavelli le repubbliche ci sono,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2726" ANNOTATION_REF="a2725">
                <ANNOTATION_VALUE>ma non è solo un criterio analitico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2728" ANNOTATION_REF="a2727">
                <ANNOTATION_VALUE>è un criterio ideologico politico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2730" ANNOTATION_REF="a2729">
                <ANNOTATION_VALUE>nel senso che attraverso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2732" ANNOTATION_REF="a2731">
                <ANNOTATION_VALUE>quella, scelta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2734" ANNOTATION_REF="a2733">
                <ANNOTATION_VALUE>analitica, machiavelli fa discendere il fatto che la repubblica è una forma di governo, e che la repubblica magari è una forma di governo (.) auspicabile.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2736" ANNOTATION_REF="a2735">
                <ANNOTATION_VALUE>dobbiamo sempre ricordarci, (.) che machiavelli, diciamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2738" ANNOTATION_REF="a2737">
                <ANNOTATION_VALUE>era stato, secreta~ machiavelli viene chiamato segretario fiorentino no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2740" ANNOTATION_REF="a2739">
                <ANNOTATION_VALUE>viene chiamato il segretario fiorentino, perché,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2742" ANNOTATION_REF="a2741">
                <ANNOTATION_VALUE>lui era stato secretario, di una xxx seconda:, cancelleria,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2744" ANNOTATION_REF="a2743">
                <ANNOTATION_VALUE>della repubblica, fiorentina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2746" ANNOTATION_REF="a2745">
                <ANNOTATION_VALUE>sapete, mo c'è pure sta sta sciochezza dei medici, che va:: in onda, non so se qualcuno se lo sta vedendo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2748" ANNOTATION_REF="a2747">
                <ANNOTATION_VALUE>l'altro giorno ridevano con un amico mio che è un machiavellista,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2750" ANNOTATION_REF="a2749">
                <ANNOTATION_VALUE>mo c'abbiamo lorenzo dei medici che c'ha il fine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2752" ANNOTATION_REF="a2751">
                <ANNOTATION_VALUE>della repubblica a firenze, proprio:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2754" ANNOTATION_REF="a2753">
                <ANNOTATION_VALUE>si scompiscia dalle risate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2756" ANNOTATION_REF="a2755">
                <ANNOTATION_VALUE>lorenzo dei medici è stato poi, di fatto, il principe di firenze. quindi l'esatto opposto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2758" ANNOTATION_REF="a2757">
                <ANNOTATION_VALUE>della repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2760" ANNOTATION_REF="a2759">
                <ANNOTATION_VALUE>però mo al di là di ste scemenze, appunto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2762" ANNOTATION_REF="a2761">
                <ANNOTATION_VALUE>morto lorenzo dei medici,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2764" ANNOTATION_REF="a2763">
                <ANNOTATION_VALUE>il figlio viene scacciato quasi subito da savonarola,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2766" ANNOTATION_REF="a2765">
                <ANNOTATION_VALUE>a firenze, alla fine del quattrocento, viene proclamata di nuovo la repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2768" ANNOTATION_REF="a2767">
                <ANNOTATION_VALUE>e machiavelli, un giovanissimo machiavelli, viene chiamato a far parte, (.) degli uffici diciamo, del governo, della repubblica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2770" ANNOTATION_REF="a2769">
                <ANNOTATION_VALUE>un uomo d'azione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2772" ANNOTATION_REF="a2771">
                <ANNOTATION_VALUE>spesso a cavallo, fa facendo ambascerie::, e qui e lì, e lui, lì diciamo, in quella occasione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2774" ANNOTATION_REF="a2773">
                <ANNOTATION_VALUE>quando sta dentro la stanza dei bottoni, come dire, come diremmo oggi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2776" ANNOTATION_REF="a2775">
                <ANNOTATION_VALUE>si rende conto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2778" ANNOTATION_REF="a2777">
                <ANNOTATION_VALUE>di un te:ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2780" ANNOTATION_REF="a2779">
                <ANNOTATION_VALUE>e questo diciamo, poi lo porterà avanti sempre, cioè quando lui fa quel discorso filopopolare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2782" ANNOTATION_REF="a2781">
