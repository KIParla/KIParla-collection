        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3700" ANNOTATION_REF="a3699">
                <ANNOTATION_VALUE>spinge gli uomini, (.) a non violare le leggi,</ANNOTATION_VALUE>
