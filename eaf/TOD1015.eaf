        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a970" ANNOTATION_REF="a969">
                <ANNOTATION_VALUE>sono critiche al rinascimento, sono critiche all'illuminismo, sono critiche al mondo moderno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a972" ANNOTATION_REF="a971">
                <ANNOTATION_VALUE>ma sono critiche che vengono portate avanti in nome di ideologie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a974" ANNOTATION_REF="a973">
                <ANNOTATION_VALUE>spesso, e volentieri, sulla base,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a976" ANNOTATION_REF="a975">
                <ANNOTATION_VALUE>del, (.) sì non l'avete letto. tranquilli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a978" ANNOTATION_REF="a977">
                <ANNOTATION_VALUE>sulla base del discorso punto religioso. meramente religioso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a980" ANNOTATION_REF="a979">
                <ANNOTATION_VALUE>dicevamo insom~ il rinascimento, comunque si caratterizza per questa riscoperta dell'antichità.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a982" ANNOTATION_REF="a981">
                <ANNOTATION_VALUE>la riscoperta dell'antichità noi non la dobbiamo considerare come una me:ra, imitazione, servile,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a984" ANNOTATION_REF="a983">
                <ANNOTATION_VALUE>perché se fosse così, non avremmo avuto la cappella sistina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a986" ANNOTATION_REF="a985">
                <ANNOTATION_VALUE>la cappella sistina insomm~ non è un'imitazione di niente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a988" ANNOTATION_REF="a987">
                <ANNOTATION_VALUE>la cappella sistina è un capolavoro assoluto e basta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a990" ANNOTATION_REF="a989">
                <ANNOTATION_VALUE>e, (.) per esempio, diciamo, eh se, questo discorso nell'antichità, in alcune discipline, poté funzionare di più,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a992" ANNOTATION_REF="a991">
                <ANNOTATION_VALUE>per esempio nell'architettura, si disponeva del trattatato de architectura di vitruvio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a994" ANNOTATION_REF="a993">
                <ANNOTATION_VALUE>e allora da brunelleschi a palladio, (.) si poté, in qualche modo, cercare di riprendere, quegli stilemi classici.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a996" ANNOTATION_REF="a995">
                <ANNOTATION_VALUE>soprattutto, al di là dei trattati,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a998" ANNOTATION_REF="a997">
                <ANNOTATION_VALUE>c'era roma, c'era il colosseo, c'era il pantheon,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1000" ANNOTATION_REF="a999">
                <ANNOTATION_VALUE>cioè c'erano gli edifici, i resti, della roma antica,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1002" ANNOTATION_REF="a1001">
                <ANNOTATION_VALUE>che, si proponevano come modelli da imitare, da riprendere contro la barbarie gotica: di quegli archi acuti e tutte quelle cose complicate una sull'altra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1004" ANNOTATION_REF="a1003">
                <ANNOTATION_VALUE>diciamo come si esprimeva leon battista alberti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1006" ANNOTATION_REF="a1005">
                <ANNOTATION_VALUE>però diciamo, se nell'architettura questo noi lo vediamo, in qualche modo lo vediamo anche nella scultura,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1008" ANNOTATION_REF="a1007">
                <ANNOTATION_VALUE>perché c'erano i modelli,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1010" ANNOTATION_REF="a1009">
                <ANNOTATION_VALUE>ancora una volta, roma, ma insomma non solo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1012" ANNOTATION_REF="a1011">
                <ANNOTATION_VALUE>diciamo le corti, i principi, si dotano di statue:: dell'antichità, statue romane, che cominciano a riemergere,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1014" ANNOTATION_REF="a1013">
                <ANNOTATION_VALUE>e allora diciamo gli scultori potevano avere un modello,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1016" ANNOTATION_REF="a1015">
                <ANNOTATION_VALUE>da andare a riguardare, così com'era cicerone per la lingua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1018" ANNOTATION_REF="a1017">
                <ANNOTATION_VALUE>però il discorso della pittura è più complicato,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1020" ANNOTATION_REF="a1019">
                <ANNOTATION_VALUE>la pittura che diciamo è la cosa, diciamo la verità, è la cosa più famosa del nostro rinascimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1022" ANNOTATION_REF="a1021">
                <ANNOTATION_VALUE>donatello, raffaello, botticelli, leonardo, michelangelo, e quanto di più::: sommo nel campo della pittura noi abbiamo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1024" ANNOTATION_REF="a1023">
