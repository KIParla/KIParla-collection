    <TIER LINGUISTIC_TYPE_REF="ft-sa" TIER_ID="ft@PSB133" PARENT_REF="ref@PSB133">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>quando lavoravo un po' lontano tornavo a casa facevo anche i turni di notte tornavo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3438" ANNOTATION_REF="a3437">
