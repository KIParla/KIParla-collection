        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>no io ho sempre vissuto li mi trovo bene</ANNOTATION_VALUE>
