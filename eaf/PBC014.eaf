        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>[no ma a me va bene] anche adesso adesso si è evoluta: si è:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>viene [voglia] di andare: a:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>con gli amici (a) giocare a pallone: a: fare il bagno in fondo a(l) reno:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>che era poi quando arrivavamo a casa si pigliava delle botte perché uno s'annegava anche in fondo al reno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>e [così],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
