            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a505">
                <ANNOTATION_VALUE>perché fondamentlmente una caratteristica comune di tutte queste proteine che formano aggregati,</ANNOTATION_VALUE>
