            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a541">
                <ANNOTATION_VALUE>che sono</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a544" ANNOTATION_REF="a543">
                <ANNOTATION_VALUE>tossici tossici per la cellula perché?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a546" ANNOTATION_REF="a545">
                <ANNOTATION_VALUE>alterano il funzionamento del proteazoma,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
