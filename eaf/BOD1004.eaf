            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>e::hm man mano che la degenerazione procede,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>e il morbo di parkinson in una grande quantità di pazienti evolve poi in una demenza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>a:: da parkinson.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>e per non parlare poi della demenza che colpisce eh insieme ai sintomi motori nel caso del morbo di huntington.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>quindi fondamentalmente per quello che sono le patologie classiche almeno diciamo considerando tutto il decorso della patologia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>ad un certo punto tutte manifestano in realtà dei sintomi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>che e::h possono essere assimilabili.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>e::h e questo è un primo aspetto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
