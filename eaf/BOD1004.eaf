        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>in realtà in questo corso tratteremo quasi esclusivamente le malattie neurodegenerative croniche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>e::hm e se riusciamo vi dirò qualcosa sulle patologie legate al neurosviluppo che sono essenzialmente patologie psichiatriche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>e::hm però vedete l'elenco delle patologie a carico del sistema nervoso centrale è molto ampio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>partiamo ovviamente dalle patologie oncologiche su non mi soffermo per ragioni di tempo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>m:h considerando quello che abbiamo detto nelle lezioni potete intuire facilmente che le malattie oncologiche,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>sono di origine neuronale solo nei bambini e durante le fasi dello sviluppo dopo di che i neuroni essendo prosistotici</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>e::h hanno diciamo almeno questo vantaggio che non provocano tumori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>mentre nell'adulto sono essenzialmente tumori di origine gliale o delle cellule tendinali quindi parliamo di atrocitoma aliomi di microgliomi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>e: e così via.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a35">
