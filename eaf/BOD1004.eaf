            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a499">
                <ANNOTATION_VALUE>ora come vi ho detto il concetto più attuale è che questi aggregati che si formano e che si osservano,</ANNOTATION_VALUE>
