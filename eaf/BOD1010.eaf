            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2766" ANNOTATION_REF="a2765">
                <ANNOTATION_VALUE>tirano di brutto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2768" ANNOTATION_REF="a2767">
                <ANNOTATION_VALUE>e non sono rari i pezzi, in cui, come chase in the train lo scopriremo. in cui tyner non suona,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2770" ANNOTATION_REF="a2769">
