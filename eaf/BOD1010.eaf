            <REF_ANNOTATION ANNOTATION_ID="a2710" ANNOTATION_REF="a2709">
                <ANNOTATION_VALUE>e:: a essere più terzinato per esempio. oppure poteva sostituire un'intera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2712" ANNOTATION_REF="a2711">
                <ANNOTATION_VALUE>un un intero ensamble afrocubano, lavorando (.) no? sulla campana del piatto, sulla sulla parte più esterna,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2714" ANNOTATION_REF="a2713">
                <ANNOTATION_VALUE>ecetera eccetera. è colui che ha intrdotto, l'idea di fare, insieme a dart xx, di fare queste configurazioni afrocubane passando dal rullante,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2716" ANNOTATION_REF="a2715">
                <ANNOTATION_VALUE>alla al (.) alla alla cornice del rullante, al tom eccetera eccetera al al al (.) al alla rullante alla cassa bassa eccetera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2718" ANNOTATION_REF="a2717">
                <ANNOTATION_VALUE>alla cassa volevo dire.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2720" ANNOTATION_REF="a2719">
                <ANNOTATION_VALUE>tutto questo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2722" ANNOTATION_REF="a2721">
                <ANNOTATION_VALUE>è (.) ha a che fare con un confronto. cioè c'è un asse di energia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2724" ANNOTATION_REF="a2723">
                <ANNOTATION_VALUE>sax, batteria.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2726" ANNOTATION_REF="a2725">
                <ANNOTATION_VALUE>e un e: tutte e due tirano in avanti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2728" ANNOTATION_REF="a2727">
                <ANNOTATION_VALUE>chi è che fa da contrappeso?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2730" ANNOTATION_REF="a2729">
                <ANNOTATION_VALUE>tyner.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2732" ANNOTATION_REF="a2731">
                <ANNOTATION_VALUE>no? è il pianoforte che sta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2734" ANNOTATION_REF="a2733">
                <ANNOTATION_VALUE>il basso, quando, lui (.) cerca dei bassisti con il suono grosso perché i bassisti fanno il freno a mano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2736" ANNOTATION_REF="a2735">
                <ANNOTATION_VALUE>mettiamola così. per farmi capire da tutti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2738" ANNOTATION_REF="a2737">
                <ANNOTATION_VALUE>il freno a mano perché (.) è jimmy garrison sarà il bassista ideale perché, è quello che fa più freno a mano di tutti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2740" ANNOTATION_REF="a2739">
                <ANNOTATION_VALUE>è quello che anche quando suona in quattro veloce, c'ha un suono talmente grosso che le note arrivano dopo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2742" ANNOTATION_REF="a2741">
                <ANNOTATION_VALUE>due decimi di secondo. cioè non arrivano prima arrivano dopo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2744" ANNOTATION_REF="a2743">
                <ANNOTATION_VALUE>e arri~ e come (.) il ruolo di jimmy garrison è probabilmente il ruolo più (.) sottovalutato. &lt;non parliamo nel documentario perché non viene neanche nominato&gt;. non sto scherzando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2746" ANNOTATION_REF="a2745">
                <ANNOTATION_VALUE>ma è il ruolo più sottovalutato. il personaggio (.) più sottovalutato è invece colui,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2748" ANNOTATION_REF="a2747">
                <ANNOTATION_VALUE>che come dire.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2750" ANNOTATION_REF="a2749">
                <ANNOTATION_VALUE>ancora il gruppo, e lo frena.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2752" ANNOTATION_REF="a2751">
                <ANNOTATION_VALUE>lo tiene a bada da questa spinta energica, che c'hanno (.) ty~ eh che c'hanno (.) johns e coltrane.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2754" ANNOTATION_REF="a2753">
                <ANNOTATION_VALUE>questa cosa succede anche nei soli di piano perché tyner (.) man mano che va avanti, non tanto all'inizio. &lt;sentiremo nel sessantun~ sessantadue sessantatré&gt;,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2756" ANNOTATION_REF="a2755">
                <ANNOTATION_VALUE>con la mano destra, tende a andare sempre più avanti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2758" ANNOTATION_REF="a2757">
