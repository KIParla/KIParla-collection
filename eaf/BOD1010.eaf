            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2760" ANNOTATION_REF="a2759">
                <ANNOTATION_VALUE>per cui quando suonano in trio,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2762" ANNOTATION_REF="a2761">
