        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>mi trovo bene diciamo all'inizio no (.) non mi trov[avo bene no: (è che ho)] per quella famiglia che ho lavorato mi hanno trattato malissimo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>e do:po:: &gt;cioè&lt; ho un po': perso la fiducia [(.) nelle perso]ne [volevo torna]re giù: ma:: dopo grazie a dio ho:: trovato quel lavoro: [(.) camb]iato idea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>[eh sì, la cugina. sì] diciamo che non parlando l'italiano &gt;cioè:&lt; (.) &gt;sono stata&lt; all'inizio quando sono venu:ta: dovevo fare la baby sitter [la: baby] sitter: la signora non è stata:: onesta,</ANNOTATION_VALUE>
