        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>[no: ho fatto tutto] in romania quando sono venuta qua: &gt;cioè&lt; non ho studia:to:. ho iniziato a lavorare già.</ANNOTATION_VALUE>
