        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a788" ANNOTATION_REF="a787">
                <ANNOTATION_VALUE>e la e gli europei, soprattutto i francesi i belgi eh i tedeschi dicono che è la svizzera del marocco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1279" ANNOTATION_REF="a1278">
                <ANNOTATION_VALUE>le scuole, i mezzi di trasporto, in qualsiasi posto trovi i mezzi di trasporto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1394" ANNOTATION_REF="a1393">
                <ANNOTATION_VALUE>e problemi dell'inquinamento, e problemi anche di mezzi di trasporto dopo le otto non trovi</ANNOTATION_VALUE>
