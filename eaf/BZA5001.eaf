				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts221">
				<ANNOTATION_VALUE>eh l'altro giorno c'era: l'articolo no? &gt;che dicevano che hanno&lt; chiuso: l'ultimo giornale antiregime a hong [kong (.) vero]?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
