        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>[per sta cosa] qua magari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>cioè per la cosa che dicevi prima, perché è~ xx interpreta sempre la figura del machista ma magari è un po', è velato.</ANNOTATION_VALUE>
