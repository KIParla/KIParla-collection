            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>due (.) massimo tre g[iorni do]po a seconda come ho spiegato a tutti del numero degli scritti da correggere.</ANNOTATION_VALUE>
