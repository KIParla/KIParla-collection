        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1062" ANNOTATION_REF="a1061">
                <ANNOTATION_VALUE>c'era: il propretario il: m:h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1064" ANNOTATION_REF="a1063">
                <ANNOTATION_VALUE>il propretario che (quo~) (.) diceva: e:h questi rumeni: queste persone ma davanti a me sapendo [che sono rumena: &gt;cioè&lt; proprio li criti]cava tantissimo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1068" ANNOTATION_REF="a1067">
                <ANNOTATION_VALUE>pure a scuola: quando facevo la prima superiore: una:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1070" ANNOTATION_REF="a1069">
                <ANNOTATION_VALUE>una professoressa fa: alzi la mano chi: non ha la ci[ttadinanza italiana: (.) io non ho la cittadinanza italia]na aspetto di prenderla: (.) tra qualche mese ma [(.) non è niente di gra:ve]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1076" ANNOTATION_REF="a1075">
                <ANNOTATION_VALUE>si è messa a [criticare:]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1080" ANNOTATION_REF="a1079">
                <ANNOTATION_VALUE>[sì infa~]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1082" ANNOTATION_REF="a1081">
                <ANNOTATION_VALUE>proprio a criticare: le per~ fa (.) ci sono persone: che sono qua magari da vent'anni: hanno fatto figli:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1084" ANNOTATION_REF="a1083">
                <ANNOTATION_VALUE>e non hanno ancora la cittadinanza italiana: ma (.) che schifo: i mie genitori, totalmente i mie genitori ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1086" ANNOTATION_REF="a1085">
                <ANNOTATION_VALUE>però sincera[mente:],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1090" ANNOTATION_REF="a1089">
                <ANNOTATION_VALUE>[sì: costa:]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1094" ANNOTATION_REF="a1093">
                <ANNOTATION_VALUE>[cos]ta un sacco la cittadinanza: i miei genitori no[n se lo posso]no permettere sinceramente sto bene così,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1100" ANNOTATION_REF="a1099">
                <ANNOTATION_VALUE>quindi:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1102" ANNOTATION_REF="a1101">
                <ANNOTATION_VALUE>sì u:n: bel po' di cose: [(.)] un bel po' di:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1106" ANNOTATION_REF="a1105">
                <ANNOTATION_VALUE>°però:°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1108" ANNOTATION_REF="a1107">
                <ANNOTATION_VALUE>in linea di massima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1112" ANNOTATION_REF="a1111">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
