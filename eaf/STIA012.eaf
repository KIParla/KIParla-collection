            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>quando sono arrivata sono entrata a scuola,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>e::::h per imparare l'italiano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>poi dopo: ho trovato un lavoro sono lavorata solo con gli italiani::,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>e: senti:: poi cerchi di:: imparare: e: poi così dopo ancora sono entrata a:: scuola per imparare l'italiano per prendere anche la::: terza media,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>ho studiato tre anni: ho preso:: la terza media.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>sono andata a scuola e: sono imparata anche:: (.) mentre:: tipo: lavoro con gli italiani,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>sì.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>allora c'è mio figlio che è nato qua, però:: (.) parliamo (.) delle volte l'italiano e delle volte l'arabo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
