        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>perché a milano non fanno ebraico, e io lo volevo veramente studiare ebraico e quindi ho deciso di spostarmi qua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
