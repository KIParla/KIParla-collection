        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>allora sì è comoda come zona perché (.) sei vicina a tutto quello che hai bisogno, nel [mio] caso è l'università perché studian[do qui],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>e:: però anche proprio il centro::, le: le piazze principali, c'è quello che penso siano le piazze principali di torino perché non essendo di qui,</ANNOTATION_VALUE>
