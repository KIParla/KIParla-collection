            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>n::o mi sono (.) trasferita nel duemila diciassette quindi l'a[nno s]corso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>perché (.) ho iniziato a frequentare l'anno scorso qui in università,</ANNOTATION_VALUE>
