        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2615" ANNOTATION_REF="a2614">
                <ANNOTATION_VALUE>e tra loro tipo (.) mio padre parlava sempre in dialetto con mio nonno e a me a me piaceva ascoltare [&gt;qui]ndi&lt;</ANNOTATION_VALUE>
