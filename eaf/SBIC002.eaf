        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2611" ANNOTATION_REF="a2610">
                <ANNOTATION_VALUE>quando ero piccola i miei &lt;portavano&gt; sempre dai miei nonni (.) materni paterni</ANNOTATION_VALUE>
