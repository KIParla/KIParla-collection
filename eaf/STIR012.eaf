        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a676" ANNOTATION_REF="a675">
                <ANNOTATION_VALUE>[no]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a680" ANNOTATION_REF="a679">
                <ANNOTATION_VALUE>no mi capita magari se mi scrive qualche parente:: dalla moldavia oppure:: qualche volta mia mamma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a684" ANNOTATION_REF="a683">
                <ANNOTATION_VALUE>però io tendo a risponderle in itali[ano].</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a693">
                <ANNOTATION_VALUE>e:::hm</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a696" ANNOTATION_REF="a695">
                <ANNOTATION_VALUE>quando mia mamma è arrabbiata, ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a699">
                <ANNOTATION_VALUE>tende a:: mh a=m::h mischiare entrambe le lingue,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a702" ANNOTATION_REF="a701">
                <ANNOTATION_VALUE>o anche semplicemente nel (.) parlare in casa::: (.) così a lei capita di:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a704" ANNOTATION_REF="a703">
                <ANNOTATION_VALUE>di mischiare soprattutto se magari vede che io le rispondo::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a706" ANNOTATION_REF="a705">
                <ANNOTATION_VALUE>in italiano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a708" ANNOTATION_REF="a707">
                <ANNOTATION_VALUE>l::ei magari tende poi:: a mischiare le:: le due lingue.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a726" ANNOTATION_REF="a725">
                <ANNOTATION_VALUE>no in [realtà:: ((ride))] non mi viene nient'altro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
