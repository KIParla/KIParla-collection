    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@PST106" PARENT_REF="ref@PST106">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>sono nata: qua in Italia (.) ad acqui terme (.) più precisamente (.) il ventotto marzo del duemilatre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>e::h allora io di origini sono marocchina (.) e::h sono molto affazionata in realtà al mio paese mi piace un sacco ritornarci infatti:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>nell'ultimo periodo no:n sono: &gt;cioè&lt; negli ultimi anni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>non sono andata fino all'anno scorso (.) quindi tipo sono stata in una pausa per tipo cinque anni per poi essere tornata &gt;è stato molto bello&lt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>e:: (.) : e ogni volta è come se fossi la turista nel mio stesso paese perché non ci abito ((ride)) però sì è sempre molto emozionante,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>e:: le persone sono molto calorose il cibo è molto buono e proprio le #vibes sono proprio #vibes diverse rispetto a: (.) quelle qui dell'Italia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>sì &gt;sì=sì=sì&lt;mi piace: mi piace propr~ mi mi piace tornarci &gt;cioè&lt;: anche più volte all'anno ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>sì: perché a casa: m::h e:h i: nostri genitori &gt;cioè&lt; i miei genitori e:h parlano marocchino dialetto marocchino #darija,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>e:: la parliamo a casa quindi sì anch'io l'ho imparata molto bene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>e:h &gt;allora&lt; a casa con i miei genitori e:h soprattutto marocchino però con i miei fratelli l'italiano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>e:::h e:::h oppure con i miei genitori è un mix tra italiano e marocchino ((ride)) quindi dipende dall'occasione però in casa non è solo solo marocchino parliamo anche l'italiano ogni tanto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>sì&gt;sì=sì=sì&lt; io infatti:: (.) &gt;cioè&lt; io penso in italiano. ((ride))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>((ride)) qundi io quando faccio i miei pensieri penso in italiano, i miei sogni quando parlo parlo in italiano [((ride)) quindi proprio::] una una lingua, una delle mie lingue.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>[e:::h] allora se sono amici italiani o amici non italiani (.) e non di origini marocchine e:h soprattutto italiano, alle volte l'inglese.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>e::h oppure se: m:h ad esempio:: di recente ho:: conosciuto: questi ragazzi: che s~ erano della vecchia residenza che anche loro sono marocchini e:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>e:::h con loro ogni tanto nel discorso in italiano ci metto quella parola in arabo in marocchino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>e:h per rendere per enfatizzare (.) certi concetti che se no con la lingua italiana non sarebbero enfatizzati allo stesso modo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>seco[ndo me secon]do me sì:: (.) lo vedo già solo con mio fratello che è [più piccolo che ha] otto anni che:: e:h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>lui è cresciuto in una casa dove c'eravamo noi fratelli che parlavamo italiano e i miei genitori che parlavano arabo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>e tra l'arabo: e l'italiano: e:h m:h l'italiano è più facile a livello di suoni e a liv[ello di:] ri~ m::h di memorizzazione,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>e mio fratello:: il più piccolo: ha imparato l'italiano prima dell'arabo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>infatti lui fino a: tipo un paio di anni fa l'arabo proprio non sapeva proprio dire una nemmeno una parola.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>però poi a forza di sentirlo in casa parlato dai miei genitori anche lui ha cominciato a imparare un po' di più e::h l'arabo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>ma ha fatto fatica infatti ci sono alcuni suoni che non riesce a pronunciarli bene [(.)] dovuto proprio al fatto che abbia imparato l'italiano (.) prima di aver imparato l'arabo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>con mio fratello parliamo soprat~ tutti i miei fratelli in realtà (.) parliamo solo ed esclusivamente italiano alle volte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>parliamo anche in arabo appunto come per il discorso di prima per enfatizzare magari certi [cont~ eh] concetti (.) però: sì soprattutto italiano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>e:h allora io quando ero piccola (.) eh i miei genitori mi facevano frequentare la moshea il venerdì perché il venerdì:: era considerato il giorno [è il] considerato il giorno santo del per noi musulmani,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>e:h e::hm siccome al mattino avevo la scuola hanno aperto questa scuola serale di corano in una moschea piccola: a nizza monferrato dove abito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
