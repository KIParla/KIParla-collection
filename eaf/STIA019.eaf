        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>da lì il discorso però poi è sfociato in proprio bullismo ma (.) quello è un'altra cosa (.) e:::h però::: nove no quando ero~ anche quendo ero alla:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>all'asilo siccome a casa parlavamo solo (.) marocchino quando sono arrivata all'asilo all'inizio facevo un po' fatica con l'italiano (.) infatti poi da lì,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>e::hm a casa ho cominciato a guardare più cartoni con la lingua italiana abbiamo cominciato a comprare più dvd e ancora (.) i blu-ray che erano proprio le cassette quelle (.) dei cartoni animati sia io che poi con mio fratello,</ANNOTATION_VALUE>
