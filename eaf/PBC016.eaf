        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ah (.) quindi (.) dicevamo: (.) &gt;che comunque sì quindi&lt; lei non non: (.) a questo punto direi che salterò la parte su bologna,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>ehm: appunto perché lei diceva che non è: proprio bolognese di nascita di[ciamo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>ehm: però, comunque come si trova sul: m:h &gt;cioè diciamo&lt;: &gt;visto che ha detto che è venuto comunque molto giovane&lt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>comunque si trova bene:, o:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>°ah beh sì allora,° ((ride)) quindi: comunque:, se posso chiederle &gt;visto che comunque:immagino&lt; (no?)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>anche per lei:? &gt;cioè&lt; lei pensa che comunque ci siano: ci sia una città diciamo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
