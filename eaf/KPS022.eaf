        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>(forse dovevo:) le dovevo far cuocere un po' di più</ANNOTATION_VALUE>
