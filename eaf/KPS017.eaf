        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4766" ANNOTATION_REF="a4765">
                <ANNOTATION_VALUE>[beh] vabbè</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4772" ANNOTATION_REF="a4771">
                <ANNOTATION_VALUE>[non ci va]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4774" ANNOTATION_REF="a4773">
                <ANNOTATION_VALUE>[altro]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4776" ANNOTATION_REF="a4775">
                <ANNOTATION_VALUE>solo quello</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4782" ANNOTATION_REF="a4781">
                <ANNOTATION_VALUE>ah c'è [un mercato l]ì?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4790" ANNOTATION_REF="a4789">
                <ANNOTATION_VALUE>[allo:]ra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4796" ANNOTATION_REF="a4795">
                <ANNOTATION_VALUE>[eh] sì</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4800" ANNOTATION_REF="a4799">
                <ANNOTATION_VALUE>ma gua~ [guarda]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4804" ANNOTATION_REF="a4803">
                <ANNOTATION_VALUE>[ma] guarda che queste cose qua generalmente vengono già confezionate in pac[chetti chiu]si</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4810" ANNOTATION_REF="a4809">
                <ANNOTATION_VALUE>come la trovi in pescheria CHIUSA così la trovi al mercato</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4814" ANNOTATION_REF="a4813">
                <ANNOTATION_VALUE>[perché anche in pesche]ria sono in quel modo là</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4816" ANNOTATION_REF="a4815">
                <ANNOTATION_VALUE>giustamente sono pacchetti da un [chilo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4820" ANNOTATION_REF="a4819">
                <ANNOTATION_VALUE>[o da mezzo] chilo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4824" ANNOTATION_REF="a4823">
                <ANNOTATION_VALUE>[non dovrebbeo essere]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4828" ANNOTATION_REF="a4827">
                <ANNOTATION_VALUE>[do]ve ce li hanno così</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4830" ANNOTATION_REF="a4829">
                <ANNOTATION_VALUE>pacchetti che sono quasi un chilo o mezzo chilo ec[co]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4834" ANNOTATION_REF="a4833">
                <ANNOTATION_VALUE>eh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4838" ANNOTATION_REF="a4837">
                <ANNOTATION_VALUE>[eh]</ANNOTATION_VALUE>
