        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>però appunto::: eh il primo anno è stato: così un: (.) un un un anno molto di~ mh molto divertimento con molto divertimento, insomma molte uscite,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>e:: e adesso dopo invece appunto due anni, son~ sto molto di più in casa:, vivo la città:: (.) in modo diverso. per esempio, ((tossisce)) giro molto di meno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>sto sempre nei (.) nei soliti posti per esempio qua a santa cristina perche vengo a studiare vengo a lezione qua c'è i m~ i miei corsi sono qui,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>e quindi eh vi~ e:h come dire vivo:: i posti in modo più intimo beh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a35">
