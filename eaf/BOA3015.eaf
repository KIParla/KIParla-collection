            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>e:hm (.) e niente questo posto tra l'altro, e::h la prima volta in cui ci son venuta io studiavo anco~ s mh facevo ancora il liceo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a43">
