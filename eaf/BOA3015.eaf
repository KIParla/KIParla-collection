            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>e lui appunto faceva scienze politiche, quindi veniva qua: a lezione poi a studiare,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
