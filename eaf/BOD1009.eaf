                <ANNOTATION_VALUE>quindi. prossimitá (.) e lontananza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1358" ANNOTATION_REF="a1357">
                <ANNOTATION_VALUE>prossimitá e distanza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1360" ANNOTATION_REF="a1359">
                <ANNOTATION_VALUE>ma questo ha a che fare col tempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1362" ANNOTATION_REF="a1361">
                <ANNOTATION_VALUE>non solo più con lo spazio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1364" ANNOTATION_REF="a1363">
                <ANNOTATION_VALUE>il concetto di prossimità e di distanza ha a che fare col tempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1366" ANNOTATION_REF="a1365">
                <ANNOTATION_VALUE>eh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1368" ANNOTATION_REF="a1367">
                <ANNOTATION_VALUE>e come fa: uno (.) da sana' a (.) a essere a riad,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1370" ANNOTATION_REF="a1369">
                <ANNOTATION_VALUE>in ventun minuti</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1372" ANNOTATION_REF="a1371">
                <ANNOTATION_VALUE>deve avere un missile (.) balistico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1374" ANNOTATION_REF="a1373">
                <ANNOTATION_VALUE>no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1376" ANNOTATION_REF="a1375">
                <ANNOTATION_VALUE>allora lo spazio (.) in questo caso ha a che fare con la capacità di comprimere (.) il tempo, e quindi con la conclusione, che la distanza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1378" ANNOTATION_REF="a1377">
                <ANNOTATION_VALUE>non è piú tale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1380" ANNOTATION_REF="a1379">
                <ANNOTATION_VALUE>perché viene percorsa, sorvolata,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1382" ANNOTATION_REF="a1381">
                <ANNOTATION_VALUE>e il tempo viene (.) compresso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1384" ANNOTATION_REF="a1383">
                <ANNOTATION_VALUE>è più prossima (.) riad da sana' a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1386" ANNOTATION_REF="a1385">
                <ANNOTATION_VALUE>in termini di (.) relazioni belliche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1388" ANNOTATION_REF="a1387">
                <ANNOTATION_VALUE>e qui si incontrano tutti i paradossi della nostra esistenza nella politica internazionale. il missile ci mette venti minuti ad arrivare a riad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1390" ANNOTATION_REF="a1389">
                <ANNOTATION_VALUE>gli uomini e le donne, non possono neanche andare. perché i confini sono chiusi. no?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1392" ANNOTATION_REF="a1391">
                <ANNOTATION_VALUE>non è neanche complessa, la transizione. qualcuno, può. altri:, non possono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1394" ANNOTATION_REF="a1393">
                <ANNOTATION_VALUE>l'apologo (.) pascaliano è xxx</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
