        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2988" ANNOTATION_REF="a2987">
                <ANNOTATION_VALUE>[oggi:]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2992" ANNOTATION_REF="a2991">
                <ANNOTATION_VALUE>[ah] sono [uscita di casa che] c'erano diciotto gradi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3000" ANNOTATION_REF="a2999">
                <ANNOTATION_VALUE>no:: è impressionante c[(io)è ventuno] febbraio diciotto gradi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3004" ANNOTATION_REF="a3003">
                <ANNOTATION_VALUE>poi dicono ch[e ades]so tornerà il freddo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3010" ANNOTATION_REF="a3009">
                <ANNOTATION_VALUE>[che di] solito è co[sì magari]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3016" ANNOTATION_REF="a3015">
                <ANNOTATION_VALUE>[°ha fatto° freddissimo] (x) be [poi c'è stata l'alluvio]ne ma io mi rico[rdo che]:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3022" ANNOTATION_REF="a3021">
                <ANNOTATION_VALUE>mi lamentavo che venivo ho fatto tutto il primo semestre dell'università che c'era sempre freddo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3024" ANNOTATION_REF="a3023">
                <ANNOTATION_VALUE>[sì sì ric]ordo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3028" ANNOTATION_REF="a3027">
                <ANNOTATION_VALUE>e poi vabbè appunto poi [anche l'alluvione] vabbè e poi dopo tutto il caldo [(eh)] tutto sballato</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3040" ANNOTATION_REF="a3039">
                <ANNOTATION_VALUE>[sì] tutto un [po' a caso]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3060" ANNOTATION_REF="a3059">
                <ANNOTATION_VALUE>[sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3062" ANNOTATION_REF="a3061">
                <ANNOTATION_VALUE>poi sì poi nel senso anche questo caldo è abbastanza pericoloso adesso iniziano a fiorire tutte le piante poi rischia che</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3066" ANNOTATION_REF="a3065">
                <ANNOTATION_VALUE>[ci sta che venga] una ghiacciata tra qualche: giorno tra (.) un paio di settimane</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3068" ANNOTATION_REF="a3067">
                <ANNOTATION_VALUE>perché comunque ancora siamo a febbraio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3070" ANNOTATION_REF="a3069">
                <ANNOTATION_VALUE>dopo rischiano di uccidere tutte le piante è terribile</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3078" ANNOTATION_REF="a3077">
                <ANNOTATION_VALUE>no:: purtro[ppo]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3086" ANNOTATION_REF="a3085">
                <ANNOTATION_VALUE>[a:h]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3104" ANNOTATION_REF="a3103">
                <ANNOTATION_VALUE>[mhmh]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3108" ANNOTATION_REF="a3107">
                <ANNOTATION_VALUE>°sì°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3114" ANNOTATION_REF="a3113">
                <ANNOTATION_VALUE>°ho capito°</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3116" ANNOTATION_REF="a3115">
                <ANNOTATION_VALUE>(°abbiamo finito?°)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3118" ANNOTATION_REF="a3117">
                <ANNOTATION_VALUE>guarda noi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3120" ANNOTATION_REF="a3119">
                <ANNOTATION_VALUE>volendo siamo: a po[stissimo] sì sì sì eh per noi va benissimo guarda ci hai raccontato un sacco di co[se interessanti]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3130" ANNOTATION_REF="a3129">
                <ANNOTATION_VALUE>oltretutto sì sì sì poi un sacco di [cose anche interessa]nti sulle tradizioni quindi:: bene ti ringraziam[o]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3136" ANNOTATION_REF="a3135">
                <ANNOTATION_VALUE>e::h [ci possiamo fermare]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3144" ANNOTATION_REF="a3143">
                <ANNOTATION_VALUE>((ride))</ANNOTATION_VALUE>
