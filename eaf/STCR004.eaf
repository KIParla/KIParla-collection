    <TIER LINGUISTIC_TYPE_REF="tx-sa" TIER_ID="tx@PST087" PARENT_REF="ref@PST087">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>abbiam pensato: a: una scena con: la danza e i costumi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>in cui: appunto siamo magari: in sala: di danza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>mentre ci prepariamo per uno spettacolo con i costumi popolari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>e::: poi dopo esserci preparate appunto andiamo a fare lo spettacolo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>e magari nel mentre dello spettacolo e delle prove:: eh mettiamo una personcina che:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>sì (.) ch[e::]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>e che parla: e spiega appunto cosa facciamo noi nei balli e::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>[come si]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>vai tu?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>eh no (canti di gruppo) #taraf e ballo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>ah vabbè poi la scena l'abbiam scritta però quella di: con le uova di pasqua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>[io stavo::] (.) [pensa]ndo tipo:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>avevo quest'idea che magari: mentre ci sono magari tipo::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>le mamme e le nonne che magari vengono dalla romania che si mettono a:::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>appunto decorare le uova?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>magari oltre a spiegare il significato che poi si ricollegherà anche ai costumi (.) perché ogni [costume]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>eh::m poi magari:: e:h per introdurre anche un altro argomento magari che ne so c'è una nonna che è venuta dalla romania qua::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>o anche solo le mamme che si ricordano di com'era da loro in infanzia come: facevano in romania appunto parlano,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>e però: poi fanno anche tipo i confronti con l'itali[a °quindi con°] (.) sì (.) confronti tra italia e romania,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>[ah (.) sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>[telaio]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>sì lì è meglio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>[sì]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>a:[:h],</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>o se no tipo stavam pensando per il canto di gruppo:: e per l'orchestra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>se non riuscivamo più a farlo magari quando siamo tutti vestiti così,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>di riprendere una delle lezioni di canto (.) in cui ma[gari facciamo del]le dei le canzoni di gruppo ri[scaldamento vocale] (.) sì e poi con l'orch~</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a443">
                <ANNOTATION_VALUE>[finisci di completarla ((ride))]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a445">
                <ANNOTATION_VALUE>qui ho messo una delle due [opzioni (.) perché o::]</ANNOTATION_VALUE>
