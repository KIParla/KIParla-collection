            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>(come) abbiamo la sala della nonna (.) e abbiamo e::h</ANNOTATION_VALUE>
