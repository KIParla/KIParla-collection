        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>poi [quando (.) sì]. poi quando andiamo magari::: ti dicono ah allora ma tu parli un po' così</ANNOTATION_VALUE>
